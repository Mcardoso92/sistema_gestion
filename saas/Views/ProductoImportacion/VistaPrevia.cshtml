@model saas.ViewModel.ProductoImportacion.ProductoImportacionVistaPreviaVM

@{
    ViewData["Title"] = "Vista previa de productos";
}

<main class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <a asp-action="Index" class="text-decoration-none text-secondary">← Elegir otro archivo</a>
            <h1 class="h2 fw-semibold mb-1 mt-2">Vista previa</h1>
            <p class="text-secondary mb-0">Revisá el resultado de <strong>@Model.NombreArchivo</strong> antes de importar.</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-secondary small">Productos detectados</div><div class="fs-3 fw-semibold">@Model.TotalFilas</div></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-secondary small">Filas válidas</div><div class="fs-3 fw-semibold text-success">@Model.FilasValidas</div></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-secondary small">Filas con errores</div><div class="fs-3 fw-semibold text-danger">@Model.FilasConErrores</div></div></div></div>
    </div>

    @if (Model.TotalFilas == 0)
    {
        <div class="alert alert-warning">El archivo no contiene productos para importar.</div>
    }
    else if (!Model.PuedeImportar)
    {
        <div class="alert alert-danger">Corregí las filas indicadas y analizá nuevamente el archivo. No se realizó ningún cambio.</div>
    }
    else
    {
        <div class="alert alert-success">Todas las filas son válidas. Podés confirmar la importación.</div>
    }

    <div class="card shadow-sm overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Fila</th>
                        <th>Nombre</th>
                        <th>Código</th>
                        <th>Categoría</th>
                        <th class="text-end">Costo</th>
                        <th class="text-end">Venta</th>
                        <th class="text-center">Stock</th>
                        <th>Resultado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in Model.Filas)
                    {
                        <tr>
                            <td>@fila.NumeroFila</td>
                            <td>@fila.Nombre</td>
                            <td>@(fila.CodigoBarra ?? "-")</td>
                            <td>@(fila.Categoria ?? "-")</td>
                            <td class="text-end">@fila.PrecioCosto.ToString("C")</td>
                            <td class="text-end">@fila.PrecioVenta.ToString("C")</td>
                            <td class="text-center">@fila.StockInicial</td>
                            <td>
                                @if (fila.EsValida)
                                {
                                    <span class="badge text-bg-success">Válida</span>
                                }
                                else
                                {
                                    <ul class="text-danger small mb-0 ps-3">
                                        @foreach (string error in fila.Errores)
                                        {
                                            <li>@error</li>
                                        }
                                    </ul>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-v-outline">Cancelar</a>
        @if (Model.PuedeImportar)
        {
            <form asp-action="Confirmar" method="post">
                <input type="hidden" name="token" value="@Model.Token" />
                <input type="hidden" name="empresaId" value="@Model.EmpresaId" />
                <button type="submit" class="btn btn-v-primary d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined">upload</span>
                    Importar @Model.TotalFilas productos
                </button>
            </form>
        }
    </div>
</main>
