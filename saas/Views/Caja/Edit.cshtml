@model saas.ViewModel.CajaEditVM

@{
    ViewData["Title"] = "Editar Caja";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Editar Caja
            </h1>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Volver
        </a>

    </div>

    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />
        <input asp-for="EmpresaId" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <div class="row g-4">

            <div class="col-lg-8">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="Nombre"
                                       class="form-label fw-semibold">
                                    Nombre
                                </label>

                                <input asp-for="Nombre"
                                       class="form-control" />

                                <span asp-validation-for="Nombre"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Tipo"
                                       class="form-label fw-semibold">
                                    Tipo
                                </label>

                                @if (Model.TieneTurnoAbierto)
                                {
                                    <input asp-for="Tipo" type="hidden" />
                                    <select class="form-select"
                                            id="tipoCajaSelect"
                                            disabled>
                                        <option selected>@TextoPresentacion.ValorEnum(Model.Tipo)</option>
                                    </select>
                                }
                                else
                                {
                                    <select asp-for="Tipo"
                                            asp-items="Html.GetEnumSelectList<saas.Models.Enums.TipoCaja>()"
                                            class="form-select"
                                            id="tipoCajaSelect">
                                    </select>
                                }
                            </div>

                            <div class="col-md-6">
                                <label asp-for="FondoFijo"
                                       class="form-label fw-semibold">
                                    Fondo fijo
                                </label>

                                <input asp-for="FondoFijo"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control" />

                                <span asp-validation-for="FondoFijo"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-12">

                                <div class="form-check form-switch mb-3">

                                    @if (Model.TieneTurnoAbierto)
                                    {
                                        <input asp-for="PermiteTurnos" type="hidden" />
                                        <input class="form-check-input" type="checkbox" checked="@(Model.PermiteTurnos ? "checked" : null)" disabled />
                                    }
                                    else
                                    {
                                        <input asp-for="PermiteTurnos" class="form-check-input" id="permiteTurnos" />
                                    }

                                    <label asp-for="PermiteTurnos"
                                           class="form-check-label fw-semibold">
                                        Permite turnos
                                    </label>

                                </div>

                                <span asp-validation-for="PermiteTurnos"
                                      class="text-danger"></span>

                                <div class="form-check form-switch">

                                    @if (Model.TieneTurnoAbierto)
                                    {
                                        <input asp-for="Estado" type="hidden" />
                                        <input class="form-check-input" type="checkbox" checked="@(Model.Estado ? "checked" : null)" disabled />
                                    }
                                    else
                                    {
                                        <input asp-for="Estado" class="form-check-input" />
                                    }

                                    <label asp-for="Estado"
                                           class="form-check-label fw-semibold">
                                        Caja activa
                                    </label>

                                </div>

                                <span asp-validation-for="Estado"
                                      class="text-danger"></span>

                                @if (!Model.Estado)
                                {
                                    <div class="form-text">
                                        Activá esta opción para reactivar la caja.
                                    </div>
                                }

                            </div>

                        </div>

                    </div>
                </div>

            </div>

            <div class="col-lg-4">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-3">
                            Medios de pago
                        </h5>

                        <div id="mediosPagoContainer">

                            @foreach (var medio in Model.MediosPagoDisponibles)
                            {
                                <div class="form-check mb-2">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="MediosPagoSeleccionadosIds"
                                           value="@medio.Id"
                                           id="medio-@medio.Id"
                                           @(medio.Seleccionado ? "checked" : null)
                                           disabled="@(Model.TieneTurnoAbierto ? "disabled" : null)" />

                                    @if (Model.TieneTurnoAbierto && medio.Seleccionado)
                                    {
                                        <input type="hidden"
                                               name="MediosPagoSeleccionadosIds"
                                               value="@medio.Id" />
                                    }

                                    <label class="form-check-label"
                                           for="medio-@medio.Id">
                                        @medio.Nombre
                                    </label>

                                </div>
                            }

                        </div>

                        <span asp-validation-for="MediosPagoSeleccionadosIds"
                              class="text-danger"></span>

                        @if (Model.TieneTurnoAbierto)
                        {
                            <div class="form-text text-warning-emphasis">
                                Con un turno abierto solo puede modificar el nombre y el fondo fijo.
                            </div>
                        }

                    </div>
                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Guardar cambios
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const tipoCajaSelect =
                document.getElementById("tipoCajaSelect");

            const container =
                document.getElementById("mediosPagoContainer");

            const permiteTurnos =
                document.getElementById("permiteTurnos");

            const empresaId = "@Model.EmpresaId";

            let solicitudMediosPagoActual = 0;

            if (!tipoCajaSelect || !container) {
                return;
            }

            const seleccionadosIniciales = [
                @string.Join(",", Model.MediosPagoSeleccionadosIds)
            ];

            function actualizarPermiteTurnos() {
                if (!permiteTurnos) {
                    return;
                }

                const esEfectivo = tipoCajaSelect.value === "1";
                permiteTurnos.disabled = !esEfectivo;

                if (!esEfectivo) {
                    permiteTurnos.checked = false;
                }
            }

            async function cargarMediosPago(
                conservarSeleccionInicial = false) {

                const solicitudId =
                    ++solicitudMediosPagoActual;

                const tipoCaja =
                    tipoCajaSelect.value;

                container.innerHTML = "";

                if (!empresaId || !tipoCaja) {
                    return;
                }

                try {
                    const url =
                        '@Url.Action("GetMediosPagoPorEmpresa", "Caja")'
                        + '?empresaId='
                        + encodeURIComponent(empresaId)
                        + '&tipoCaja='
                        + encodeURIComponent(tipoCaja);

                    const response =
                        await fetch(url);

                    if (!response.ok) {
                        throw new Error(
                            "Error al cargar medios de pago.");
                    }

                    const medios =
                        await response.json();

                    if (solicitudId !== solicitudMediosPagoActual) {
                        return;
                    }

                    if (medios.length === 0) {
                        container.innerHTML =
                            '<div class="text-muted small">'
                            + 'No hay medios de pago compatibles con este tipo de caja.'
                            + '</div>';

                        return;
                    }

                    medios.forEach(medio => {

                        const seleccionado =
                            conservarSeleccionInicial &&
                            seleccionadosIniciales.includes(
                                medio.id);

                        const div =
                            document.createElement("div");

                        div.className =
                            "form-check mb-2";

                        const input =
                            document.createElement("input");

                        input.className =
                            "form-check-input";

                        input.type = "checkbox";

                        input.name =
                            "MediosPagoSeleccionadosIds";

                        input.value = medio.id;

                        input.id =
                            `medio-${medio.id}`;

                        input.checked =
                            seleccionado;

                        const label =
                            document.createElement("label");

                        label.className =
                            "form-check-label";

                        label.htmlFor =
                            input.id;

                        label.textContent =
                            medio.nombre;

                        div.appendChild(input);
                        div.appendChild(label);

                        container.appendChild(div);
                    });
                }
                catch {
                    if (solicitudId !== solicitudMediosPagoActual) {
                        return;
                    }

                    container.innerHTML =
                        '<div class="text-danger small">'
                        + 'No se pudieron cargar los medios de pago.'
                        + '</div>';
                }
            }

            // Cambio manual de tipo:
            // recarga opciones y no conserva asociaciones
            // incompatibles del tipo anterior.
            tipoCajaSelect.addEventListener(
                "change",
                function () {
                    actualizarPermiteTurnos();
                    cargarMediosPago(false);
                });

            // Estado inicial de Edit:
            // conserva marcados los medios ya asociados.
            actualizarPermiteTurnos();
            cargarMediosPago(true);
        });
    </script>
}
