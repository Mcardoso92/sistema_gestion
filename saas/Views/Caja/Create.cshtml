@model saas.ViewModel.CajaCreateVM

@{
    ViewData["Title"] = "Nueva Caja";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Nueva Caja</h1>
            <p class="text-muted mb-0">
                Configurá una nueva caja o cuenta financiera.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Volver
        </a>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <div class="row g-4">

            <div class="col-lg-8">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="Nombre"
                                       class="form-label fw-semibold">
                                    Nombre
                                </label>

                                <input asp-for="Nombre"
                                       class="form-control"
                                       placeholder="Ej: Caja Mostrador 1" />

                                <span asp-validation-for="Nombre"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Tipo"
                                       class="form-label fw-semibold">
                                    Tipo
                                </label>

                                <select asp-for="Tipo"
                                        asp-items="Html.GetEnumSelectList<saas.Models.Enums.TipoCaja>()"
                                        class="form-select" id="tipoCajaSelect">
                                </select>

                                <span asp-validation-for="Tipo"
                                      class="text-danger"></span>
                            </div>

                            @if (Model.Empresas.Any())
                            {
                                <div class="col-md-6">
                                    <label asp-for="EmpresaId"
                                           class="form-label fw-semibold">
                                        Empresa
                                    </label>

                                    <select asp-for="EmpresaId"
                                            asp-items="Model.Empresas"
                                            class="form-select"
                                            id="empresaSelect">

                                        <option value="">
                                            Seleccionar empresa
                                        </option>

                                    </select>

                                    <span asp-validation-for="EmpresaId"
                                          class="text-danger"></span>
                                </div>
                            }
                            else
                            {
                                <input asp-for="EmpresaId"
                                       type="hidden"
                                       id="empresaIdHidden" />
                            }

                            <div class="col-md-6">
                                <label asp-for="FondoFijo"
                                       class="form-label fw-semibold">
                                    Fondo fijo
                                </label>

                                <input asp-for="FondoFijo"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       step="0.01" />

                                <span asp-validation-for="FondoFijo"
                                      class="text-danger"></span>

                                <div class="form-text">
                                    Monto que debe permanecer en la caja al cierre.
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="PermiteTurnos"
                                           class="form-check-input"
                                           id="permiteTurnos" />

                                    <label asp-for="PermiteTurnos"
                                           class="form-check-label fw-semibold">
                                        Permite turnos de caja
                                    </label>
                                </div>

                                <span asp-validation-for="PermiteTurnos"
                                      class="text-danger"></span>

                                <div class="form-text">
                                    Solo puede habilitarse para cajas de tipo Efectivo.
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>

            <div class="col-lg-4">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-3">
                            Medios de pago
                        </h5>

                        <p class="text-muted small">
                            Seleccioná qué medios pueden operar con esta caja.
                        </p>

                        <div id="mediosPagoContainer">

                            @foreach (var medio in Model.MediosPagoDisponibles)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="MediosPagoSeleccionadosIds"
                                           value="@medio.Id"
                                           id="medio-@medio.Id"
                                           @(medio.Seleccionado ? "checked" : null) />

                                    <label class="form-check-label"
                                           for="medio-@medio.Id">
                                        @medio.Nombre
                                    </label>
                                </div>
                            }

                        </div>

                        <span asp-validation-for="MediosPagoSeleccionadosIds"
                              class="text-danger"></span>

                    </div>
                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Crear Caja
            </button>

        </div>

    </form>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const empresaSelect =
                document.getElementById("empresaSelect");

            const empresaIdHidden =
                document.getElementById("empresaIdHidden");

            const tipoCajaSelect =
                document.getElementById("tipoCajaSelect");

            const container =
                document.getElementById("mediosPagoContainer");

            async function cargarMediosPago() {

                const empresaId =
                    empresaSelect
                        ? empresaSelect.value
                        : empresaIdHidden?.value;

                const tipoCaja =
                    tipoCajaSelect.value;

                container.innerHTML = "";

                if (!empresaId || !tipoCaja) {
                    return;
                }

                try {

                    const url =
                        '@Url.Action("GetMediosPagoPorEmpresa", "Caja")'
                        + '?empresaId=' + empresaId
                        + '&tipoCaja=' + tipoCaja;

                    const response = await fetch(url);

                    if (!response.ok) {
                        throw new Error();
                    }

                    const medios = await response.json();

                    if (medios.length === 0) {

                        container.innerHTML =
                            '<div class="text-muted small">'
                            + 'No hay medios de pago compatibles con este tipo de caja.'
                            + '</div>';

                        return;
                    }

                    medios.forEach(medio => {

                        const div =
                            document.createElement("div");

                        div.className = "form-check mb-2";

                        div.innerHTML = `
                            <input
                                class="form-check-input"
                                type="checkbox"
                                name="MediosPagoSeleccionadosIds"
                                value="${medio.id}"
                                id="medio-${medio.id}" />

                            <label
                                class="form-check-label"
                                for="medio-${medio.id}">
                                ${medio.nombre}
                            </label>
                        `;

                        container.appendChild(div);
                    });

                }
                catch {

                    container.innerHTML =
                        '<div class="text-danger small">'
                        + 'No se pudieron cargar los medios de pago.'
                        + '</div>';
                }
            }

            if (empresaSelect) {
                empresaSelect.addEventListener(
                    "change",
                    cargarMediosPago);
            }

            tipoCajaSelect.addEventListener(
                "change",
                cargarMediosPago);

            // Carga inicial
            cargarMediosPago();
        });
    </script>
}