@model saas.ViewModel.CajaDetailsVM

@{
    ViewData["Title"] = "Detalle de Caja";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold mb-0">@Model.Nombre</h1>

                @if (Model.Estado)
                {
                    <span class="status-badge status-active">Activa</span>
                }
                else
                {
                    <span class="status-badge status-inactive">Inactiva</span>
                }

                @if (Model.TieneTurnoAbierto)
                {
                    <span class="status-badge status-open">
                        Turno abierto
                    </span>
                }
            </div>

            <p class="text-muted mb-0">
                Información y configuración de la caja.
            </p>
        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Nombre
                            </div>
                            <div class="fw-semibold">
                                @Model.Nombre
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Tipo
                            </div>
                            <div class="fw-semibold">
                                @TextoPresentacion.ValorEnum(Model.Tipo)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Empresa
                            </div>
                            <div class="fw-semibold">
                                @Model.EmpresaNombre
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Fecha de alta
                            </div>
                            <div>
                                @FechaHora.ConvertirAHoraLocal(Model.FechaAlta).ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="text-muted small">
                                Fondo fijo
                            </div>
                            <div class="fw-semibold">
                                @Model.FondoFijo.ToString("C")
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="text-muted small">
                                Saldo actual
                            </div>
                            <div class="fw-bold fs-5">
                                @Model.SaldoActual.ToString("C")
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="text-muted small">
                                Permite turnos
                            </div>

                            <div class="fw-semibold">
                                @(Model.PermiteTurnos ? "Sí" : "No")
                            </div>
                        </div>

                    </div>

                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
            </div>

        </div>

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        Medios de pago habilitados
                    </h5>

                    @if (Model.MediosPago.Any())
                    {
                        <ul class="mb-0">
                            @foreach (var medio in Model.MediosPago)
                            {
                                <li>@medio</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No hay medios de pago habilitados.
                        </p>
                    }

                </div>
            </div>

            <div class="help-guide-panel mt-4">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">point_of_sale</span>
                    <div><h3 class="help-guide-item__title">Tipo de caja</h3><p class="help-guide-item__text">El tipo determina qué medios de pago pueden asociarse y cómo se registrarán sus movimientos.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">schedule</span>
                    <div><h3 class="help-guide-item__title">Turnos de caja</h3><p class="help-guide-item__text">Los turnos solo pueden habilitarse en cajas de efectivo. Una caja con turno abierto tiene restricciones de edición.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">account_balance_wallet</span>
                    <div><h3 class="help-guide-item__title">Saldo e historial</h3><p class="help-guide-item__text">Para desactivar una caja debe estar sin turnos abiertos y con saldo cero. Su historial siempre se conserva.</p></div>
                </div>
            </div>

        </div>

    </div>

</div>
