@model saas.ViewModel.CajaIndexVM

@{
    ViewData["Title"] = "Cajas";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h1 class="h3 fw-bold mb-1">Cajas</h1>
            <p class="text-muted mb-0">
                Administrá las cajas y cuentas financieras de la empresa.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            Nueva Caja
        </a>

    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <form method="get"
                  asp-action="Index">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-4 col-md-6">

                        <label class="form-label fw-semibold">
                            Buscar
                        </label>

                        <input asp-for="Busqueda"
                               class="form-control"
                               placeholder="Buscar por nombre..." />

                    </div>

                    <div class="col-lg-2 col-md-6">

                        <label asp-for="Estado"
                               class="form-label fw-semibold">
                            Estado
                        </label>

                        <select asp-for="Estado"
                                class="form-select">

                            <option value="activas">
                                Activas
                            </option>

                            <option value="inactivas">
                                Inactivas
                            </option>

                            <option value="todas">
                                Todas
                            </option>

                        </select>

                    </div>

                    <div class="col-lg-2 col-md-6">

                        <label asp-for="Tipo"
                               class="form-label fw-semibold">
                            Tipo
                        </label>

                        <select asp-for="Tipo"
                                asp-items="Html.GetEnumSelectList<saas.Models.Enums.TipoCaja>()"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                        </select>

                    </div>

                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <div class="col-lg-2 col-md-6">

                            <label asp-for="EmpresaId"
                                   class="form-label fw-semibold">
                                Empresa
                            </label>

                            <select asp-for="EmpresaId"
                                    asp-items="Model.Empresas"
                                    class="form-select">

                                <option value="">
                                    Todas
                                </option>

                            </select>

                        </div>
                    }

                    <div class="col-lg-2 col-md-6">

                        <button type="submit"
                                class="btn btn-outline-primary w-100">
                            Filtrar
                        </button>

                    </div>

                </div>

            </form>

        </div>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            @if (Model.Cajas.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Nombre
                                </th>

                                <th>
                                    Tipo
                                </th>

                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <th>
                                        Empresa
                                    </th>
                                }

                                <th class="text-center">
                                    Turnos
                                </th>

                                <th class="text-end">
                                    Fondo fijo
                                </th>

                                <th class="text-end">
                                    Saldo actual
                                </th>

                                <th class="text-center">
                                    Estado
                                </th>

                                <th class="text-end pe-4">
                                    Acciones
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var caja in Model.Cajas)
                            {
                                <tr>

                                    <td class="ps-4 fw-semibold">
                                        @caja.Nombre
                                    </td>

                                    <td>
                                        @caja.Tipo
                                    </td>

                                    @if (User.IsInRole("SuperAdmin"))
                                    {
                                        <td>
                                            @caja.EmpresaNombre
                                        </td>
                                    }

                                    <td class="text-center">

                                        @if (caja.PermiteTurnos)
                                        {
                                            <span class="badge bg-primary">
                                                Sí
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">
                                        @caja.FondoFijo.ToString("C")
                                    </td>

                                    <td class="text-end fw-semibold">

                                        @if (caja.SaldoActual >= 0)
                                        {
                                            @caja.SaldoActual.ToString("C")
                                        }
                                        else
                                        {
                                            <span class="text-danger">
                                                @caja.SaldoActual.ToString("C")
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        @if (caja.Estado)
                                        {
                                            <span class="badge bg-success">
                                                Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactiva
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end pe-4">

                                        <div class="btn-group btn-group-sm">

                                            <a asp-action="Details"
                                               asp-route-id="@caja.Id"
                                               class="btn btn-outline-secondary">
                                                Detalles
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@caja.Id"
                                               class="btn btn-outline-primary">
                                                Editar
                                            </a>

                                            @if (caja.Estado)
                                            {
                                                <a asp-action="Delete"
                                                   asp-route-id="@caja.Id"
                                                   class="btn btn-outline-danger">
                                                    Desactivar
                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center p-5">

                    <h5 class="fw-bold mb-2">
                        No hay cajas para mostrar
                    </h5>

                    <p class="text-muted mb-3">
                        No se encontraron cajas con los filtros seleccionados.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Crear primera Caja
                    </a>

                </div>
            }

        </div>

    </div>

</div>