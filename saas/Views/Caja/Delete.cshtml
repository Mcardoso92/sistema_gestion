@model saas.ViewModel.CajaDetailsVM

@{
    ViewData["Title"] = "Desactivar Caja";
}

<div class="container-fluid px-4 py-4">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Desactivar Caja</h1>
        <p class="text-muted mb-0">Revisá el turno y el saldo antes de confirmar.</p>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
    <div class="form-container p-4">
        <div class="card-body p-4">

            @if (Model.TieneTurnoAbierto)
            {
                <div class="alert alert-danger">
                    Esta caja tiene un turno abierto y no puede desactivarse.
                </div>
            }
            else if (Model.SaldoActual != 0)
            {
                <div class="alert alert-danger">
                    Esta caja tiene un saldo de
                    <strong>@Model.SaldoActual.ToString("C")</strong>.
                    Debe dejar el saldo en cero antes de desactivarla.
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    La caja dejará de estar disponible para nuevas operaciones.
                    Su historial financiero se conservará.
                </div>
            }

            <dl class="row mb-4">

                <dt class="col-sm-3">Caja</dt>
                <dd class="col-sm-9">@Model.Nombre</dd>

                <dt class="col-sm-3">Tipo</dt>
                <dd class="col-sm-9">@TextoPresentacion.ValorEnum(Model.Tipo)</dd>

                <dt class="col-sm-3">Empresa</dt>
                <dd class="col-sm-9">@Model.EmpresaNombre</dd>

                <dt class="col-sm-3">Saldo actual</dt>
                <dd class="col-sm-9">
                    @Model.SaldoActual.ToString("C")
                </dd>

            </dl>

            <form asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    @if (!Model.TieneTurnoAbierto &&
                                        Model.SaldoActual == 0)
                    {
                        <button type="submit"
                                class="btn btn-danger">
                            Desactivar
                        </button>
                    }

                </div>

            </form>

        </div>
    </div>
        </div>

        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">point_of_sale</span>
                    <div><h3 class="help-guide-item__title">Tipo de caja</h3><p class="help-guide-item__text">El tipo determina qué medios de pago pueden asociarse y cómo se registrarán sus movimientos.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">schedule</span>
                    <div><h3 class="help-guide-item__title">Turnos de caja</h3><p class="help-guide-item__text">Una caja con un turno abierto no puede desactivarse.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">account_balance_wallet</span>
                    <div><h3 class="help-guide-item__title">Saldo e historial</h3><p class="help-guide-item__text">La caja debe tener saldo cero. Al desactivarla, todos sus movimientos históricos se conservan.</p></div>
                </div>
            </div>
        </div>
    </div>

</div>
