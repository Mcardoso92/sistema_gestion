@model saas.ViewModel.Reportes.ReporteStockVM

@{
    ViewData["Title"] = "Reporte de stock";
}

<main class="container-fluid py-4 px-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold mb-1">Reporte de stock</h1>
            <p class="text-muted mb-0">
                Analice las existencias y el valor actual del inventario.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="ExportarStockExcel"
               asp-route-categoriaId="@Model.CategoriaId"
               asp-route-empresaId="@Model.EmpresaId"
               asp-route-situacion="@Model.Situacion"
               class="btn btn-success d-flex align-items-center gap-2">

                <span class="material-symbols-outlined">download</span>
                Descargar Excel
            </a>

            <a asp-controller="Producto"
               asp-action="Index"
               asp-route-empresaId="@Model.EmpresaId"
               asp-route-categoriaId="@Model.CategoriaId"
               class="btn btn-v-outline d-flex align-items-center gap-2">

                <span class="material-symbols-outlined">arrow_back</span>
                Volver a productos
            </a>
        </div>
    </div>

    <section class="card-custom p-3 mb-4">
        <form asp-action="Stock" method="get">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3 align-items-end">
                @if (ViewBag.EsSuperAdmin is true)
                {
                    <div class="col-lg-3 col-md-4">
                        <label asp-for="EmpresaId" class="form-label small fw-semibold text-muted">
                            Empresa
                        </label>

                        <select asp-for="EmpresaId" asp-items="Model.Empresas" class="form-select bg-light">
                            <option value="">Todas las empresas</option>
                        </select>

                        <span asp-validation-for="EmpresaId" class="text-danger"></span>
                    </div>
                }

                <div class="col-lg-3 col-md-4">
                    <label asp-for="CategoriaId" class="form-label small fw-semibold text-muted">
                        Categoría
                    </label>

                    <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select bg-light">
                        <option value="">Todas las categorías</option>
                    </select>
                </div>

                <div class="col-lg-3 col-md-4">
                    <label asp-for="Situacion" class="form-label small fw-semibold text-muted">
                        Situación
                    </label>

                    <select asp-for="Situacion" class="form-select bg-light">
                        <option value="todos">Todos</option>
                        <option value="normal">Stock normal</option>
                        <option value="bajo">Stock bajo</option>
                        <option value="sin-stock">Sin stock</option>
                    </select>
                </div>

                <div class="col-lg-2 col-md-4">
                    <button type="submit" class="btn btn-v-primary w-100 d-flex align-items-center justify-content-center gap-2">
                        <span class="material-symbols-outlined">filter_alt</span>
                        Aplicar
                    </button>
                </div>
            </div>
        </form>
    </section>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl">
            <div class="dashboard-summary-card">
                <div class="dashboard-summary-icon dashboard-icon-primary">
                    <span class="material-symbols-outlined">inventory_2</span>
                </div>

                <div>
                    <div class="dashboard-summary-label">Productos</div>
                    <div class="dashboard-summary-value">@Model.CantidadProductos</div>
                    <div class="dashboard-summary-detail">Productos activos</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl">
            <div class="dashboard-summary-card">
                <div class="dashboard-summary-icon dashboard-icon-info">
                    <span class="material-symbols-outlined">package_2</span>
                </div>

                <div>
                    <div class="dashboard-summary-label">Unidades</div>
                    <div class="dashboard-summary-value">@Model.UnidadesStock</div>
                    <div class="dashboard-summary-detail">Unidades disponibles</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl">
            <div class="dashboard-summary-card">
                <div class="dashboard-summary-icon dashboard-icon-warning">
                    <span class="material-symbols-outlined">warning</span>
                </div>

                <div>
                    <div class="dashboard-summary-label">Stock bajo</div>
                    <div class="dashboard-summary-value">@Model.ProductosStockBajo</div>
                    <div class="dashboard-summary-detail">Productos para revisar</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl">
            <div class="dashboard-summary-card">
                <div class="dashboard-summary-icon dashboard-icon-primary">
                    <span class="material-symbols-outlined">payments</span>
                </div>

                <div>
                    <div class="dashboard-summary-label">Valor a costo</div>
                    <div class="dashboard-summary-value">
                        @Model.ValorInventarioCosto.ToString("C")
                    </div>
                    <div class="dashboard-summary-detail">Inversión actual</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl">
            <div class="dashboard-summary-card">
                <div class="dashboard-summary-icon dashboard-icon-success">
                    <span class="material-symbols-outlined">trending_up</span>
                </div>

                <div>
                    <div class="dashboard-summary-label">Valor de venta</div>
                    <div class="dashboard-summary-value">
                        @Model.ValorInventarioVenta.ToString("C")
                    </div>
                    <div class="dashboard-summary-detail">Valor potencial</div>
                </div>
            </div>
        </div>
    </div>

    <section class="card-custom overflow-hidden">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-3 border-bottom">
            <div>
                <h2 class="h5 fw-bold mb-1">Detalle del inventario</h2>
                <p class="text-muted small mb-0">
                    Productos activos según los filtros seleccionados.
                </p>
            </div>

            <span class="badge text-bg-light border px-3 py-2">
                @Model.CantidadProductos registros
            </span>
        </div>

        @if (Model.Productos.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Producto</th>
                            <th>Categoría</th>

                            @if (ViewBag.EsSuperAdmin is true)
                            {
                                <th>Empresa</th>
                            }

                            <th class="text-end">Stock</th>
                            <th class="text-end">Reposición</th>
                            <th class="text-end">Costo</th>
                            <th class="text-end">Valor costo</th>
                            <th class="text-end">Valor venta</th>
                            <th class="text-center pe-4">Situación</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var producto in Model.Productos)
                        {
                            string claseSituacion = producto.Situacion switch
                            {
                                "Sin stock" => "text-bg-danger",
                                "Stock bajo" => "text-bg-warning",
                                _ => "text-bg-success"
                            };

                            <tr>
                                <td class="ps-4">
                                    <a asp-controller="Producto"
                                       asp-action="Details"
                                       asp-route-id="@producto.ProductoId"
                                       class="text-decoration-none fw-semibold">
                                        @producto.Nombre
                                    </a>

                                    <div class="text-muted small">
                                        @(string.IsNullOrWhiteSpace(producto.CodigoBarra)
                                                                        ? "Sin código"
                                                                        : producto.CodigoBarra)
                            </div>
                        </td>

                                <td>@producto.Categoria</td>

                        @if (ViewBag.EsSuperAdmin is true)
                                {
                                    <td>@producto.Empresa</td>
                                }

                                <td class="text-end fw-bold">@producto.Stock</td>
                                <td class="text-end">@producto.PuntoReposicion</td>
                                <td class="text-end">@producto.PrecioCosto.ToString("C")</td>
                                <td class="text-end">@producto.ValorCosto.ToString("C")</td>
                                <td class="text-end">@producto.ValorVenta.ToString("C")</td>

                                <td class="text-center pe-4">
                                    <span class="badge @claseSituacion">
                                        @producto.Situacion
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="dashboard-empty">
                No se encontraron productos para los filtros seleccionados.
            </div>
        }
    </section>
</main>