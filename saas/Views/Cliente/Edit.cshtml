@model ClienteEditVM

@{
    ViewData["Title"] = "Editar Cliente";
}

<main class="container-fluid px-4">
    <div class="row">
        <!-- Form Column -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header">
                    Editar Cliente
                </div>

                <div class="card-body p-4">
                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <div class="alert alert-warning mb-4">
                            Está modificando un cliente como SuperAdministrador.
                            Verifique la empresa seleccionada antes de guardar los cambios.
                        </div>
                    }

                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-4">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input asp-for="Id" type="hidden" />

                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label">Nombre</label>
                            <input asp-for="Nombre"
                                   class="form-control"
                                   type="text"
                                   autocomplete="off" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Apellido" class="form-label">Apellido</label>
                            <input asp-for="Apellido"
                                   class="form-control"
                                   type="text"
                                   autocomplete="off" />
                            <span asp-validation-for="Apellido" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Documento" class="form-label">Documento</label>
                            <input asp-for="Documento"
                                   class="form-control"
                                   type="text"
                                   autocomplete="off" />
                            <span asp-validation-for="Documento" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label">Teléfono</label>
                            <input asp-for="Telefono"
                                   class="form-control"
                                   type="tel"
                                   autocomplete="off" />
                            <span asp-validation-for="Telefono" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email"
                                   class="form-control"
                                   type="email"
                                   autocomplete="off" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="col-md-6">
                                <label asp-for="EmpresaId" class="form-label">Empresa</label>
                                <select asp-for="EmpresaId"
                                        asp-items="Model.Empresas"
                                        class="form-select">
                                    <option value="">-- Seleccione una empresa --</option>
                                </select>
                                <span asp-validation-for="EmpresaId" class="text-danger"></span>
                            </div>
                        }
                        else
                        {
                            <input asp-for="EmpresaId" type="hidden" />
                        }

                        <div class="col-md-12">
                            <label asp-for="Direccion" class="form-label">Dirección</label>
                            <input asp-for="Direccion"
                                   class="form-control"
                                   type="text"
                                   autocomplete="off" />
                            <span asp-validation-for="Direccion" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="Estado"
                                       class="form-check-input"
                                       role="switch" />
                                <label asp-for="Estado" class="form-check-label fw-semibold">
                                    Estado del Cliente (Activo/Inactivo)
                                </label>
                            </div>

                            @if (!Model.Estado)
                            {
                                <div class="form-text">
                                    Active este campo para reactivar al cliente.
                                </div>
                            }
                        </div>

                        <div class="col-12 mt-5 border-top pt-4 d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-v-outline">Cancelar</a>
                            <button type="submit" class="btn btn-v-primary">Guardar cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Help Column -->
        <div class="col-md-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">badge</span>
                    <div>
                        <h3 class="help-guide-item__title">Documento</h3>
                        <p class="help-guide-item__text">
                            El documento puede modificarse, pero no debe coincidir con otro cliente de la misma empresa.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">corporate_fare</span>
                    <div>
                        <h3 class="help-guide-item__title">Cambio de empresa</h3>
                        <p class="help-guide-item__text">
                            Solamente el SuperAdministrador puede cambiar la empresa asociada al cliente.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">restart_alt</span>
                    <div>
                        <h3 class="help-guide-item__title">Reactivación</h3>
                        <p class="help-guide-item__text">
                            Un cliente desactivado puede volver a utilizarse activando su estado y guardando los cambios.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">history</span>
                    <div>
                        <h3 class="help-guide-item__title">Historial protegido</h3>
                        <p class="help-guide-item__text">
                            La edición no modifica la fecha de alta ni elimina la información histórica del cliente.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
