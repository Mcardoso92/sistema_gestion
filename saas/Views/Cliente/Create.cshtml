@model ClienteCreateVM

@{
    ViewData["Title"] = "Crear Cliente";
}

<main class="container-fluid px-4">
    <div class="row">
        <!-- Form Column -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header">
                    Nuevo Cliente
                </div>

                <div class="card-body p-4">
                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <div class="alert alert-warning mb-4">
                            Está creando un cliente como SuperAdministrador.
                            El cliente será asociado a la empresa seleccionada. Verifique esta información antes de guardar.
                        </div>
                    }

                    <form asp-action="Create" method="post" class="row g-4">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label">Nombre</label>
                            <input asp-for="Nombre"
                                   class="form-control"
                                   type="text"
                                   autocomplete="off"
                                   placeholder="Ingrese el nombre" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Apellido" class="form-label">Apellido</label>
                            <input asp-for="Apellido"
                                   class="form-control"
                                   type="text"
                                   autocomplete="off"
                                   placeholder="Ingrese el apellido" />
                            <span asp-validation-for="Apellido" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Documento" class="form-label">Documento</label>
                            <input asp-for="Documento"
                                   class="form-control"
                                   type="text"
                                   autocomplete="off"
                                   placeholder="DNI, CUIT o identificación" />
                            <span asp-validation-for="Documento" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label">Teléfono</label>
                            <input asp-for="Telefono"
                                   class="form-control"
                                   type="tel"
                                   autocomplete="off"
                                   placeholder="Ingrese un teléfono" />
                            <span asp-validation-for="Telefono" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email"
                                   class="form-control"
                                   type="email"
                                   autocomplete="off"
                                   placeholder="cliente@ejemplo.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="col-md-6">
                                <label asp-for="EmpresaId" class="form-label">Empresa</label>
                                <select asp-for="EmpresaId"
                                        asp-items="Model.Empresas"
                                        class="form-select">
                                    <option value="">-- Seleccione una empresa --</option>
                                </select>
                                <span asp-validation-for="EmpresaId" class="text-danger"></span>
                            </div>
                        }

                        <div class="col-md-12">
                            <label asp-for="Direccion" class="form-label">Dirección</label>
                            <input asp-for="Direccion"
                                   class="form-control"
                                   type="text"
                                   autocomplete="off"
                                   placeholder="Ingrese la dirección del cliente" />
                            <span asp-validation-for="Direccion" class="text-danger"></span>
                        </div>

                        <div class="col-12 mt-5 border-top pt-4 d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-v-outline">Cancelar</a>
                            <button type="submit" class="btn btn-v-primary">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Help Column -->
        <div class="col-md-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">person</span>
                    <div>
                        <h3 class="help-guide-item__title">Datos obligatorios</h3>
                        <p class="help-guide-item__text">
                            Solamente el nombre es obligatorio. El resto de la información puede completarse cuando esté disponible.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">badge</span>
                    <div>
                        <h3 class="help-guide-item__title">Documento</h3>
                        <p class="help-guide-item__text">
                            Cuando se informa, el documento debe ser único dentro de la empresa.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">contact_mail</span>
                    <div>
                        <h3 class="help-guide-item__title">Datos de contacto</h3>
                        <p class="help-guide-item__text">
                            El email y el teléfono permitirán localizar y contactar al cliente más fácilmente.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">bolt</span>
                    <div>
                        <h3 class="help-guide-item__title">Registro rápido</h3>
                        <p class="help-guide-item__text">
                            Puede crear un cliente solamente con su nombre y completar los demás datos posteriormente desde la edición.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
