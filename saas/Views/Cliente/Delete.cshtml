@model ClienteDeleteVM

@{
    ViewData["Title"] = "Desactivar Cliente";

    string nombreCompleto = string.IsNullOrWhiteSpace(Model.Apellido)
        ? Model.Nombre
        : $"{Model.Nombre} {Model.Apellido}";
}

<main class="container-fluid px-4">
    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header d-flex align-items-center">
                    <span class="material-symbols-outlined text-danger me-2">person_off</span>
                    Desactivar Cliente
                </div>

                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }

                    <div class="alert alert-warning d-flex align-items-start gap-3">
                        <span class="material-symbols-outlined">warning</span>

                        <div>
                            <div class="fw-semibold mb-1">
                                ¿Está seguro de que desea desactivar este cliente?
                            </div>

                            <div class="small">
                                El cliente dejará de aparecer entre los registros activos,
                                pero su información no será eliminada y podrá reactivarse desde la edición.
                            </div>
                        </div>
                    </div>

                    <div class="row g-4 mt-1">
                        <div class="col-md-6">
                            <label class="form-label">Cliente</label>
                            <input class="form-control"
                                   value="@nombreCompleto"
                                   readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Documento</label>
                            <input class="form-control"
                                   value="@(Model.Documento ?? "Sin documento")"
                                   readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input class="form-control"
                                   value="@(Model.Email ?? "Sin email")"
                                   readonly />
                        </div>

                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="col-md-6">
                                <label class="form-label">Empresa</label>
                                <input class="form-control"
                                       value="@Model.Empresa"
                                       readonly />
                            </div>
                        }

                        <div class="col-md-6">
                            <label class="form-label">Estado actual</label>

                            <div class="form-control d-flex align-items-center">
                                @if (Model.Estado)
                                {
                                    <span class="status-badge status-active">
                                        <span class="dot"></span>Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">
                                        <span class="dot"></span>Inactivo
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="mt-5 border-top pt-4 d-flex justify-content-end gap-3">

                        <input asp-for="Id" type="hidden" />

                        <a asp-action="Index" class="btn btn-v-outline">
                            Cancelar
                        </a>

                        @if (Model.Estado)
                        {
                            <button type="submit" class="btn btn-danger">
                                Desactivar cliente
                            </button>
                        }
                    </form>
                </div>
            </div>

        </div>

        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">person_off</span>
                    <div>
                        <h3 class="help-guide-item__title">Desactivación</h3>
                        <p class="help-guide-item__text">El cliente dejará de aparecer entre los registros activos y no podrá seleccionarse en nuevas operaciones.</p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">history</span>
                    <div>
                        <h3 class="help-guide-item__title">Historial protegido</h3>
                        <p class="help-guide-item__text">
                            VELTIKA utiliza desactivación lógica. El registro permanece almacenado para conservar su información y futuras relaciones con ventas, comprobantes e historial comercial.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">restart_alt</span>
                    <div>
                        <h3 class="help-guide-item__title">Reactivación</h3>
                        <p class="help-guide-item__text">Puede volver a habilitar el cliente posteriormente desde la pantalla Editar.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
