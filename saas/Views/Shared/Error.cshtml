@model ErrorViewModel

@{
    ViewData["Title"] = "Ocurrió un error";
}

<main class="page-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title">Ocurrió un error</h1>
            <p class="page-subtitle">No fue posible procesar la solicitud. Inténtelo nuevamente dentro de unos momentos.</p>
        </div>
    </div>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            Código de referencia: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-house"></i>
        Volver al inicio
    </a>
</main>