@using Microsoft.AspNetCore.Identity
@using saas.Models
@inject UserManager<Usuario> UserManager

@{
    var usuario = await UserManager.GetUserAsync(User);
    string controllerActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool navegacionCajaActiva = controllerActual is "Caja" or "TurnoCaja" or "MovimientoCaja" or "TransferenciaCaja" or "MedioPago";
    bool navegacionAdministracionActiva = controllerActual is "MovimientoStock" or "Categoria" or "Usuario" or "CategoriaGasto" or "Empresa";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Veltika</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/saas.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/typography.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/links.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/statuses.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/page-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="app-body">
    <header class="app-header">
        <div class="container-fluid px-4">
            <div class="app-navbar">
                <div class="app-navbar-left">
                    <a class="veltika-brand app-brand" asp-controller="Home" asp-action="Index">
                        <span class="veltika-brand-icon">V</span>
                        <span class="app-brand-name">Veltika</span>
                    </a>
                    @* Menu Mobile *@
                    <div class="dropdown app-mobile-nav">
                        <button class="app-mobile-nav-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Abrir menú principal">
                            <span class="material-symbols-outlined">menu</span>
                        </button>

                        <ul class="dropdown-menu app-menu app-mobile-menu">
                            <li><span class="dropdown-header">Principal</span></li>

                            <li>
                                <a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">
                                    <span class="material-symbols-outlined">dashboard</span>
                                    Dashboard
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Venta" asp-action="Index">
                                    <span class="material-symbols-outlined">point_of_sale</span>
                                    Ventas
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Compra" asp-action="Index">
                                    <span class="material-symbols-outlined">shopping_cart</span>
                                    Compras
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Producto" asp-action="Index">
                                    <span class="material-symbols-outlined">inventory_2</span>
                                    Productos
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Cliente" asp-action="Index">
                                    <span class="material-symbols-outlined">groups</span>
                                    Clientes
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Proveedor" asp-action="Index">
                                    <span class="material-symbols-outlined">local_shipping</span>
                                    Proveedores
                                </a>
                            </li>

                            <li><hr class="dropdown-divider" /></li>

                            <li><span class="dropdown-header">Administración</span></li>

                            <li>
                                <a class="dropdown-item" asp-controller="MovimientoStock" asp-action="Index">
                                    <span class="material-symbols-outlined">deployed_code</span>
                                    Stock
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Categoria" asp-action="Index">
                                    <span class="material-symbols-outlined">category</span>
                                    Categorías
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Usuario" asp-action="Index">
                                    <span class="material-symbols-outlined">manage_accounts</span>
                                    Usuarios
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="CategoriaGasto" asp-action="Index">
                                    <span class="material-symbols-outlined">receipt_long</span>
                                    Categorías de gasto
                                </a>
                            </li>

                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Empresa" asp-action="Index">
                                        <span class="material-symbols-outlined">domain</span>
                                        Empresas
                                    </a>
                                </li>
                            }

                            <li><hr class="dropdown-divider" /></li>
                            <li><span class="dropdown-header">Caja</span></li>

                            <li>
                                <a class="dropdown-item" asp-controller="Caja" asp-action="Index">
                                    <span class="material-symbols-outlined">account_balance</span>
                                    Cajas
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="TurnoCaja" asp-action="Index">
                                    <span class="material-symbols-outlined">account_balance_wallet</span>
                                    Turnos
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="MovimientoCaja" asp-action="Index">
                                    <span class="material-symbols-outlined">payments</span>
                                    Movimientos de caja
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="TransferenciaCaja" asp-action="Index">
                                    <span class="material-symbols-outlined">swap_horiz</span>
                                    Transferencias
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="MedioPago" asp-action="Index">
                                    <span class="material-symbols-outlined">credit_card</span>
                                    Medios de pago
                                </a>
                            </li>

                            <li><hr class="dropdown-divider" /></li>
                            <li><span class="dropdown-header">Reportes</span></li>

                            <li>
                                <a class="dropdown-item" asp-controller="Reporte" asp-action="Ventas">
                                    <span class="material-symbols-outlined">monitoring</span>
                                    Ventas
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Reporte" asp-action="Stock">
                                    <span class="material-symbols-outlined">inventory</span>
                                    Stock
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Reporte" asp-action="Productos">
                                    <span class="material-symbols-outlined">inventory_2</span>
                                    Productos
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Reporte" asp-action="Clientes">
                                    <span class="material-symbols-outlined">groups</span>
                                    Clientes
                                </a>
                            </li>
                        </ul>
                    </div>
                    @* Menu Web *@
                    <nav class="app-nav">
                        <a class="app-nav-link @(controllerActual == "Dashboard" ? "active" : "")"
                           asp-controller="Dashboard" asp-action="Index">
                            <span class="material-symbols-outlined">dashboard</span>
                            Dashboard
                        </a>

                        <a class="app-nav-link @(controllerActual == "Venta" ? "active" : "")"
                           asp-controller="Venta" asp-action="Index">
                            <span class="material-symbols-outlined">point_of_sale</span>
                            Ventas
                        </a>

                        <a class="app-nav-link @(controllerActual == "Compra" ? "active" : "")"
                           asp-controller="Compra" asp-action="Index">
                            <span class="material-symbols-outlined">shopping_cart</span>
                            Compras
                        </a>

                        <a class="app-nav-link @(controllerActual == "Producto" ? "active" : "")"
                           asp-controller="Producto" asp-action="Index">
                            <span class="material-symbols-outlined">inventory_2</span>
                            Productos
                        </a>

                        <a class="app-nav-link @(controllerActual == "Cliente" ? "active" : "")"
                           asp-controller="Cliente" asp-action="Index">
                            <span class="material-symbols-outlined">groups</span>
                            Clientes
                        </a>

                        <a class="app-nav-link @(controllerActual == "Proveedor" ? "active" : "")"
                           asp-controller="Proveedor" asp-action="Index">
                            <span class="material-symbols-outlined">local_shipping</span>
                            Proveedores
                        </a>

                        <div class="dropdown">
                            <button class="app-nav-more @(navegacionCajaActiva ? "active" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="material-symbols-outlined">account_balance</span>
                                Caja
                                <span class="material-symbols-outlined app-nav-chevron">expand_more</span>
                            </button>

                            <ul class="dropdown-menu app-menu">
                                <li>
                                    <a class="dropdown-item" asp-controller="Caja" asp-action="Index">
                                        <span class="material-symbols-outlined">account_balance</span>
                                        Cajas
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="TurnoCaja" asp-action="Index">
                                        <span class="material-symbols-outlined">account_balance_wallet</span>
                                        Turnos
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="MovimientoCaja" asp-action="Index">
                                        <span class="material-symbols-outlined">payments</span>
                                        Movimientos
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="TransferenciaCaja" asp-action="Index">
                                        <span class="material-symbols-outlined">swap_horiz</span>
                                        Transferencias
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="MedioPago" asp-action="Index">
                                        <span class="material-symbols-outlined">credit_card</span>
                                        Medios de pago
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <div class="dropdown">
                            <button class="app-nav-more @(controllerActual == "Reporte" ? "active" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="material-symbols-outlined">monitoring</span>
                                Reportes
                                <span class="material-symbols-outlined app-nav-chevron">expand_more</span>
                            </button>

                            <ul class="dropdown-menu app-menu">
                                <li>
                                    <a class="dropdown-item" asp-controller="Reporte" asp-action="Ventas">
                                        <span class="material-symbols-outlined">point_of_sale</span>
                                        Ventas
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Reporte" asp-action="Stock">
                                        <span class="material-symbols-outlined">inventory</span>
                                        Stock
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Reporte" asp-action="Productos">
                                        <span class="material-symbols-outlined">inventory_2</span>
                                        Productos
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Reporte" asp-action="Clientes">
                                        <span class="material-symbols-outlined">groups</span>
                                        Clientes
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <div class="dropdown">
                            <button class="app-nav-more @(navegacionAdministracionActiva ? "active" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="material-symbols-outlined">more_horiz</span>
                                Más
                                <span class="material-symbols-outlined app-nav-chevron">expand_more</span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end app-menu">
                                <li>
                                    <a class="dropdown-item" asp-controller="MovimientoStock" asp-action="Index">
                                        <span class="material-symbols-outlined">deployed_code</span>
                                        Stock
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Categoria" asp-action="Index">
                                        <span class="material-symbols-outlined">category</span>
                                        Categorías
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Usuario" asp-action="Index">
                                        <span class="material-symbols-outlined">manage_accounts</span>
                                        Usuarios
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="CategoriaGasto" asp-action="Index">
                                        <span class="material-symbols-outlined">receipt_long</span>
                                        Categorías de gasto
                                    </a>
                                </li>

                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Empresa" asp-action="Index">
                                            <span class="material-symbols-outlined">domain</span>
                                            Empresas
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </nav>
                </div>

                <div class="app-user-area">
                    @await Component.InvokeAsync("Notificaciones")

                    @if (usuario != null)
                    {
                        <div class="dropdown">
                            <button class="app-user-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (!string.IsNullOrWhiteSpace(usuario.ImagenPerfil))
                                {
                                    <img src="@usuario.ImagenPerfil" alt="Imagen de perfil" class="app-avatar" style="object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="app-avatar">
                                        @(string.IsNullOrWhiteSpace(usuario.Email) ? "U" : usuario.Email.Substring(0, 1).ToUpper())
                                    </span>
                                }

                                <span class="app-user-data">
                                    <span class="app-user-email">@usuario.Email</span>
                                    <span class="app-user-role">@(User.IsInRole("SuperAdmin") ? "SuperAdmin" : "Usuario")</span>
                                </span>

                                <span class="material-symbols-outlined app-user-chevron">expand_more</span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end app-menu">
                                <li><span class="dropdown-header">Mi cuenta</span></li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Usuario"
                                       asp-action="CambiarPassword">

                                        <span class="material-symbols-outlined">
                                            password
                                        </span>

                                        Cambiar contraseña
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Configuracion"
                                       asp-action="Index">

                                        <span class="material-symbols-outlined">
                                            settings
                                        </span>

                                        Configuración
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>

                                <li>
                                    <form asp-controller="Usuario" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="dropdown-item app-logout">
                                            <span class="material-symbols-outlined">logout</span>
                                            Cerrar sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </header>

    <div class="app-content" role="main">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
    </div>

    @* Agrega una versión al enlace para renovar automáticamente los archivos almacenados en caché. *@
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
