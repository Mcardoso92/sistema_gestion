<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Veltika</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/saas.styles.css" asp-append-version="true" />
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <!-- Material Symbols Outlined -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="navbar-custom sticky-top shadow-sm py-2">
        <div class="container-fluid px-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <a class="h4 mb-0 text-white fw-bold text-uppercase me-4"" asp-area="" asp-controller="Home" asp-action="Index">Veltika</a>
                <nav class="d-none d-md-flex align-items-center gap-4">
                    <a class="text-white-50 text-decoration-none hover-white"
                       asp-controller="Home"
                       asp-action="Index">
                        Inicio
                    </a>

                    <a class="text-white-50 text-decoration-none hover-white"
                       asp-controller="Empresa"
                       asp-action="Index">
                        Empresas
                    </a>

                    <a class="text-white-50 text-decoration-none hover-white"
                       asp-controller="Categoria"
                       asp-action="Index">
                        Categorías
                    </a>

                    <a class="text-white-50 text-decoration-none hover-white"
                       asp-controller="Producto"
                       asp-action="Index">
                        Productos
                    </a>

                    <a class="text-white-50 text-decoration-none hover-white"
                       asp-controller="Venta"
                       asp-action="Index">
                        Ventas
                    </a>
                </nav>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-link text-white p-1 text-decoration-none rounded-circle">
                        <span class="material-symbols-outlined">notifications</span>
                    </button>
                    <button class="btn btn-link text-white p-1 text-decoration-none rounded-circle">
                        <span class="material-symbols-outlined">settings</span>
                    </button>
                    <div class="ms-1" style="width: 32px; height: 32px;">
                        <img alt="Profile" class="rounded-circle border border-light w-100 h-100 object-fit-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCnAQ9i5QBWv13xvwmsPlFyI179VA3zTZX_vCYCMn6CCgpZsDoabb7Usja0lhkXpXR9pwx9CcbxGaH-GQ6_3b3O-BOWPJurnc8BxRx73D74S0qPhoHXoCLC3SIEox_dClgFlCNUtIGdt2Darn9LDqJf4qMu1nl2urwyM48wSiiHgnVwK-36E8L94860ylobpF72E_mOKMHvxCWUSJCHdQn9IkkCEWzfXRkDpVjpi3xPzU2jrEyH7P0IaOVYZIslfNPy4a8ns4ghpz5e" />
                    </div>
                </div>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - saas - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
