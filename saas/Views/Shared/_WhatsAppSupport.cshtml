@inject IConfiguration Configuration

@{
    string whatsappNumero = Configuration["Support:WhatsAppNumber"] ?? "";
    string whatsappMensaje = Configuration["Support:WhatsAppMessage"] ?? "";
    string whatsappUrl = $"https://wa.me/{whatsappNumero}?text={Uri.EscapeDataString(whatsappMensaje)}";
}

@if (!string.IsNullOrWhiteSpace(whatsappNumero))
{
    <a class="whatsapp-support"
       href="@whatsappUrl"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="Contactar al soporte de Veltika por WhatsApp">
        <span class="whatsapp-support-label" aria-hidden="true">¿Necesitás ayuda?</span>
        <span class="whatsapp-support-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" focusable="false">
                <path d="M16.04 3A12.92 12.92 0 0 0 4.9 22.47L3 29l6.7-1.76A12.97 12.97 0 1 0 16.04 3Zm0 23.75a10.75 10.75 0 0 1-5.48-1.5l-.39-.23-3.97 1.04 1.06-3.87-.25-.4a10.77 10.77 0 1 1 9.03 4.96Zm5.9-8.07c-.32-.16-1.91-.94-2.21-1.05-.3-.11-.51-.16-.73.16-.21.32-.83 1.05-1.02 1.27-.19.21-.38.24-.7.08-.33-.16-1.37-.5-2.61-1.61a9.78 9.78 0 0 1-1.81-2.25c-.19-.32-.02-.5.14-.66.15-.14.33-.38.49-.57.16-.19.22-.32.33-.54.1-.21.05-.4-.03-.56-.08-.16-.73-1.75-1-2.4-.26-.63-.53-.54-.73-.55h-.62c-.22 0-.57.08-.86.4-.3.32-1.14 1.11-1.14 2.72 0 1.6 1.17 3.15 1.33 3.37.16.21 2.3 3.51 5.57 4.92.78.34 1.39.54 1.86.69.78.25 1.49.21 2.05.13.63-.09 1.91-.78 2.18-1.53.27-.76.27-1.41.19-1.54-.08-.14-.3-.22-.62-.38Z" />
            </svg>
        </span>
    </a>
}
