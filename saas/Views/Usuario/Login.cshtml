@model LoginVM

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_PublicLayout";
}


<main class="main-content">
    <div class="bg-decorative">
    </div>
    <div class="login-card">
        <div class="text-center mb-4">
            <h1 class="page-title mb-2">Bienvenido</h1>
            <p class="page-subtitle small">Ingresa tus credenciales para acceder a la plataforma</p>
        </div>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <!-- Floating Label Email -->
            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" id="emailInput" placeholder="nombre@empresa.com" type="email" />
                <label asp-for="Email">Correo Electrónico</label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <!-- Floating Label Password -->
            <div class="form-floating mb-3">
                <input asp-for="Password" class="form-control" id="passwordInput" placeholder="Contraseña" type="password" />
                <label asp-for="Password">Contraseña</label>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberMe" type="checkbox" />
                    <label asp-for="RememberMe" class="form-check-label small" for="rememberMe">
                        Recordarme
                    </label>
                </div>
                <a class="small text-decoration-none text-primary"
                   asp-action="RecuperarPassword">
                    ¿Olvidaste tu contraseña?
                </a>
            </div>
            <button class="btn btn-primary-custom w-100 mb-3" type="submit">
                Iniciar Sesión
            </button>
            <div class="text-center">
                <span class="small text-muted">¿Todavía no tenés una cuenta?</span>
                <a asp-action="Registro" class="small text-decoration-none text-primary fw-semibold">
                    Crear cuenta
                </a>
            </div>
        </form>
    </div>
</main>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}