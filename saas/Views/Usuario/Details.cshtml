@model Usuario

<main class="container-fluid px-4 mb-5">
    <!-- Header -->
    <div class="page-header">
        <div class="page-header-content">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item"><a class="text-decoration-none text-muted" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a class="text-decoration-none text-muted" asp-action="Index">Usuarios</a></li>
                    <li aria-current="page" class="breadcrumb-item active fw-semibold">Detalle del Usuario</li>
                </ol>
            </nav>
            <h1 class="page-title">Detalle del Usuario</h1>
            <p class="page-subtitle">Visualice la información detallada y el historial del miembro seleccionado.</p>
        </div>
    </div>
    <!-- Two-Column Layout -->
    <div class="row g-4">
        <!-- Main Info Column -->
        <div class="col-lg-8">
            <div class="detail-card p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <h2 class="section-title mb-0">Información del Usuario</h2>
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-v-outline">Volver</a>
                        <a asp-action="Edit"  asp-route-id="@Model.Id" class="btn btn-v-primary">Editar</a>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="detail-label">Nombre Completo</div>
                        <div class="detail-value">@Model.Nombre @Model.Apellido</div>
                        <div class="detail-label">Correo Electrónico</div>
                        <div class="detail-value">@Model.Email</div>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="detail-label">Empresa Asociada</div>
                            <div class="detail-value">@Model.Empresa.Nombre</div>
                        }
                    </div>
                    <div class="col-md-6">
                        <div class="detail-label">Rol del Sistema</div>
                        <div class="detail-value">@TextoPresentacion.Rol(ViewBag.Rol as string)</div>
                        <div class="detail-label">Estado de Cuenta</div>
                        <div class="detail-value">
                            @if (Model.Estado)
                            {
                                <span class="status-badge status-active">Activo</span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">Inactivo</span>
                            }
                        </div>
                        <div class="detail-label">Fecha de alta</div>
                        <div class="detail-value">@FechaHora.ConvertirAHoraLocal(Model.FechaAlta).ToString("dd/MM/yyyy")</div>
                    </div>
                </div>
                <div class="info-callout mt-4">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center mb-1">
                            <span class="material-symbols-outlined text-primary me-2 fs-5">info</span>
                            <span class="fw-bold small text-primary">Aviso de Seguridad</span>
                        </div>
                        <p class="small mb-0 text-primary-emphasis">
                            Información

                            Los permisos de este usuario están definidos por el rol asignado.

                            Para modificarlos utilice la opción Editar.
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <!-- Help Guide Column -->
        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">manage_accounts</span>
                    <div>
                        <h3 class="help-guide-item__title">Gestión de Perfiles</h3>
                        <p class="help-guide-item__text">Los administradores regionales supervisan operaciones dentro de su zona asignada. Verifique el email antes de otorgar permisos de auditoría.</p>
                    </div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">help_outline</span>
                    <div>
                        <h3 class="help-guide-item__title">¿Cambiar el rol?</h3>
                        <p class="help-guide-item__text">Haga clic en "Editar Perfil" para modificar los permisos y el nivel de acceso del usuario en el sistema.</p>
                    </div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">history</span>
                    <div>
                        <h3 class="help-guide-item__title">Registro de Actividad</h3>
                        <p class="help-guide-item__text">Puede consultar todas las acciones realizadas por este usuario desde el módulo de logs de seguridad.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
