@model UsuarioEditVM

<main class="container-fluid px-4 mb-5">
    <!-- Header -->
    <div class="row align-items-end mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item"><a class="text-decoration-none text-muted" href="#">Dashboard</a></li>
                    <li class="breadcrumb-item"><a class="text-decoration-none text-muted" href="#">Usuarios</a></li>
                    <li aria-current="page" class="breadcrumb-item active fw-semibold">Modificar Información del Usuario</li>
                </ol>
            </nav>
            <h1 class="display-6 fw-bold text-dark mb-1">Modificar Información del Usuario</h1>
            <p class="text-muted mb-0">Complete el siguiente formulario para modificar la información del usuario.</p>
        </div>
    </div>
    <!-- Two-Column Layout -->
    <div class="row g-4">
        <!-- Main Form Column -->
        <div class="col-lg-8">
            <div class="form-container border p-4 p-md-5">
                <h2 class="h5 fw-bold mb-4 border-bottom pb-3">Información del Usuario</h2>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <div class="alert alert-warning mb-4">
                        Está modificando un usuario como SuperAdministrador.
                        Recuerde asignarlo a la empresa correcta y seleccionar el rol adecuado.
                    </div>
                }
                <form asp-action="Edit" method="post" enctype="multipart/form-data" id="newUserForm">
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="ImagenActual" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label">Nombre del Usuario</label>
                            <input asp-for="Nombre" class="form-control" type="text" autocomplete="off" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Apellido" class="form-label">Apellido del Usuario</label>
                            <input asp-for="Apellido" class="form-control" type="text" autocomplete="off" />
                            <span asp-validation-for="Apellido" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label">Email Corporativo</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <span class="material-symbols-outlined text-muted">mail</span>
                                </span>
                                <input asp-for="Email" class="form-control border-start-0" placeholder="" type="email">                                
                            </div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ImagenArchivo" class="form-label">Imagen de perfil</label>

                            @if (!string.IsNullOrWhiteSpace(Model.ImagenActual))
                            {
                                <div class="mb-3">
                                    <img src="@Model.ImagenActual" alt="Imagen de @Model.Nombre @Model.Apellido" class="img-thumbnail rounded-circle" style="width: 140px; height: 140px; object-fit: cover;" />
                                </div>
                            }

                            <input asp-for="ImagenArchivo" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                            <span asp-validation-for="ImagenArchivo" class="text-danger"></span>
                            <div class="form-text">Seleccioná una imagen solamente si querés reemplazar la actual. Formatos permitidos: JPG, PNG o WebP. Tamaño máximo: 2 MB.</div>

                            @if (!string.IsNullOrWhiteSpace(Model.ImagenActual))
                            {
                                <div class="form-check mt-3">
                                    <input asp-for="EliminarImagen" class="form-check-input" />
                                    <label asp-for="EliminarImagen" class="form-check-label">Eliminar imagen actual</label>
                                </div>
                            }
                        </div>
                        @if (!Model.EsUsuarioLogueado)
                        {

                            <div class="col-md-6">
                                <label asp-for="Rol" class="form-label">Rol de Usuario</label>
                                <select asp-for="Rol" asp-items="Model.Roles" class="form-select">
                                    <option value="">-- Seleccione un Rol --</option>
                                </select>
                                <span asp-validation-for="Rol" class="text-danger"></span>
                            </div>
                        }
                        else
                        {
                            <input asp-for="Rol" type="hidden" />
                        }
                        @if (User.IsInRole("SuperAdmin") && !Model.EsUsuarioLogueado)
                        {
                            <div class="col-md-6">
                                <label asp-for="EmpresaId" class="form-label">Empresa Asociada</label>
                                <select asp-for="EmpresaId" asp-items="Model.Empresas" class="form-select">
                                    <option value="">-- Seleccione una empresa --</option>
                                </select>
                                <span asp-validation-for="EmpresaId" class="text-danger"></span>
                            </div>
                        }
                        <div class="col-12 mt-4">
                            <div class="form-check form-switch d-flex align-items-center gap-3 ps-0">
                                <label asp-for="Estado" class="form-label mb-0">Estado del Usuario</label>
                                <input asp-for="Estado" class="form-check-input ms-0 mt-0" id="userStatus" role="switch" style="width: 2.8em; height: 1.4em; cursor: pointer;" type="checkbox">                                
                                @if (Model.Estado)
                                {
                                    <span class="badge rounded-pill bg-success px-3 py-2 text-uppercase fw-bold"
                                        id="statusBadge"
                                        style="font-size: 0.65rem;">
                                        ACTIVO
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-danger px-3 py-2 text-uppercase fw-bold"
                                        id="statusBadge"
                                        style="font-size: 0.65rem;">
                                        INACTIVO
                                    </span>
                                }                                
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-3 pt-4 mt-4 border-top">
                        <a asp-action="Index" class="btn btn-v-outline">Cancelar</a>
                        <button type="submit" class="btn btn-v-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
        <!-- Help Guide Column -->
        <div class="col-lg-4">
            <div class="form-container border p-4 p-md-5 h-100 d-flex flex-column">
                <h2 class="h5 fw-bold mb-4 border-bottom pb-3">Guía de Ayuda</h2>
                <div class="help-guide-item d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-primary-veltika fs-4 mt-1">shield_lock</span>
                    <div>
                        <h3 class="h6 fw-bold mb-1">Requisitos de Contraseña</h3>
                        <p class="small text-muted mb-0">Mínimo 12 caracteres, incluir mayúsculas, números y un carácter especial.</p>
                    </div>
                </div>
                <div class="help-guide-item d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-primary-veltika fs-4 mt-1">badge</span>
                    <div>
                        <h3 class="h6 fw-bold mb-1">Definición de Roles</h3>
                        <p class="small text-muted mb-0">Los roles determinan los permisos de acceso y edición en los módulos de ventas y productos.</p>
                    </div>
                </div>
                <div class="help-guide-item d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-primary-veltika fs-4 mt-1">corporate_fare</span>
                    <div>
                        <h3 class="h6 fw-bold mb-1">Organización</h3>
                        <p class="small text-muted mb-0">Asegúrese de vincular al usuario con su sucursal o matriz correspondiente para reportes regionales.</p>
                    </div>
                </div>
                <div class="mt-auto pt-4">
                    <div class="rounded overflow-hidden shadow-sm border mb-3" style="height: 180px; background: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCm9IU27yOF55-MZ3eXO0RLtz0j8npcG4F1JZpPPGWhZlOvmj8ki_ahd_et0HtbTRCfinWu_cRp3hcyEzjtw7xPuW6KBMaHWNuHTRg3dhKdvLncWzqtXOY8B84F7ycVZNVY5KF7jMQDFaLqqRYhNP8DloSWoq62Kb-TnmpDFg-twXpNKGpdS90pFABMdtCTlUUrav_hlVkKSmujFOqNs3VQIk_yLDYSK5H1AsugdVSwN9kpHSpISeTr8Q') center/cover no-repeat;">
                    </div>
                    <p class="text-center small text-muted mb-0">VELTIKA Enterprise Governance Module v4.2</p>
                </div>
            </div>
        </div>
    </div>
</main>