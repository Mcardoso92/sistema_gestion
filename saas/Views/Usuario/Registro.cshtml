@model saas.ViewModel.Autenticacion.RegistroEmpresaVM

@{
    ViewData["Title"] = "Crear cuenta";
    Layout = "_PublicLayout";
}

<main class="main-content">
    <div class="bg-decorative"></div>

    <div class="login-card">
        <div class="text-center mb-4">
            <h1 class="h4 fw-bold mb-2">Creá tu cuenta</h1>
            <p class="text-muted small mb-0">Completá los datos para comenzar a utilizar Veltika</p>
        </div>

        <form asp-action="Registro" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-floating mb-3">
                <input asp-for="Nombre" class="form-control" placeholder="Nombre" autocomplete="given-name" />
                <label asp-for="Nombre">Nombre</label>
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Apellido" class="form-control" placeholder="Apellido" autocomplete="family-name" />
                <label asp-for="Apellido">Apellido</label>
                <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="EmpresaNombre" class="form-control" placeholder="Nombre del comercio" autocomplete="organization" />
                <label asp-for="EmpresaNombre">Nombre del comercio</label>
                <span asp-validation-for="EmpresaNombre" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" placeholder="nombre@empresa.com" type="email" autocomplete="email" />
                <label asp-for="Email">Correo electrónico</label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Password" class="form-control" placeholder="Contraseña" type="password" autocomplete="new-password" />
                <label asp-for="Password">Contraseña</label>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="ConfirmarPassword" class="form-control" placeholder="Confirmar contraseña" type="password" autocomplete="new-password" />
                <label asp-for="ConfirmarPassword">Confirmar contraseña</label>
                <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
            </div>

            <button class="btn btn-primary-custom w-100 mb-3" type="submit">
                Crear cuenta
            </button>

            <div class="text-center">
                <span class="small text-muted">¿Ya tenés una cuenta?</span>
                <a asp-action="Login" class="small text-decoration-none text-primary fw-semibold">
                    Iniciar sesión
                </a>
            </div>
        </form>
    </div>
</main>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}