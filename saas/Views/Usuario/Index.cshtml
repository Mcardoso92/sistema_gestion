@using Microsoft.AspNetCore.Identity
@model IEnumerable<Usuario>

@{
    ViewData["Title"] = "Usuarios";

    string estadoSeleccionado = ViewBag.Estado?.ToString() ?? "activos";
    string? rolSeleccionado = ViewBag.Rol?.ToString();
    int? empresaSeleccionada = ViewBag.EmpresaId as int?;
    string? busqueda = ViewBag.Busqueda?.ToString();

    IEnumerable<IdentityRole> rolesDisponibles = ViewBag.RolesDisponibles as IEnumerable<IdentityRole>
        ?? Enumerable.Empty<IdentityRole>();

    IEnumerable<Empresa> empresas = ViewBag.Empresas as IEnumerable<Empresa>
        ?? Enumerable.Empty<Empresa>();

    Dictionary<string, string> rolesUsuarios = ViewBag.Roles as Dictionary<string, string>
        ?? new Dictionary<string, string>();
}

<main class="container-fluid px-4 mb-5">
    <!-- Header -->
    <div class="row align-items-end mb-4">
        <div class="col-md-8">
            <h1 class="display-6 fw-bold text-dark mb-1">Gestión de Usuarios</h1>
            <p class="text-muted mb-0">Administre los accesos y perfiles de los usuarios del sistema VELTIKA.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-primary-veltika px-4 py-2">
                <span class="material-symbols-outlined me-1">person_add</span>
                <span class="fw-medium small">Nuevo Usuario</span>
            </a>
        </div>
    </div>
    <!-- Filter Bar -->
    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label for="estado" class="form-label small fw-bold text-muted text-uppercase">Estado</label>

                    <select id="estado" name="estado" class="form-select">
                        <option value="activos" selected="@(estadoSeleccionado == "activos")">Activos</option>
                        <option value="inactivos" selected="@(estadoSeleccionado == "inactivos")">Inactivos</option>
                        <option value="todos" selected="@(estadoSeleccionado == "todos")">Todos</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="rol" class="form-label small fw-bold text-muted text-uppercase">Rol</label>

                    <select id="rol" name="rol" class="form-select">
                        <option value="">Todos los roles</option>

                        @foreach (var rol in rolesDisponibles)
                        {
                            <option value="@rol.Name" selected="@(rolSeleccionado == rol.Name)">
                                @rol.Name
                            </option>
                        }
                    </select>
                </div>

                @if (User.IsInRole("SuperAdmin"))
                {
                    <div class="col-md-2">
                        <label for="empresaId" class="form-label small fw-bold text-muted text-uppercase">Empresa</label>

                        <select id="empresaId" name="empresaId" class="form-select">
                            <option value="">Todas las empresas</option>

                            @foreach (var empresa in empresas)
                            {
                                <option value="@empresa.Id" selected="@(empresaSeleccionada == empresa.Id)">
                                    @empresa.Nombre
                                </option>
                            }
                        </select>
                    </div>
                }

                <div class="col-md-4">
                    <label for="busqueda" class="form-label small fw-bold text-muted text-uppercase">Buscar usuario</label>

                    <div class="search-input-wrapper">
                        <span class="material-symbols-outlined">search</span>

                        <input id="busqueda"
                               name="busqueda"
                               value="@busqueda"
                               class="form-control"
                               placeholder="Buscar por nombre, apellido o email..."
                               type="text" />
                    </div>
                </div>

                <div class="col-md-auto">
                    <button type="submit" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined fs-5">search</span>
                        <span>Buscar</span>
                    </button>
                </div>

                @if (estadoSeleccionado != "activos" ||
                                !string.IsNullOrWhiteSpace(rolSeleccionado) ||
                                empresaSeleccionada.HasValue ||
                                !string.IsNullOrWhiteSpace(busqueda))
                {
                    <div class="col-md-auto">
                        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                    </div>
                }
            </form>
        </div>
    </div>
    <!-- Table Section -->
    <div class="table-container border">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 small fw-bold text-muted text-uppercase">Nombre</th>
                        <th class="py-3 small fw-bold text-muted text-uppercase">Apellido</th>
                        <th class="py-3 small fw-bold text-muted text-uppercase">Email</th>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <th class="py-3 small fw-bold text-muted text-uppercase">Empresa</th>
                        }
                        <th class="py-3 small fw-bold text-muted text-uppercase">Rol</th>
                        <th class="py-3 small fw-bold text-muted text-uppercase">Estado</th>
                        <th class="py-3 small fw-bold text-muted text-uppercase">Fecha de Alta</th>
                        <th class="pe-4 py-3 small fw-bold text-muted text-uppercase text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(User.IsInRole("SuperAdmin") ? 8 : 7)" class="text-center text-muted py-5">
                                No se encontraron usuarios para los criterios seleccionados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td class="fw-medium">@usuario.Nombre</td>
                                <td>@usuario.Apellido</td>
                                <td class="text-muted">@usuario.Email</td>
                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <td>
                                        @usuario.Empresa.Nombre
                                    </td>
                                }
                            <td>
                                @(rolesUsuarios.TryGetValue(usuario.Id, out var rolUsuario)
                                                            ? rolUsuario
                                                            : "")
                        </td>
                        <td>
                            @if (usuario.Estado)
                                    {
                                        <span class="badge badge-active rounded-pill px-3 py-2 text-uppercase fw-bold" style="font-size: 0.65rem;">
                                            <span class="d-inline-block rounded-circle bg-success me-1" style="width: 6px; height: 6px;"></span> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-inactive rounded-pill px-3 py-2 text-uppercase fw-bold" style="font-size: 0.65rem;">
                                            <span class="d-inline-block rounded-circle bg-danger me-1" style="width: 6px; height: 6px;"></span> Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="text-muted">@usuario.FechaAlta.ToString("dd/MM/yyyy")</td>
                                <td class="pe-4 text-end">
                                    <a asp-action="Details" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                                    <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                                    @if (usuario.Estado)
                                    {
                                        <a asp-action="Delete"
                                           asp-route-id="@usuario.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Desactivar
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        <div class="card-footer bg-white border-top p-4">
            <span class="small text-muted">

                @Model.Count()
                @(Model.Count() == 1
                                ? "usuario encontrado"
                                : "usuarios encontrados")

            </span>
        </div>
    </div>
</main>