@model IEnumerable<Usuario>

<main class="container-fluid px-4 mb-5">
    <!-- Header -->
    <div class="row align-items-end mb-4">
        <div class="col-md-8">
            <h1 class="display-6 fw-bold text-dark mb-1">Gestión de Usuarios</h1>
            <p class="text-muted mb-0">Administre los accesos y perfiles de los usuarios del sistema VELTIKA.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <button class="btn btn-primary-veltika px-4 py-2">
                <span class="material-symbols-outlined me-1">person_add</span>
                <span class="fw-semibold">Crear Usuario</span>
            </button>
        </div>
    </div>
    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted text-uppercase">Búsqueda rápida</label>
                    <div class="input-group">
                        <input class="form-control" placeholder="Filtrar por nombre, email o empresa..." type="text" />
                        <span class="input-group-text bg-white border-start-0">
                            <span class="material-symbols-outlined text-muted">search</span>
                        </span>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted text-uppercase">Estado</label>
                    <select class="form-select">
                        <option>Todos los estados</option>
                        <option>Activo</option>
                        <option>Pendiente</option>
                        <option>Inactivo</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted text-uppercase">Empresa</label>
                    <select class="form-select">
                        <option>Todas las empresas</option>
                        <option>VELTIKA Global</option>
                        <option>Logística Austral</option>
                        <option>Sistemas del Norte</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <!-- Table Section -->
    <div class="table-container border">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 small fw-bold text-muted text-uppercase">Nombre</th>
                        <th class="py-3 small fw-bold text-muted text-uppercase">Apellido</th>
                        <th class="py-3 small fw-bold text-muted text-uppercase">Email</th>
                        <th class="py-3 small fw-bold text-muted text-uppercase">Empresa</th>
                        <th class="py-3 small fw-bold text-muted text-uppercase">Rol</th>
                        <th class="py-3 small fw-bold text-muted text-uppercase">Estado</th>
                        <th class="py-3 small fw-bold text-muted text-uppercase">Fecha de Alta</th>
                        <th class="pe-4 py-3 small fw-bold text-muted text-uppercase text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td class="fw-medium">@usuario.Nombre</td>
                            <td>@usuario.Apellido</td>
                            <td class="text-muted">@usuario.Email</td>
                            <td>@usuario.Empresa.Nombre</td>
                            <td>@ViewBag.Roles[usuario.Id]</td>
                            <td>
                                @if (usuario.Estado)
                                {
                                    <span class="badge badge-active rounded-pill px-3 py-2 text-uppercase fw-bold" style="font-size: 0.65rem;">
                                        <span class="d-inline-block rounded-circle bg-success me-1" style="width: 6px; height: 6px;"></span> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-inactive rounded-pill px-3 py-2 text-uppercase fw-bold" style="font-size: 0.65rem;">
                                        <span class="d-inline-block rounded-circle bg-danger me-1" style="width: 6px; height: 6px;"></span> Inactivo
                                    </span>
                                }
                            </td>
                            <td class="text-muted">@usuario.FechaAlta.ToString("dd/MM/yyyy")</td>
                            <td class="pe-4 text-end">                           
                                <a asp-action="Details" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                                <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                                <a asp-action="Delete" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        <div class="card-footer bg-white border-top p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="small text-muted">Mostrando 1-5 de 24 usuarios</div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item disabled">
                            <a aria-label="Previous" class="page-link" href="#">
                                <span class="material-symbols-outlined fs-6">chevron_left</span>
                            </a>
                        </li>
                        <li class="page-item active"><a class="page-link bg-primary-veltika border-primary-veltika" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                            <a aria-label="Next" class="page-link" href="#">
                                <span class="material-symbols-outlined fs-6">chevron_right</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</main>


