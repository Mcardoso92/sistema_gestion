@model UsuarioDeleteVM

<main class="container-fluid px-4 mb-5">
    <!-- Header -->
    <div class="row align-items-end mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item"><a class="text-decoration-none text-muted" href="#">Dashboard</a></li>
                    <li class="breadcrumb-item"><a class="text-decoration-none text-muted" href="#">Usuarios</a></li>
                    <li aria-current="page" class="breadcrumb-item active fw-semibold">Desactivar Usuario</li>
                </ol>
            </nav>
            <h1 class="display-6 fw-bold text-dark mb-1">Desactivar Usuario</h1>
            <p class="text-muted mb-0">Revise la información antes de desactivar el usuario.</p>
        </div>
    </div>
    <!-- Two-Column Layout -->
    <div class="row g-4">
        <!-- Main Info Column -->
        <div class="col-lg-8">
            <div class="form-container border p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <h2 class="h5 fw-bold mb-0">Información del Usuario</h2>
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-v-outline">Volver</a>
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <input asp-for="Id" type="hidden" />
                            <button type="submit" class="btn btn-danger">Desactivar</button>
                        </form>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="info-label">Nombre Completo</div>
                        <div class="info-value">@Model.Nombre @Model.Apellido</div>
                        <div class="info-label">Correo Electrónico</div>
                        <div class="info-value">@Model.Email</div>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="info-label">Empresa Asociada</div>
                            <div class="info-value">@Model.Empresa</div>
                        }
                    </div>
                    <div class="col-md-6">
                        <div class="info-label">Rol del Sistema</div>
                        <div class="info-value">@Model.Rol</div>
                        <div class="info-label">Estado de Cuenta</div>
                        <div class="info-value">
                            @if (Model.Estado)
                            {
                                <span class="status-badge status-active">Activo</span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">Inactivo</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="card mt-4 border-0 bg-info bg-opacity-10 shadow-none">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center mb-1">
                            <span class="material-symbols-outlined text-primary me-2 fs-5">info</span>
                            <span class="fw-bold small text-primary">Aviso de Seguridad</span>
                        </div>
                        <p class="small mb-0 text-primary-emphasis">
                            Información

                            Los permisos de este usuario están definidos por el rol asignado.

                            Para modificarlos utilice la opción Editar.
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <!-- Help Guide Column -->
        <div class="col-lg-4">
            <div class="form-container border p-4 p-md-5 h-100 d-flex flex-column">
                <h2 class="h5 fw-bold mb-4 border-bottom pb-3">Guía de Ayuda</h2>
                <div class="help-guide-item d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-primary-veltika fs-4 mt-1">manage_accounts</span>
                    <div>
                        <h3 class="h6 fw-bold mb-1">Gestión de Perfiles</h3>
                        <p class="small text-muted mb-0">Los administradores regionales supervisan operaciones dentro de su zona asignada. Verifique el email antes de otorgar permisos de auditoría.</p>
                    </div>
                </div>
                <div class="help-guide-item d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-primary-veltika fs-4 mt-1">help_outline</span>
                    <div>
                        <h3 class="h6 fw-bold mb-1">¿Cambiar el rol?</h3>
                        <p class="small text-muted mb-0">Haga clic en "Editar Perfil" para modificar los permisos y el nivel de acceso del usuario en el sistema.</p>
                    </div>
                </div>
                <div class="help-guide-item d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-primary-veltika fs-4 mt-1">history</span>
                    <div>
                        <h3 class="h6 fw-bold mb-1">Registro de Actividad</h3>
                        <p class="small text-muted mb-0">Puede consultar todas las acciones realizadas por este usuario desde el módulo de logs de seguridad.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
