@model saas.ViewModel.Autenticacion.CambiarPasswordVM

@{
    ViewData["Title"] = "Cambiar contraseña";
}

<main class="container-fluid px-4 mb-5">
    <div class="row align-items-end mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb"
                 class="mb-2">

                <ol class="breadcrumb small">
                    <li class="breadcrumb-item">
                        <a class="text-decoration-none text-muted"
                           asp-action="Index">
                            Usuarios
                        </a>
                    </li>

                    <li class="breadcrumb-item active fw-semibold"
                        aria-current="page">
                        Cambiar contraseña
                    </li>
                </ol>
            </nav>

            <h1 class="display-6 fw-bold text-dark mb-1">
                Cambiar contraseña
            </h1>

            <p class="text-muted mb-0">
                Actualizá la contraseña de tu cuenta.
            </p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="form-container border p-4 p-md-5">
                <h2 class="h5 fw-bold mb-4 border-bottom pb-3">
                    Seguridad de la cuenta
                </h2>

                <form asp-action="CambiarPassword"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="PasswordActual"
                               class="form-label">
                            Contraseña actual
                        </label>

                        <input asp-for="PasswordActual"
                               class="form-control"
                               autocomplete="current-password" />

                        <span asp-validation-for="PasswordActual"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PasswordNueva"
                               class="form-label">
                            Nueva contraseña
                        </label>

                        <input asp-for="PasswordNueva"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="PasswordNueva"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmarPassword"
                               class="form-label">
                            Confirmar nueva contraseña
                        </label>

                        <input asp-for="ConfirmarPassword"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmarPassword"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex justify-content-end gap-3
                                pt-4 mt-4 border-top">

                        <a asp-action="Index"
                           class="btn btn-v-outline">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-v-primary">
                            Cambiar contraseña
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="form-container border p-4">
                <h2 class="h6 fw-bold mb-3">
                    Recomendaciones
                </h2>

                <p class="small text-muted mb-2">
                    La nueva contraseña debe tener al menos
                    6 caracteres.
                </p>

                <p class="small text-muted mb-0">
                    No compartas tu contraseña con otras personas.
                </p>
            </div>
        </div>
    </div>
</main>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}