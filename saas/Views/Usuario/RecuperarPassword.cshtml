@model saas.ViewModel.Autenticacion.RecuperarPasswordVM

@{
    ViewData["Title"] = "Recuperar contraseña";
}

<main class="main-content">
    <div class="bg-decorative">
    </div>

    <div class="login-card">
        <div class="text-center mb-4">
            <h1 class="h4 fw-bold mb-2">
                Recuperar contraseña
            </h1>

            <p class="text-muted small">
                Ingresá tu correo electrónico y te enviaremos
                un enlace para crear una nueva contraseña.
            </p>
        </div>

        @if (ViewData["SolicitudEnviada"] is true)
        {
            <div class="alert alert-success"
                 role="alert">
                Si existe una cuenta activa asociada a ese correo,
                recibirás un enlace para restablecer la contraseña.
            </div>
        }
        else
        {
            <form asp-action="RecuperarPassword"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="nombre@empresa.com"
                           type="email"
                           autocomplete="email" />

                    <label asp-for="Email">
                        Correo electrónico
                    </label>

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>
                </div>

                <button class="btn btn-primary-custom w-100 mb-3"
                        type="submit">
                    Enviar enlace
                </button>
            </form>
        }

        <div class="text-center">
            <a class="small text-decoration-none"
               asp-action="Login">
                Volver a iniciar sesión
            </a>
        </div>
    </div>
</main>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}