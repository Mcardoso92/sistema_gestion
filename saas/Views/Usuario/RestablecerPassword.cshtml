@model saas.ViewModel.Autenticacion.RestablecerPasswordVM

@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = "_PublicLayout";
}

<main class="main-content">
    <div class="bg-decorative">
    </div>

    <div class="login-card">
        <div class="text-center mb-4">
            <h1 class="page-title mb-2">
                Nueva contraseña
            </h1>

            <p class="page-subtitle small">
                Elegí una nueva contraseña para tu cuenta.
            </p>
        </div>

        <form asp-action="RestablecerPassword"
              method="post">

            <input asp-for="Email"
                   type="hidden" />

            <input asp-for="Token"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Password"
                       class="form-control"
                       placeholder="Nueva contraseña"
                       autocomplete="new-password" />

                <label asp-for="Password">
                    Nueva contraseña
                </label>

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="ConfirmarPassword"
                       class="form-control"
                       placeholder="Confirmar contraseña"
                       autocomplete="new-password" />

                <label asp-for="ConfirmarPassword">
                    Confirmar contraseña
                </label>

                <span asp-validation-for="ConfirmarPassword"
                      class="text-danger">
                </span>
            </div>

            <button class="btn btn-primary-custom w-100 mb-3"
                    type="submit">
                Guardar contraseña
            </button>
        </form>

        <div class="text-center">
            <a class="small text-decoration-none"
               asp-action="Login">
                Volver a iniciar sesión
            </a>
        </div>
    </div>
</main>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}