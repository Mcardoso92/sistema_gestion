@model ProveedorCreateVM

@{
    ViewData["Title"] = "Crear Proveedor";
}

<main class="container-fluid px-4">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Proveedores</a></li>
                <li class="breadcrumb-item active" aria-current="page">Alta</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0 fw-bold">Alta de Proveedor</h1>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            @if (User.IsInRole("SuperAdmin"))
            {
                <div class="alert alert-warning mb-4">
                    Está creando un proveedor como SuperAdministrador.
                    El proveedor será asociado a la empresa seleccionada. Verifique esta información antes de guardar.
                </div>
            }

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                <div class="mb-5">
                    <h2 class="proveedor-section-title">
                        <span class="material-symbols-outlined fs-5">domain</span>
                        Información General
                    </h2>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="RazonSocial" class="form-label">Razón Social <span class="text-danger">*</span></label>
                            <input asp-for="RazonSocial" class="form-control" type="text" autocomplete="off" placeholder="Ingrese la razón social" />
                            <span asp-validation-for="RazonSocial" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NombreFantasia" class="form-label">Nombre de Fantasía</label>
                            <input asp-for="NombreFantasia" class="form-control" type="text" autocomplete="off" placeholder="Ingrese el nombre de fantasía" />
                            <span asp-validation-for="NombreFantasia" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CUIT" class="form-label">CUIT</label>
                            <input asp-for="CUIT" class="form-control" type="text" autocomplete="off" placeholder="30-12345678-9" />
                            <span asp-validation-for="CUIT" class="text-danger"></span>
                        </div>

                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="col-md-6">
                                <label asp-for="EmpresaId" class="form-label">Empresa <span class="text-danger">*</span></label>
                                <select asp-for="EmpresaId" asp-items="Model.Empresas" class="form-select">
                                    <option value="">-- Seleccione una empresa --</option>
                                </select>
                                <span asp-validation-for="EmpresaId" class="text-danger"></span>
                            </div>
                        }
                    </div>
                </div>

                <div class="mb-5">
                    <h2 class="proveedor-section-title">
                        <span class="material-symbols-outlined fs-5">contact_mail</span>
                        Datos de Contacto
                    </h2>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" type="email" autocomplete="off" placeholder="proveedor@ejemplo.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label">Teléfono</label>
                            <input asp-for="Telefono" class="form-control" type="tel" autocomplete="off" placeholder="Ingrese un teléfono" />
                            <span asp-validation-for="Telefono" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-5">
                    <h2 class="proveedor-section-title">
                        <span class="material-symbols-outlined fs-5">location_on</span>
                        Ubicación
                    </h2>

                    <div class="row g-4">
                        <div class="col-md-12">
                            <label asp-for="Direccion" class="form-label">Dirección</label>
                            <input asp-for="Direccion" class="form-control" type="text" autocomplete="off" placeholder="Ingrese la dirección" />
                            <span asp-validation-for="Direccion" class="text-danger"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="Localidad" class="form-label">Localidad</label>
                            <input asp-for="Localidad" class="form-control" type="text" autocomplete="off" placeholder="Ingrese la localidad" />
                            <span asp-validation-for="Localidad" class="text-danger"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="Provincia" class="form-label">Provincia</label>
                            <input asp-for="Provincia" class="form-control" type="text" autocomplete="off" placeholder="Ingrese la provincia" />
                            <span asp-validation-for="Provincia" class="text-danger"></span>
                        </div>

                        <div class="col-md-2">
                            <label asp-for="CodigoPostal" class="form-label">Código Postal</label>
                            <input asp-for="CodigoPostal" class="form-control" type="text" autocomplete="off" placeholder="CP" />
                            <span asp-validation-for="CodigoPostal" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div>
                    <h2 class="proveedor-section-title">
                        <span class="material-symbols-outlined fs-5">notes</span>
                        Observaciones
                    </h2>

                    <div>
                        <label asp-for="Observaciones" class="form-label">Observaciones</label>
                        <textarea asp-for="Observaciones" class="form-control" rows="4" placeholder="Ingrese información adicional sobre el proveedor..."></textarea>
                        <span asp-validation-for="Observaciones" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-5 pt-4 border-top">
                    <a asp-action="Index" class="btn btn-v-outline">Cancelar</a>
                    <button type="submit" class="btn btn-v-primary d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined fs-6">save</span>
                        Guardar Proveedor
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}