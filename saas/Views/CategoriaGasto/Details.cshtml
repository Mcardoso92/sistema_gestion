@model saas.ViewModel.CategoriaGastoDetailsVM
@{ ViewData["Title"] = "Detalle de Categoría de Gasto"; }
<main class="container-fluid px-4 py-4">
    <div class="page-header">
        <div class="page-header-content"><div class="d-flex align-items-center gap-2 mb-1"><h1 class="page-title mb-0">@Model.Nombre</h1><span class="status-badge @(Model.Estado ? "status-active" : "status-inactive")">@(Model.Estado ? "Activa" : "Inactiva")</span></div><p class="page-subtitle">Información de la categoría de gasto.</p></div>
        <div class="page-actions"><a asp-action="Index" class="btn btn-v-outline">Volver</a><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-v-primary">Editar</a></div>
    </div>
    <div class="row g-4 align-items-start">
        <div class="col-lg-8"><div class="detail-card p-4">
            <div class="row g-4">
                <div class="col-md-6"><div class="detail-label">Nombre</div><div class="detail-value">@Model.Nombre</div></div>
                <div class="col-md-6"><div class="detail-label">Empresa</div><div class="detail-value">@Model.EmpresaNombre</div></div>
                <div class="col-md-6"><div class="detail-label">Fecha de alta</div><div class="detail-value">@FechaHora.ConvertirAHoraLocal(Model.FechaAlta).ToString("dd/MM/yyyy")</div></div>
                <div class="col-12"><div class="detail-label">Descripción</div><div class="detail-value">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción" : Model.Descripcion)</div></div>
            </div>
        </div></div>
        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">receipt_long</span>
                    <div><h3 class="help-guide-item__title">Clasificación de gastos</h3><p class="help-guide-item__text">Utilizá nombres claros para agrupar egresos del mismo tipo en Caja y reportes.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">description</span>
                    <div><h3 class="help-guide-item__title">Descripción</h3><p class="help-guide-item__text">Podés agregar una aclaración para indicar cuándo corresponde utilizar esta categoría.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">history</span>
                    <div><h3 class="help-guide-item__title">Movimientos históricos</h3><p class="help-guide-item__text">Al desactivarla deja de estar disponible para nuevos egresos, pero los movimientos anteriores se conservan.</p></div>
                </div>
            </div>
        </div>
    </div>
</main>
