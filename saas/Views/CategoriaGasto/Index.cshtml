@model IEnumerable<saas.ViewModel.CategoriaGastoIndexVM>

@{
    ViewData["Title"] = "Categorías de Gasto";

    string estadoActual =
        ViewBag.Estado as string ?? "activos";

    string? busquedaActual =
        ViewBag.Busqueda as string;

    int? empresaIdActual =
        ViewBag.EmpresaId as int?;
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Categorías de Gasto
            </h1>

            <p class="text-muted mb-0">
                Administrá las categorías utilizadas para clasificar egresos y gastos.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            Nueva Categoría
        </a>

    </div>

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <form method="get"
                  asp-action="Index">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-5 col-md-6">

                        <label class="form-label fw-semibold">
                            Buscar
                        </label>

                        <input type="text"
                               name="busqueda"
                               value="@busquedaActual"
                               class="form-control"
                               placeholder="Buscar por nombre o descripción..." />

                    </div>

                    <div class="col-lg-2 col-md-6">

                        <label class="form-label fw-semibold">
                            Estado
                        </label>

                        <select name="estado"
                                class="form-select">

                            <option value="activos"
                                    selected="@(estadoActual == "activos")">
                                Activos
                            </option>

                            <option value="inactivos"
                                    selected="@(estadoActual == "inactivos")">
                                Inactivos
                            </option>

                            <option value="todos"
                                    selected="@(estadoActual == "todos")">
                                Todos
                            </option>

                        </select>

                    </div>

                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label fw-semibold">
                                Empresa
                            </label>

                            <select name="empresaId"
                                    class="form-select">

                                <option value="">
                                    Todas
                                </option>

                                @if (ViewBag.Empresas != null)
                                {
                                    foreach (var empresa in ViewBag.Empresas)
                                    {
                                        <option value="@empresa.Id"
                                                selected="@(empresaIdActual == empresa.Id)">
                                            @empresa.Nombre
                                        </option>
                                    }
                                }

                            </select>

                        </div>
                    }

                    <div class="col-lg-2 col-md-6">

                        <button type="submit"
                                class="btn btn-outline-primary w-100">
                            Filtrar
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Nombre
                                </th>

                                <th>
                                    Descripción
                                </th>

                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <th>
                                        Empresa
                                    </th>
                                }

                                <th>
                                    Fecha de alta
                                </th>

                                <th class="text-center">
                                    Estado
                                </th>

                                <th class="text-end pe-4">
                                    Acciones
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var categoria in Model)
                            {
                                <tr>

                                    <td class="ps-4 fw-semibold">
                                        @categoria.Nombre
                                    </td>

                                    <td>

                                        @if (string.IsNullOrWhiteSpace(categoria.Descripcion))
                                        {
                                            <span class="text-muted">
                                                Sin descripción
                                            </span>
                                        }
                                        else
                                        {
                                            @categoria.Descripcion
                                        }

                                    </td>

                                    @if (User.IsInRole("SuperAdmin"))
                                    {
                                        <td>
                                            @categoria.EmpresaNombre
                                        </td>
                                    }

                                    <td>
                                        @categoria.FechaAlta.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="text-center">

                                        @if (categoria.Estado)
                                        {
                                            <span class="status-badge status-active">
                                                Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive">
                                                Inactiva
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end pe-4">

                                        <div class="table-actions">

                                            <a asp-action="Details"
                                               asp-route-id="@categoria.Id"
                                               class="btn btn-sm btn-light table-action-btn"
                                               title="Ver detalle"
                                               aria-label="Ver detalle">
                                                <span class="material-symbols-outlined">visibility</span>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@categoria.Id"
                                               class="btn btn-sm btn-light table-action-btn"
                                               title="Editar"
                                               aria-label="Editar">
                                                <span class="material-symbols-outlined">edit</span>
                                            </a>

                                            @if (categoria.Estado)
                                            {
                                                <a asp-action="Delete"
                                                   asp-route-id="@categoria.Id"
                                                   class="btn btn-sm btn-light table-action-btn table-action-danger"
                                                   title="Desactivar"
                                                   aria-label="Desactivar">
                                                    <span class="material-symbols-outlined">block</span>
                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center p-5">

                    <h5 class="fw-bold mb-2">
                        No hay categorías de gasto para mostrar
                    </h5>

                    <p class="text-muted mb-3">
                        No se encontraron registros con los filtros seleccionados.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Crear Categoría
                    </a>

                </div>
            }

        </div>

        <partial name="_Paginacion" model='new PaginacionVM { PaginaActual = ViewBag.PaginaActual, TotalPaginas = ViewBag.TotalPaginas, TotalRegistros = ViewBag.TotalRegistros, NombreSingular = "categoría encontrada", NombrePlural = "categorías encontradas" }' />

    </div>

</div>
