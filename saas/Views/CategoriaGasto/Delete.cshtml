@model saas.ViewModel.CategoriaGastoDetailsVM

@{
    ViewData["Title"] = "Desactivar Categoría de Gasto";
}

<div class="container-fluid px-4 py-4">

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <h1 class="h4 fw-bold mb-3">
                Desactivar Categoría de Gasto
            </h1>

            <div class="alert alert-warning">
                La categoría dejará de estar disponible para nuevos egresos.
                Los movimientos históricos conservarán su información.
            </div>

            <dl class="row mb-4">

                <dt class="col-sm-3">
                    Nombre
                </dt>

                <dd class="col-sm-9">
                    @Model.Nombre
                </dd>

                <dt class="col-sm-3">
                    Empresa
                </dt>

                <dd class="col-sm-9">
                    @Model.EmpresaNombre
                </dd>

                <dt class="col-sm-3">
                    Descripción
                </dt>

                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Descripcion)
                                        ? "Sin descripción"
                                        : Model.Descripcion)
                </dd>

            </dl>

            <form asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-danger">
                        Desactivar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>