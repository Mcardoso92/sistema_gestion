@model saas.ViewModel.CategoriaGastoDetailsVM
@{ ViewData["Title"] = "Desactivar Categoría de Gasto"; }
<main class="container-fluid px-4 py-4">
    <div class="mb-4"><h1 class="h3 fw-bold mb-1">Desactivar Categoría de Gasto</h1><p class="text-muted mb-0">Revisá la información antes de confirmar.</p></div>
    <div class="row g-4 align-items-start">
        <div class="col-lg-8"><div class="form-container p-4">
            <div class="alert alert-warning">La categoría dejará de estar disponible para nuevos egresos. Los movimientos históricos conservarán su información.</div>
            <dl class="row mb-4">
                <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@Model.Nombre</dd>
                <dt class="col-sm-3">Empresa</dt><dd class="col-sm-9">@Model.EmpresaNombre</dd>
                <dt class="col-sm-3">Descripción</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción" : Model.Descripcion)</dd>
            </dl>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="d-flex justify-content-end gap-3 pt-4 border-top"><a asp-action="Index" class="btn btn-v-outline">Cancelar</a><button type="submit" class="btn btn-danger">Desactivar</button></div>
            </form>
        </div></div>
        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">receipt_long</span>
                    <div><h3 class="help-guide-item__title">Clasificación de gastos</h3><p class="help-guide-item__text">Utilizá nombres claros para agrupar egresos del mismo tipo en Caja y reportes.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">description</span>
                    <div><h3 class="help-guide-item__title">Descripción</h3><p class="help-guide-item__text">Podés agregar una aclaración para indicar cuándo corresponde utilizar esta categoría.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">history</span>
                    <div><h3 class="help-guide-item__title">Movimientos históricos</h3><p class="help-guide-item__text">Al desactivarla deja de estar disponible para nuevos egresos, pero los movimientos anteriores se conservan.</p></div>
                </div>
            </div>
        </div>
    </div>
</main>
