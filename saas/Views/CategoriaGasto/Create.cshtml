@model saas.ViewModel.CategoriaGastoCreateVM

@{
    ViewData["Title"] = "Nueva Categoría de Gasto";
}

<main class="container-fluid px-4 py-4">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Nueva Categoría de Gasto</h1>
        <p class="text-muted mb-0">Creá una categoría para clasificar egresos y gastos.</p>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <div class="form-container p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="col-md-6">
                                <label asp-for="EmpresaId" class="form-label">Empresa</label>
                                <select asp-for="EmpresaId" asp-items="ViewBag.EmpresaId" class="form-select">
                                    <option value="">Seleccionar empresa</option>
                                </select>
                                <span asp-validation-for="EmpresaId" class="text-danger"></span>
                            </div>
                        }

                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label">Nombre</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Servicios, Alquiler, Impuestos..." />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción opcional de la categoría"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 pt-4 mt-4 border-top">
                        <a asp-action="Index" class="btn btn-v-outline">Cancelar</a>
                        <button type="submit" class="btn btn-v-primary">Crear Categoría</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">receipt_long</span>
                    <div>
                        <h3 class="help-guide-item__title">Clasificación de gastos</h3>
                        <p class="help-guide-item__text">Elegí un nombre fácil de reconocer para agrupar egresos del mismo tipo en Caja y reportes.</p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">description</span>
                    <div>
                        <h3 class="help-guide-item__title">Descripción</h3>
                        <p class="help-guide-item__text">Podés agregar una aclaración opcional para indicar cuándo corresponde utilizar esta categoría.</p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">corporate_fare</span>
                    <div>
                        <h3 class="help-guide-item__title">Empresa</h3>
                        <p class="help-guide-item__text">La categoría quedará disponible únicamente para los movimientos de la empresa seleccionada.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
