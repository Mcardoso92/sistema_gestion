@model saas.ViewModel.MovimientoCajaDetailsVM

@{
    ViewData["Title"] = "Detalle de Movimiento";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>

            <div class="d-flex align-items-center gap-2">

                <h1 class="h3 fw-bold mb-0">
                    Movimiento #@Model.Id
                </h1>

                @if (Model.EsReversion)
                {
                    <span class="badge bg-warning text-dark">
                        Reversión
                    </span>
                }

                @if (Model.FueRevertido)
                {
                    <span class="badge bg-secondary">
                        Revertido
                    </span>
                }

            </div>

            <p class="text-muted mb-0 mt-1">
                @Model.Tipo
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Volver
        </a>
        @if (!Model.EsReversion &&
                !Model.FueRevertido &&
                (Model.Tipo == saas.Models.Enums.TipoMovimientoCaja.IngresoManual ||
                Model.Tipo == saas.Models.Enums.TipoMovimientoCaja.EgresoManual))
        {
            <a asp-action="Revertir"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Revertir
            </a>
        }

    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        Información del movimiento
                    </h5>

                    <div class="row g-4">

                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="col-md-6">
                                <div class="text-muted small">
                                    Empresa
                                </div>
                                <div class="fw-semibold">
                                    @Model.EmpresaNombre
                                </div>
                            </div>
                        }

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Caja
                            </div>
                            <div class="fw-semibold">
                                @Model.CajaNombre
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Fecha
                            </div>
                            <div>
                                @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Usuario
                            </div>
                            <div>
                                @Model.UsuarioNombre
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Medio de pago
                            </div>
                            <div>
                                @(Model.MedioPagoNombre ?? "-")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Categoría de gasto
                            </div>
                            <div>
                                @(Model.CategoriaGastoNombre ?? "-")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Turno
                            </div>

                            @if (Model.TurnoCajaId.HasValue)
                            {
                                <a asp-controller="TurnoCaja"
                                   asp-action="Details"
                                   asp-route-id="@Model.TurnoCajaId">
                                    Turno #@Model.TurnoCajaId
                                </a>
                            }
                            else
                            {
                                <div>-</div>
                            }

                        </div>

                        <div class="col-12">
                            <div class="text-muted small">
                                Concepto
                            </div>
                            <div>
                                @(Model.Concepto ?? "-")
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="text-muted small">
                                Observaciones
                            </div>
                            <div>
                                @(Model.Observaciones ?? "-")
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="text-muted small">
                        @Model.Direccion
                    </div>

                    @if (Model.Direccion ==
                                        saas.Models.Enums.DireccionMovimientoCaja.Ingreso)
                    {
                        <div class="display-6 fw-bold text-success">
                            + @Model.Importe.ToString("C")
                        </div>
                    }
                    else
                    {
                        <div class="display-6 fw-bold text-danger">
                            - @Model.Importe.ToString("C")
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

    @if (Model.EsReversion &&
        Model.MovimientoOrigenId.HasValue)
    {
        <div class="alert alert-warning mt-4">

            Este movimiento revierte al movimiento

            <a asp-action="Details"
               asp-route-id="@Model.MovimientoOrigenId"
               class="fw-semibold">
                #@Model.MovimientoOrigenId
            </a>.

        </div>
    }

    @if (Model.Reversiones.Any())
    {
        <div class="card border-0 shadow-sm mt-4">

            <div class="card-body p-4">

                <h5 class="fw-bold mb-3">
                    Reversiones
                </h5>

                @foreach (var reversion in Model.Reversiones)
                {
                    <div class="d-flex justify-content-between align-items-center border rounded p-3 mb-2">

                        <div>
                            <div class="fw-semibold">
                                Movimiento #@reversion.Id
                            </div>

                            <div class="text-muted small">
                                @reversion.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3">

                            <span class="fw-semibold">
                                @reversion.Importe.ToString("C")
                            </span>

                            <a asp-action="Details"
                               asp-route-id="@reversion.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Ver
                            </a>

                        </div>

                    </div>
                }

            </div>

        </div>
    }

</div>