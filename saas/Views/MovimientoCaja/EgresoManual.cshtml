@model saas.ViewModel.EgresoManualVM

@{
    ViewData["Title"] = "Egreso Manual";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Egreso Manual
            </h1>

            <p class="text-muted mb-0">
                Registrá una salida de dinero y clasificá el gasto.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Volver
        </a>

    </div>

    <form asp-action="EgresoManual"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4">

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="CajaId"
                               class="form-label fw-semibold">
                            Caja
                        </label>

                        <select asp-for="CajaId"
                                class="form-select"
                                id="cajaSelect">

                            <option value="">
                                Seleccionar caja
                            </option>

                            @foreach (var caja in Model.CajasDisponibles)
                            {
                                <option value="@caja.Id">
                                    @caja.Nombre
                                </option>
                            }

                        </select>

                        <span asp-validation-for="CajaId"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="MedioPagoId"
                               class="form-label fw-semibold">
                            Medio de pago
                        </label>

                        <select asp-for="MedioPagoId"
                                class="form-select"
                                id="medioPagoSelect">

                            <option value="">
                                Primero seleccioná una caja
                            </option>

                        </select>

                        <span asp-validation-for="MedioPagoId"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="CategoriaGastoId"
                               class="form-label fw-semibold">
                            Categoría de gasto
                        </label>

                        <select asp-for="CategoriaGastoId"
                                class="form-select">

                            <option value="">
                                Seleccionar categoría
                            </option>

                            @foreach (var categoria in Model.CategoriasDisponibles)
                            {
                                <option value="@categoria.Id">
                                    @categoria.Nombre
                                </option>
                            }

                        </select>

                        <span asp-validation-for="CategoriaGastoId"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Importe"
                               class="form-label fw-semibold">
                            Importe
                        </label>

                        <input asp-for="Importe"
                               class="form-control"
                               type="number"
                               min="0.01"
                               step="0.01" />

                        <span asp-validation-for="Importe"
                              class="text-danger"></span>

                    </div>

                    <div class="col-12">

                        <div class="border rounded p-3 bg-light">

                            <div class="text-muted small">
                                Saldo disponible
                            </div>

                            <div class="fs-4 fw-bold"
                                 id="saldoDisponible">
                                -
                            </div>

                        </div>

                    </div>

                    <div class="col-12">

                        <label asp-for="Concepto"
                               class="form-label fw-semibold">
                            Concepto
                        </label>

                        <input asp-for="Concepto"
                               class="form-control"
                               maxlength="250"
                               placeholder="Ej: Compra de insumos" />

                        <span asp-validation-for="Concepto"
                              class="text-danger"></span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Observaciones"
                               class="form-label fw-semibold">
                            Observaciones
                        </label>

                        <textarea asp-for="Observaciones"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"></textarea>

                        <span asp-validation-for="Observaciones"
                              class="text-danger"></span>

                    </div>

                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn btn-danger">
                Registrar egreso
            </button>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const cajaSelect =
                document.getElementById("cajaSelect");

            const medioPagoSelect =
                document.getElementById("medioPagoSelect");

            const saldoVisual =
                document.getElementById("saldoDisponible");

            const medioSeleccionado =
                "@Model.MedioPagoId";

            const formatoMoneda =
                new Intl.NumberFormat(
                    "es-AR",
                    {
                        style: "currency",
                        currency: "ARS"
                    });

            async function cargarMediosPago() {

                const cajaId =
                    cajaSelect.value;

                medioPagoSelect.innerHTML = "";

                if (!cajaId) {

                    medioPagoSelect.innerHTML =
                        '<option value="">Primero seleccioná una caja</option>';

                    return;
                }

                try {

                    const url =
                        '@Url.Action("GetMediosPagoPorCaja", "MovimientoCaja")'
                        + '?cajaId='
                        + encodeURIComponent(cajaId);

                    const response =
                        await fetch(url);

                    if (!response.ok) {
                        throw new Error();
                    }

                    const medios =
                        await response.json();

                    medioPagoSelect.innerHTML =
                        '<option value="">Seleccionar medio de pago</option>';

                    medios.forEach(medio => {

                        const option =
                            document.createElement("option");

                        option.value =
                            medio.id;

                        option.textContent =
                            medio.nombre;

                        if (String(medio.id) ===
                            medioSeleccionado) {

                            option.selected = true;
                        }

                        medioPagoSelect.appendChild(option);
                    });
                }
                catch {

                    medioPagoSelect.innerHTML =
                        '<option value="">No se pudieron cargar los medios</option>';
                }
            }

            async function cargarSaldo() {

                const cajaId =
                    cajaSelect.value;

                if (!cajaId) {
                    saldoVisual.textContent = "-";
                    return;
                }

                try {

                    const url =
                        '@Url.Action("GetSaldoCaja", "MovimientoCaja")'
                        + '?cajaId='
                        + encodeURIComponent(cajaId);

                    const response =
                        await fetch(url);

                    if (!response.ok) {
                        throw new Error();
                    }

                    const data =
                        await response.json();

                    saldoVisual.textContent =
                        formatoMoneda.format(data.saldo);
                }
                catch {

                    saldoVisual.textContent =
                        "No disponible";
                }
            }

            cajaSelect.addEventListener(
                "change",
                function () {

                    cargarMediosPago();
                    cargarSaldo();
                });

            cargarMediosPago();
            cargarSaldo();
        });
    </script>
}