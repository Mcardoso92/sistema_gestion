@model saas.ViewModel.MovimientoCajaIndexVM

@{
    ViewData["Title"] = "Movimientos de Caja";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Movimientos de Caja
            </h1>

            <p class="text-muted mb-0">
                Historial financiero de ingresos y egresos.
            </p>
        </div>

        @if (!User.IsInRole("SuperAdmin"))
        {
            <div class="d-flex gap-2">

                <a asp-action="IngresoManual"
                   class="btn btn-success">
                    Nuevo ingreso
                </a>

                <a asp-action="EgresoManual"
                   class="btn btn-danger">
                    Nuevo egreso
                </a>

            </div>
        }

    </div>

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <span asp-validation-for="FechaHasta" class="filter-validation-message text-danger small"></span>

            <form asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <div class="col-lg-3 col-md-6">

                        <label asp-for="CajaId"
                               class="form-label fw-semibold">
                            Caja
                        </label>

                        <select asp-for="CajaId"
                                class="form-select">

                            <option value="">
                                Todas
                            </option>

                            @foreach (var caja in Model.CajasDisponibles)
                            {
                                <option value="@caja.Id">
                                    @caja.Nombre
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-lg-3 col-md-6">

                        <label asp-for="MedioPagoId"
                               class="form-label fw-semibold">
                            Medio de pago
                        </label>

                        <select asp-for="MedioPagoId"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                            @foreach (var medio in Model.MediosPagoDisponibles)
                            {
                                <option value="@medio.Id">
                                    @medio.Nombre
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-lg-3 col-md-6">

                        <label asp-for="CategoriaGastoId"
                               class="form-label fw-semibold">
                            Categoría de gasto
                        </label>

                        <select asp-for="CategoriaGastoId"
                                class="form-select">

                            <option value="">
                                Todas
                            </option>

                            @foreach (var categoria in Model.CategoriasDisponibles)
                            {
                                <option value="@categoria.Id">
                                    @categoria.Nombre
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-lg-3 col-md-6">

                        <label asp-for="UsuarioId"
                               class="form-label fw-semibold">
                            Usuario
                        </label>

                        <select asp-for="UsuarioId"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                            @foreach (var usuario in Model.UsuariosDisponibles)
                            {
                                <option value="@usuario.Id">
                                    @usuario.Nombre
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-lg-3 col-md-6">

                        <label asp-for="Tipo"
                               class="form-label fw-semibold">
                            Tipo
                        </label>

                        <select asp-for="Tipo"
                                asp-items="Html.GetEnumSelectList<saas.Models.Enums.TipoMovimientoCaja>()"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                        </select>

                    </div>

                    <div class="col-lg-3 col-md-6">

                        <label asp-for="Direccion"
                               class="form-label fw-semibold">
                            Dirección
                        </label>

                        <select asp-for="Direccion"
                                asp-items="Html.GetEnumSelectList<saas.Models.Enums.DireccionMovimientoCaja>()"
                                class="form-select">

                            <option value="">
                                Todas
                            </option>

                        </select>

                    </div>

                    <div class="col-lg-3 col-md-6">

                        <label asp-for="FechaDesde"
                               class="form-label fw-semibold">
                            Desde
                        </label>

                        <input asp-for="FechaDesde"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-lg-3 col-md-6">

                        <label asp-for="FechaHasta"
                               class="form-label fw-semibold">
                            Hasta
                        </label>

                        <input asp-for="FechaHasta"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-12 d-flex justify-content-end gap-2">

                        @if (Model.CajaId.HasValue
                            || Model.MedioPagoId.HasValue
                            || Model.CategoriaGastoId.HasValue
                            || Model.TurnoCajaId.HasValue
                            || !string.IsNullOrWhiteSpace(Model.UsuarioId)
                            || Model.Tipo.HasValue
                            || Model.Direccion.HasValue
                            || Model.FechaDesde.HasValue
                            || Model.FechaHasta.HasValue
                            || Model.EmpresaId.HasValue)
                        {
                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Limpiar
                            </a>
                        }

                        <button type="submit"
                                class="btn btn-outline-primary">
                            Filtrar
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">
                        Ingresos Netos
                    </div>
                    <div class="fs-4 fw-bold text-success">
                        @Model.TotalIngresos.ToString("C")
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">
                        Egresos Netos
                    </div>
                    <div class="fs-4 fw-bold text-danger">
                        @Model.TotalEgresos.ToString("C")
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">
                        Neto
                    </div>
                    <div class="fs-4 fw-bold">
                        @Model.NetoPeriodo.ToString("C")
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            @if (Model.Movimientos.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th class="ps-4">Fecha</th>
                                <th>Caja</th>
                                <th>Tipo</th>
                                <th>Medio</th>
                                <th>Concepto</th>
                                <th>Usuario</th>
                                <th class="text-end">Importe</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var movimiento in Model.Movimientos)
                            {
                                <tr>

                                    <td class="ps-4">
                                        @movimiento.Fecha.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @movimiento.CajaNombre
                                    </td>

                                    <td>
                                        @TextoPresentacion.ValorEnum(movimiento.Tipo)

                                        @if (movimiento.EsReversion)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">
                                                Reversión
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @(movimiento.MedioPagoNombre ?? "-")
                                    </td>

                                    <td>
                                        @(movimiento.Concepto ?? "-")
                                    </td>

                                    <td>
                                        @movimiento.UsuarioNombre
                                    </td>

                                    <td class="text-end">

                                        @if (movimiento.Direccion ==
                                                                        saas.Models.Enums.DireccionMovimientoCaja.Ingreso)
                                        {
                                            <span class="fw-bold text-success">
                                                + @movimiento.Importe.ToString("C")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-danger">
                                                - @movimiento.Importe.ToString("C")
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="table-actions">
                                        <a asp-action="Details"
                                           asp-route-id="@movimiento.Id"
                                           class="btn btn-sm btn-light table-action-btn"
                                           title="Ver detalle"
                                           aria-label="Ver detalle">
                                            <span class="material-symbols-outlined">visibility</span>
                                        </a>
                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center p-5">

                    <h5 class="fw-bold mb-2">
                        No hay movimientos
                    </h5>

                    <p class="text-muted mb-0">
                        No se encontraron movimientos con los filtros seleccionados.
                    </p>

                </div>
            }

        </div>

        <partial name="_Paginacion" model='new PaginacionVM { PaginaActual = ViewBag.PaginaActual, TotalPaginas = ViewBag.TotalPaginas, TotalRegistros = ViewBag.TotalRegistros, NombreSingular = "movimiento encontrado", NombrePlural = "movimientos encontrados" }' />

    </div>

</div>
