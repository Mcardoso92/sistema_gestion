@using saas.Models.Enums
@{
    ViewData["Title"] = "Revertir Movimiento";

    var movimiento =
        ViewBag.Movimiento as saas.Models.MovimientoCaja;
    string urlVolver = ViewData["ReturnUrl"] as string ?? Url.Action("Index")!;
}

<div class="container-fluid px-4 py-4">

    <div class="page-header">

        <div class="page-header-content">
            <h1 class="page-title">
                Revertir Movimiento
            </h1>

            <p class="page-subtitle">
                Se generará un movimiento compensatorio.
            </p>
        </div>

    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (movimiento != null)
    {
        <div class="row g-4 align-items-start">
            <div class="col-lg-8">
                <div class="card detail-card mb-4">

            <div class="card-body p-4">

                <h5 class="fw-bold mb-4">
                    Movimiento original
                </h5>

                <div class="row g-4">

                    <div class="col-md-4">
                        <div class="text-muted small">
                            Caja
                        </div>

                        <div class="fw-semibold">
                            @movimiento.Caja.Nombre
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">
                            Tipo
                        </div>

                        <div>
                            @TextoPresentacion.ValorEnum(movimiento.Tipo)
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">
                            Importe
                        </div>

                        <div class="fw-bold">
                            @movimiento.Importe.ToString("C")
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="text-muted small">
                            Concepto
                        </div>

                        <div>
                            @(movimiento.Concepto ?? "-")
                        </div>
                    </div>

                </div>

            </div>

                </div>

                <div class="alert alert-warning">
                    Esta acción no elimina ni modifica el movimiento original.
                    Se creará un nuevo movimiento por el mismo importe y con dirección contraria.
                </div>

                <form asp-action="Revertir"
                      asp-route-id="@movimiento.Id"
                      method="post">

            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@urlVolver" />

            <div class="card form-card">

                <div class="card-body p-4">

                    <label for="motivo"
                           class="form-label fw-semibold">
                        Motivo de la reversión
                    </label>

                    <textarea name="motivo"
                          id="motivo"
                          class="form-control"
                          rows="3"
                          maxlength="500"
                          required></textarea>

                    <div class="form-text">
                        Indicá por qué se está corrigiendo este movimiento.
                    </div>

                </div>

            </div>

            <div class="form-actions mt-4">

                <a asp-action="Details"
                   asp-route-id="@movimiento.Id"
                   asp-route-returnUrl="@urlVolver"
                   class="btn btn-v-outline">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-warning">
                    Confirmar reversión
                </button>

            </div>

                </form>
            </div>

            <div class="col-lg-4">
                <div class="help-guide-panel">
                    <h2 class="help-guide-title">Guía de Ayuda</h2>
                    <div class="help-guide-item">
                        <span class="material-symbols-outlined help-guide-item__icon">undo</span>
                        <div><h3 class="help-guide-item__title">Movimiento compensatorio</h3><p class="help-guide-item__text">Se genera un nuevo movimiento por el mismo importe y en dirección contraria.</p></div>
                    </div>
                    <div class="help-guide-item">
                        <span class="material-symbols-outlined help-guide-item__icon">history</span>
                        <div><h3 class="help-guide-item__title">Original conservado</h3><p class="help-guide-item__text">El movimiento original no se modifica ni se elimina del historial.</p></div>
                    </div>
                    <div class="help-guide-item">
                        <span class="material-symbols-outlined help-guide-item__icon">edit_note</span>
                        <div><h3 class="help-guide-item__title">Motivo obligatorio</h3><p class="help-guide-item__text">Explicá la corrección para que pueda identificarse posteriormente.</p></div>
                    </div>
                </div>
            </div>
        </div>
    }

</div>
