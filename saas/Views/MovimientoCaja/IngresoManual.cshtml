@model saas.ViewModel.IngresoManualVM

@{
    ViewData["Title"] = "Ingreso Manual";
}

<div class="container-fluid px-4 py-4">

    <div class="page-header">

        <div class="page-header-content">
            <h1 class="page-title">
                Ingreso Manual
            </h1>

            <p class="page-subtitle">
                Registrá un ingreso de dinero a una caja.
            </p>
        </div>

    </div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <form asp-action="IngresoManual"
                  method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger form-validation-summary"></div>

        <div class="form-card">

            <div class="card-body p-4">

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="CajaId"
                               class="form-label">
                            Caja
                        </label>

                        <select asp-for="CajaId"
                                class="form-select"
                                id="cajaSelect">

                            <option value="">
                                Seleccionar caja
                            </option>

                            @foreach (var caja in Model.CajasDisponibles)
                            {
                                <option value="@caja.Id">
                                    @caja.Nombre
                                </option>
                            }

                        </select>

                        <span asp-validation-for="CajaId"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="MedioPagoId"
                               class="form-label">
                            Medio de pago
                        </label>

                        <select asp-for="MedioPagoId"
                                class="form-select"
                                id="medioPagoSelect">

                            <option value="">
                                Primero seleccioná una caja
                            </option>

                        </select>

                        <span asp-validation-for="MedioPagoId"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Importe"
                               class="form-label">
                            Importe
                        </label>

                        <input asp-for="Importe"
                               class="form-control"
                               type="number"
                               min="0.01"
                               step="0.01" />

                        <span asp-validation-for="Importe"
                              class="text-danger"></span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Concepto"
                               class="form-label">
                            Concepto
                        </label>

                        <input asp-for="Concepto"
                               class="form-control"
                               maxlength="250"
                               placeholder="Ej: Aporte de efectivo" />

                        <span asp-validation-for="Concepto"
                              class="text-danger"></span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Observaciones"
                               class="form-label">
                            Observaciones
                        </label>

                        <textarea asp-for="Observaciones"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"></textarea>

                        <span asp-validation-for="Observaciones"
                              class="text-danger"></span>

                    </div>

                </div>

            </div>

        </div>

        <div class="form-actions mt-4">

            <a asp-action="Index"
               class="btn btn-v-outline">
                Cancelar
            </a>

            <button type="submit"
                    class="btn btn-v-primary">
                Registrar ingreso
            </button>

        </div>

            </form>
        </div>

        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">add_card</span>
                    <div><h3 class="help-guide-item__title">Ingreso manual</h3><p class="help-guide-item__text">Usalo para registrar dinero que ingresa a la caja por fuera de una venta.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">account_balance_wallet</span>
                    <div><h3 class="help-guide-item__title">Caja y medio</h3><p class="help-guide-item__text">El medio de pago debe estar habilitado en la caja seleccionada.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">receipt_long</span>
                    <div><h3 class="help-guide-item__title">Concepto</h3><p class="help-guide-item__text">Indicá el origen del dinero para identificar el movimiento en el historial.</p></div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const cajaSelect =
                document.getElementById("cajaSelect");

            const medioPagoSelect =
                document.getElementById("medioPagoSelect");

            const medioSeleccionado =
                "@Model.MedioPagoId";

            async function cargarMediosPago() {

                const cajaId =
                    cajaSelect.value;

                medioPagoSelect.innerHTML = "";

                if (!cajaId) {

                    medioPagoSelect.innerHTML =
                        '<option value="">Primero seleccioná una caja</option>';

                    return;
                }

                try {

                    const url =
                        '@Url.Action("GetMediosPagoPorCaja", "MovimientoCaja")'
                        + '?cajaId='
                        + encodeURIComponent(cajaId);

                    const response =
                        await fetch(url);

                    if (!response.ok) {
                        throw new Error();
                    }

                    const medios =
                        await response.json();

                    medioPagoSelect.innerHTML =
                        '<option value="">Seleccionar medio de pago</option>';

                    medios.forEach(medio => {

                        const option =
                            document.createElement("option");

                        option.value =
                            medio.id;

                        option.textContent =
                            medio.nombre;

                        if (String(medio.id) ===
                            medioSeleccionado) {

                            option.selected = true;
                        }

                        medioPagoSelect.appendChild(option);
                    });
                }
                catch {

                    medioPagoSelect.innerHTML =
                        '<option value="">No se pudieron cargar los medios</option>';
                }
            }

            cajaSelect.addEventListener(
                "change",
                cargarMediosPago);

            cargarMediosPago();
        });
    </script>
}
