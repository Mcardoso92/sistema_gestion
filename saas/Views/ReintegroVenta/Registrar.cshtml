@model saas.ViewModel.RegistrarReintegroVentaVM

@{
    ViewData["Title"] = "Registrar Reintegro";
}

<main class="container-fluid py-4 px-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">

        <div>
            <h1 class="h2 fw-bold mb-1">
                Registrar Reintegro
            </h1>

            <p class="text-muted mb-0">
                Venta #@Model.VentaId
            </p>
        </div>

        <a asp-controller="Venta"
           asp-action="Details"
           asp-route-id="@Model.VentaId"
           class="btn btn-outline-secondary">
            Volver
        </a>

    </div>

    <form asp-action="Registrar"
          method="post"
          id="formReintegroVenta">

        @Html.AntiForgeryToken()

        <input asp-for="VentaId"
               type="hidden" />

        <div asp-validation-summary="All"
             class="alert alert-danger"></div>

        <div class="row g-4">

            <div class="col-lg-8">

                <div class="table-container">

                    <div class="px-4 py-3 border-bottom bg-light">

                        <h2 class="h5 fw-bold mb-1">
                            Productos a reintegrar
                        </h2>

                        <div class="small text-muted">
                            Indique la cantidad que devuelve el cliente.
                        </div>

                    </div>

                    <div class="table-responsive">

                        <table class="table align-middle mb-0">

                            <thead class="table-light">

                                <tr>
                                    <th class="ps-4 py-3">
                                        Producto
                                    </th>

                                    <th class="py-3 text-center">
                                        Vendido
                                    </th>

                                    <th class="py-3 text-center">
                                        Ya reintegrado
                                    </th>

                                    <th class="py-3 text-center">
                                        Disponible
                                    </th>

                                    <th class="py-3 text-end">
                                        Precio
                                    </th>

                                    <th class="pe-4 py-3 text-center">
                                        Devolver
                                    </th>
                                </tr>

                            </thead>

                            <tbody>

                                @for (int i = 0;
                                                                i < Model.Detalles.Count;
                                                                i++)
                                {
                                    var detalle =
                                    Model.Detalles[i];

                                    <tr class="reintegro-detalle"
                                        data-precio="@detalle.PrecioUnitario.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                                        <td class="ps-4">

                                            <input asp-for="Detalles[i].ProductoId"
                                                   type="hidden" />

                                            <div class="fw-semibold">
                                                @detalle.ProductoNombre
                                            </div>

                                        </td>

                                        <td class="text-center">
                                            @detalle.CantidadVendida
                                        </td>

                                        <td class="text-center">
                                            @detalle.CantidadYaReintegrada
                                        </td>

                                        <td class="text-center fw-semibold">
                                            @detalle.CantidadDisponible
                                        </td>

                                        <td class="text-end">
                                            @detalle.PrecioUnitario.ToString("C")
                                        </td>

                                        <td class="pe-4">

                                            <input asp-for="Detalles[i].CantidadReintegrar"
                                                   type="number"
                                                   min="0"
                                                   max="@detalle.CantidadDisponible"
                                                   step="1"
                                                   class="form-control text-center cantidad-reintegrar" />

                                            <span asp-validation-for="Detalles[i].CantidadReintegrar"
                                                  class="text-danger small"></span>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="d-flex flex-column gap-4">

                    <div class="card-custom p-4">

                        <div class="small text-muted mb-1">
                            Importe disponible
                        </div>

                        <div class="h3 fw-bold mb-0">
                            @Model.ImporteDisponible.ToString("C")
                        </div>

                    </div>

                    <div class="card-custom p-4">

                        <div class="mb-3">

                            <label asp-for="MedioPagoId"
                                   class="form-label fw-semibold">
                                Medio de pago
                            </label>

                            <select asp-for="MedioPagoId"
                                    class="form-select">

                                <option value="">
                                    Seleccionar medio
                                </option>

                                @foreach (var medio in Model.MediosPagoDisponibles)
                                {
                                    <option value="@medio.Id">
                                        @medio.Nombre
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="MedioPagoId"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="CajaId"
                                   class="form-label fw-semibold">
                                Caja
                            </label>

                            <select asp-for="CajaId"
                                    class="form-select">

                                <option value="">
                                    Seleccionar caja
                                </option>

                                @foreach (var caja in Model.CajasDisponibles)
                                {
                                    <option value="@caja.Id">
                                        @caja.Nombre
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="CajaId"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="summary-panel p-4">

                        <div class="small text-white-50 text-uppercase fw-semibold mb-2">
                            Total a reintegrar
                        </div>

                        <div class="display-6 fw-bold text-white"
                             id="totalReintegro">
                            $0,00
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">

            <a asp-controller="Venta"
               asp-action="Details"
               asp-route-id="@Model.VentaId"
               class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button type="submit"
                    id="btnConfirmarReintegroVenta"
                    class="btn btn-danger">
                Confirmar reintegro
            </button>

        </div>

    </form>

</main>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/reintegro-venta.js"
            asp-append-version="true"></script>
}
