@model StockHistorialVM
@using saas.Models.Enums

@{
    ViewData["Title"] = "Historial de Movimientos";
    bool historialProducto = Model.ProductoId.HasValue;
}

<main class="flex-grow-1 container-fluid px-4 py-4">
    <div class="mb-4">
        <nav aria-label="breadcrumb" class="mb-2">
            <ol class="breadcrumb historial-breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a asp-action="Index" class="text-decoration-none text-secondary">Stock</a>
                </li>
                <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Historial de Movimientos</li>
            </ol>
        </nav>

        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3">
            <div>
                <h1 class="h2 mb-1">Historial de Movimientos</h1>
                <p class="text-secondary mb-0">
                    @(historialProducto
                                        ? "Registro detallado de movimientos de stock del producto seleccionado."
                                        : "Consulte y filtre todos los movimientos de stock registrados.")
                </p>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-2 fw-medium">
                    <span class="material-symbols-outlined fs-5">arrow_back</span>Volver
                </a>

                @if (historialProducto && User.IsInRole("AdminEmpresa"))
                {
                    <a asp-action="Ajustar"
                       asp-route-productoId="@Model.ProductoId"
                       class="btn btn-primary d-flex align-items-center gap-2 fw-medium">
                        <span class="material-symbols-outlined fs-5">add</span>Nuevo Ajuste
                    </a>
                }
            </div>
        </div>
    </div>

    @if (Model.ProductoId.HasValue && Model.StockActual.HasValue)
    {
        <div class="card bg-white mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <h2 class="h5 mb-0">Detalle del Producto</h2>

                    @if (Model.StockActual == 0)
                    {
                        <span class="status-badge status-empty">
                            <span class="dot"></span>Sin stock
                        </span>
                    }
                    else if (Model.StockActual <= Model.PuntoReposicion)
                    {
                        <span class="status-badge status-low">
                            <span class="dot"></span>Stock bajo
                        </span>
                    }
                    else
                    {
                        <span class="status-badge status-normal">
                            <span class="dot"></span>Con stock
                        </span>
                    }
                </div>

                <div class="row g-4">
                    <div class="col-md-6 col-lg-4">
                        <p class="historial-label mb-1">Producto</p>
                        <p class="fs-5 fw-semibold mb-0">@Model.ProductoNombre</p>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <p class="historial-label mb-1">Código de Barras</p>
                        <p class="font-monospace mb-0">
                            @(string.IsNullOrWhiteSpace(Model.CodigoBarra) ? "Sin código" : Model.CodigoBarra)
                        </p>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <p class="historial-label mb-1">Categoría</p>
                        <p class="mb-0">@Model.CategoriaNombre</p>
                    </div>

                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <div class="col-md-6 col-lg-4">
                            <p class="historial-label mb-1">Empresa</p>
                            <p class="mb-0">@Model.EmpresaNombre</p>
                        </div>
                    }

                    <div class="col-md-6 col-lg-4">
                        <p class="historial-label mb-1">Stock Actual</p>
                        <p class="fs-4 fw-bold mb-0">@Model.StockActual</p>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <p class="historial-label mb-1">Punto de Reposición</p>
                        <p class="fs-5 mb-0">@Model.PuntoReposicion unidades</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card bg-white mb-4">
        <div class="card-body p-3">
            <span asp-validation-for="FechaHasta" class="filter-validation-message text-danger small"></span>
            <form asp-action="Historial" method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label asp-for="ProductoId" class="form-label fw-semibold">Producto</label>
                    <select asp-for="ProductoId" asp-items="Model.Productos" class="form-select">
                        <option value="">Todos los productos</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label asp-for="Tipo" class="form-label fw-semibold">Tipo</label>
                    <select asp-for="Tipo" class="form-select">
                        <option value="">Todos</option>
                        @foreach (TipoMovimientoStock tipo in Enum.GetValues<TipoMovimientoStock>())
                        {
                            <option value="@tipo">@TextoPresentacion.ValorEnum(tipo)</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label asp-for="FechaDesde" class="form-label fw-semibold">Desde</label>
                    <input asp-for="FechaDesde" type="date" class="form-control" />
                </div>

                <div class="col-md-2">
                    <label asp-for="FechaHasta" class="form-label fw-semibold">Hasta</label>
                    <input asp-for="FechaHasta" type="date" class="form-control" />
                </div>

                @if (User.IsInRole("SuperAdmin"))
                {
                    <div class="col-md-2">
                        <label asp-for="EmpresaId" class="form-label fw-semibold">Empresa</label>
                        <select asp-for="EmpresaId" asp-items="Model.Empresas" class="form-select">
                            <option value="">Todas las empresas</option>
                        </select>
                    </div>
                }

                <div class="col-md-auto">
                    <button type="submit" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined fs-5">search</span>Buscar
                    </button>
                </div>

                @if (Model.ProductoId.HasValue || Model.Tipo.HasValue || Model.FechaDesde.HasValue || Model.FechaHasta.HasValue || Model.EmpresaId.HasValue)
                {
                    <div class="col-md-auto">
                        <a asp-action="Historial" class="btn btn-outline-secondary">Limpiar</a>
                    </div>
                }
            </form>
        </div>
    </div>

    <div class="card bg-white">
        <div class="card-header bg-light border-bottom py-3">
            <h3 class="h6 mb-0">Movimientos</h3>
        </div>

        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Fecha</th>
                        <th>Producto</th>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <th>Empresa</th>
                        }
                        <th>Usuario</th>
                        <th>Tipo</th>
                        <th class="text-end">Stock Ant.</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Stock Final</th>
                        <th class="pe-4">Motivo</th>
                    </tr>
                </thead>

                <tbody class="border-top-0">
                    @if (!Model.Movimientos.Any())
                    {
                        <tr>
                            <td colspan="@(User.IsInRole("SuperAdmin") ? 9 : 8)" class="text-center text-secondary py-5">
                                No se encontraron movimientos para los criterios seleccionados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var movimiento in Model.Movimientos)
                        {
                            bool esEntrada =  movimiento.StockPosterior > movimiento.StockAnterior;

                            string signo = esEntrada ? "+" : "-";
                            string claseCantidad = esEntrada ? "text-success" : "text-danger";
                            string claseBadge = esEntrada ? "historial-badge-entrada" : "historial-badge-salida";
                            string icono = esEntrada ? "arrow_downward" : "arrow_upward";

                            <tr>
                                <td class="ps-4 text-nowrap">@movimiento.Fecha.ToString("dd/MM/yyyy HH:mm")</td>

                                <td>
                                    <div class="fw-semibold">@movimiento.ProductoNombre</div>
                                    @if (!string.IsNullOrWhiteSpace(movimiento.CodigoBarra))
                                    {
                                        <div class="small text-secondary">@movimiento.CodigoBarra</div>
                                    }
                                </td>

                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <td>@movimiento.EmpresaNombre</td>
                                }

                                <td>@movimiento.UsuarioNombre</td>

                                <td>
                                    <span class="historial-badge @claseBadge">
                                        <span class="material-symbols-outlined">@icono</span>
                                        @TextoPresentacion.ValorEnum(movimiento.Tipo)
                                    </span>
                                </td>

                                <td class="text-end text-secondary">@movimiento.StockAnterior</td>
                                <td class="text-end fw-semibold @claseCantidad">@signo@movimiento.Cantidad</td>
                                <td class="text-end fw-semibold">@movimiento.StockPosterior</td>

                                <td class="pe-4 historial-motivo" title="@movimiento.Motivo">
                                    @(string.IsNullOrWhiteSpace(movimiento.Motivo) ? "-" : movimiento.Motivo)
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-light border-top-0 px-4 py-3">
            <span class="small text-secondary">
                @Model.Movimientos.Count
                @(Model.Movimientos.Count == 1 ? "movimiento encontrado" : "movimientos encontrados")
            </span>
        </div>
    </div>
</main>
