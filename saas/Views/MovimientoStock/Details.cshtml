@model saas.Models.MovimientoStock

@{
    ViewData["Title"] = "Detalle del movimiento de stock";
    bool esEntrada = Model.StockPosterior > Model.StockAnterior;
    string usuarioNombre = $"{Model.Usuario.Nombre} {Model.Usuario.Apellido}".Trim();
}

<main class="container-fluid px-4 py-4">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Movimiento de stock #@Model.Id</h1>
        <p class="text-muted mb-0">Detalle y trazabilidad del cambio realizado sobre el inventario.</p>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="text-muted small">Producto</div>
                            <div class="fw-semibold">@Model.Producto.Nombre</div>
                        </div>

                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="col-md-6">
                                <div class="text-muted small">Empresa</div>
                                <div class="fw-semibold">@Model.Empresa.Nombre</div>
                            </div>
                        }

                        <div class="col-md-6">
                            <div class="text-muted small">Tipo de movimiento</div>
                            <div class="fw-semibold">@TextoPresentacion.ValorEnum(Model.Tipo)</div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">Fecha</div>
                            <div>@FechaHora.ConvertirAHoraLocal(Model.Fecha).ToString("dd/MM/yyyy HH:mm")</div>
                        </div>

                        <div class="col-md-4">
                            <div class="text-muted small">Cantidad</div>
                            <div class="fw-semibold">@Model.Cantidad</div>
                        </div>

                        <div class="col-md-4">
                            <div class="text-muted small">Stock anterior</div>
                            <div>@Model.StockAnterior</div>
                        </div>

                        <div class="col-md-4">
                            <div class="text-muted small">Stock posterior</div>
                            <div class="fw-semibold">@Model.StockPosterior</div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">Usuario</div>
                            <div>@(string.IsNullOrWhiteSpace(usuarioNombre) ? Model.Usuario.Email : usuarioNombre)</div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">Origen relacionado</div>
                            @if (Model.VentaId.HasValue)
                            {
                                <a asp-controller="Venta" asp-action="Details" asp-route-id="@Model.VentaId">Venta #@Model.VentaId</a>
                            }
                            else if (Model.CompraId.HasValue)
                            {
                                <a asp-controller="Compra" asp-action="Details" asp-route-id="@Model.CompraId">Compra #@Model.CompraId</a>
                            }
                            else
                            {
                                <span>Movimiento manual</span>
                            }
                        </div>

                        <div class="col-12">
                            <div class="text-muted small">Motivo</div>
                            <div>@(string.IsNullOrWhiteSpace(Model.Motivo) ? "Sin motivo informado" : Model.Motivo)</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="text-muted small">Variación de stock</div>
                    <div class="display-6 fw-bold @(esEntrada ? "text-success" : "text-danger")">
                        @(esEntrada ? "+" : "-")@Model.Cantidad
                    </div>
                </div>
            </div>

            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">swap_vert</span>
                    <div><h3 class="help-guide-item__title">Entrada o salida</h3><p class="help-guide-item__text">La variación indica si el movimiento aumentó o redujo las existencias del producto.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">inventory</span>
                    <div><h3 class="help-guide-item__title">Stock resultante</h3><p class="help-guide-item__text">El stock posterior es la cantidad disponible después de aplicar el movimiento.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">history</span>
                    <div><h3 class="help-guide-item__title">Trazabilidad</h3><p class="help-guide-item__text">Los movimientos de stock son históricos y no pueden editarse ni eliminarse.</p></div>
                </div>
            </div>
        </div>
    </div>
</main>
