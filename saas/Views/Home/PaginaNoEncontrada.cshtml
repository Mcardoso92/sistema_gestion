@{
    ViewData["Title"] = "Página no encontrada";
}

<main class="page-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title">Página no encontrada</h1>
            <p class="page-subtitle">La página solicitada no existe o ya no se encuentra disponible.</p>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-house"></i>
            Volver al Dashboard
        </a>
    }
    else
    {
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-house"></i>
            Volver al inicio
        </a>
    }
</main>
