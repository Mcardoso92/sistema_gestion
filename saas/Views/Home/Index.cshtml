@{
    ViewData["Title"] = "Gestión simple para tu negocio";
    ViewData["MetaDescription"] = "Administrá ventas, compras, stock, clientes y proveedores de forma simple con Veltika.";
    Layout = "_PublicLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/public-pilot.css" asp-append-version="true" />
}

<section class="public-hero">
    <div class="container-xl">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <div class="hero-eyebrow">
                    <span></span>
                    Sistema de gestión para tu negocio
                </div>

                <h1 class="hero-title">
                    Tu negocio,<br />
                    <span>más simple.</span>
                </h1>

                <p class="hero-description">
                    Veltika te ayuda a administrar ventas, productos, stock, clientes,
                    compras y proveedores desde un solo lugar.
                </p>

                <div class="hero-actions">
                    <a class="btn btn-primary hero-primary-btn" asp-controller="Usuario" asp-action="Registro">
                        Probar gratis ahora
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </a>

                    <a class="btn hero-secondary-btn" href="#funcionalidades">
                        Conocer Veltika
                        <span class="material-symbols-outlined">play_arrow</span>
                    </a>
                </div>

                <div class="hero-benefits">
                    <span>
                        <span class="material-symbols-outlined">check_circle</span>
                        Fácil de usar
                    </span>

                    <span>
                        <span class="material-symbols-outlined">devices</span>
                        Acceso desde cualquier lugar
                    </span>

                    <span>
                        <span class="material-symbols-outlined">shield</span>
                        Información segura
                    </span>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="dashboard-preview">
                    <div class="preview-navbar">
                        <div class="preview-logo">
                            <span class="veltika-brand-icon veltika-brand-icon--small">V</span>
                            Veltika
                        </div>

                        <div class="preview-menu">
                            <div class="active">
                                <span class="material-symbols-outlined">dashboard</span>
                                Dashboard
                            </div>

                            <div>
                                <span class="material-symbols-outlined">point_of_sale</span>
                                Ventas
                            </div>

                            <div>
                                <span class="material-symbols-outlined">shopping_cart</span>
                                Compras
                            </div>

                            <div>
                                <span class="material-symbols-outlined">inventory_2</span>
                                Productos
                            </div>

                            <div>
                                <span class="material-symbols-outlined">groups</span>
                                Clientes
                            </div>

                            <div>
                                <span class="material-symbols-outlined">local_shipping</span>
                                Proveedores
                            </div>

                            <div>
                                <span class="material-symbols-outlined">account_balance</span>
                                Caja
                                <span class="material-symbols-outlined preview-menu-arrow">keyboard_arrow_down</span>
                            </div>

                            <div>
                                <span class="material-symbols-outlined">monitoring</span>
                                Reportes
                                <span class="material-symbols-outlined preview-menu-arrow">keyboard_arrow_down</span>
                            </div>

                            <div>
                                <span class="material-symbols-outlined">more_horiz</span>
                                Más
                                <span class="material-symbols-outlined preview-menu-arrow">keyboard_arrow_down</span>
                            </div>
                        </div>

                        <div class="preview-user">
                            <span class="material-symbols-outlined">notifications</span>
                            <span class="preview-notification-count">4</span>
                            <span class="preview-avatar">A</span>
                            <span class="material-symbols-outlined">keyboard_arrow_down</span>
                        </div>
                    </div>

                    <div class="preview-content">
                        <div class="preview-heading">
                            <div>
                                <h5 aria-hidden="true">Dashboard</h5>
                                <small>Resumen general de tu negocio</small>
                            </div>

                            <div class="preview-company">
                                Mi Empresa S.A.
                            </div>
                        </div>

                        <div class="preview-stats">
                            <div class="preview-stat">
                                <span class="material-symbols-outlined preview-stat-icon preview-stat-icon-primary">today</span>
                                <div>
                                    <span>Ventas de hoy</span>
                                    <strong>$245.250</strong>
                                    <small>18 operaciones</small>
                                </div>
                            </div>

                            <div class="preview-stat">
                                <span class="material-symbols-outlined preview-stat-icon preview-stat-icon-success">calendar_month</span>
                                <div>
                                    <span>Ventas del mes</span>
                                    <strong>$3.480.900</strong>
                                    <small>246 operaciones</small>
                                </div>
                            </div>

                            <div class="preview-stat">
                                <span class="material-symbols-outlined preview-stat-icon preview-stat-icon-warning">inventory_2</span>
                                <div>
                                    <span>Stock bajo</span>
                                    <strong>7</strong>
                                    <small>productos para revisar</small>
                                </div>
                            </div>

                            <div class="preview-stat">
                                <span class="material-symbols-outlined preview-stat-icon preview-stat-icon-info">groups</span>
                                <div>
                                    <span>Clientes frecuentes</span>
                                    <strong>12</strong>
                                    <small>clientes destacados</small>
                                </div>
                            </div>
                        </div>

                        <div class="preview-dashboard-row">
                            <div class="preview-chart-card">
                                <div class="preview-card-title">
                                    Ventas de los últimos 7 días
                                </div>

                                <div class="preview-bar-chart">
                                    <div><span>$28k</span><i style="height: 52%"></i><small>Lun</small></div>
                                    <div><span>$41k</span><i style="height: 76%"></i><small>Mar</small></div>
                                    <div><span>$35k</span><i style="height: 64%"></i><small>Mié</small></div>
                                    <div><span>$52k</span><i style="height: 94%"></i><small>Jue</small></div>
                                    <div><span>$46k</span><i style="height: 83%"></i><small>Vie</small></div>
                                    <div><span>$31k</span><i style="height: 57%"></i><small>Sáb</small></div>
                                    <div><span>$38k</span><i style="height: 70%"></i><small>Dom</small></div>
                                </div>
                            </div>

                            <div class="preview-activity-card">
                                <div class="preview-card-title">
                                    Productos con stock bajo
                                </div>

                                <div class="activity-item">
                                    <div>
                                        <strong>Coca Cola 2.25L</strong>
                                        <small>Bebidas</small>
                                    </div>
                                    <span>3 / Mín. 10</span>
                                </div>

                                <div class="activity-item">
                                    <div>
                                        <strong>Arroz 1kg</strong>
                                        <small>Almacén</small>
                                    </div>
                                    <span>2 / Mín. 8</span>
                                </div>

                                <div class="activity-item">
                                    <div>
                                        <strong>Harina 000 1kg</strong>
                                        <small>Almacén</small>
                                    </div>
                                    <span>1 / Mín. 6</span>
                                </div>
                            </div>
                        </div>

                        <div class="preview-ranking-row">
                            <div class="preview-ranking-card">
                                <div class="preview-card-title">Productos más vendidos</div>

                                <div class="preview-ranking-item">
                                    <span class="preview-ranking-position">1</span>
                                    <strong>Coca Cola 2.25L</strong>
                                    <span>184 u.</span>
                                </div>

                                <div class="preview-ranking-item">
                                    <span class="preview-ranking-position">2</span>
                                    <strong>Arroz 1kg</strong>
                                    <span>132 u.</span>
                                </div>
                            </div>

                            <div class="preview-ranking-card">
                                <div class="preview-card-title">Clientes frecuentes</div>

                                <div class="preview-ranking-item">
                                    <span class="preview-ranking-position">1</span>
                                    <strong>María González</strong>
                                    <span>28 compras</span>
                                </div>

                                <div class="preview-ranking-item">
                                    <span class="preview-ranking-position">2</span>
                                    <strong>Carlos Rodríguez</strong>
                                    <span>21 compras</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="funcionalidades" class="public-section">
    <div class="container-xl">
        <div class="section-heading">
            <span>TODO EN UN SOLO LUGAR</span>
            <h2>¿Qué podés hacer con Veltika?</h2>
            <p>
                Las herramientas que necesitás para administrar tu negocio
                de forma simple y organizada.
            </p>
        </div>

        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">
                    <span class="material-symbols-outlined">point_of_sale</span>
                </div>
                <h3>Ventas</h3>
                <p>Registrá tus ventas de manera rápida y mantené toda la información organizada.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <span class="material-symbols-outlined">inventory_2</span>
                </div>
                <h3>Productos</h3>
                <p>Administrá tu catálogo de productos, categorías, precios y disponibilidad.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <span class="material-symbols-outlined">deployed_code</span>
                </div>
                <h3>Stock</h3>
                <p>Controlá movimientos de inventario y detectá productos con stock bajo.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <span class="material-symbols-outlined">groups</span>
                </div>
                <h3>Clientes</h3>
                <p>Centralizá la información de tus clientes y su actividad comercial.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <span class="material-symbols-outlined">local_shipping</span>
                </div>
                <h3>Proveedores</h3>
                <p>Organizá tus proveedores y mantené sus datos siempre disponibles.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <span class="material-symbols-outlined">shopping_cart</span>
                </div>
                <h3>Compras</h3>
                <p>Registrá compras y mantené actualizado automáticamente tu inventario.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <span class="material-symbols-outlined">manage_accounts</span>
                </div>
                <h3>Usuarios</h3>
                <p>Administrá los usuarios y permisos de las personas que trabajan con vos.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <span class="material-symbols-outlined">monitoring</span>
                </div>
                <h3>Reportes</h3>
                <p>Convertí la información de tu negocio en datos útiles para tomar decisiones.</p>
            </div>
        </div>
    </div>
</section>

<section id="beneficios" class="public-section benefits-section">
    <div class="container-xl">
        <div class="section-heading">
            <span>GESTIÓN SIN COMPLICACIONES</span>
            <h2>Más control. Menos trabajo.</h2>
            <p>
                Veltika centraliza la operación diaria para que puedas dedicar
                más tiempo a hacer crecer tu negocio.
            </p>
        </div>

        <div class="benefits-grid">
            <div class="benefit-item">
                <div class="benefit-icon">
                    <span class="material-symbols-outlined">rocket_launch</span>
                </div>
                <div>
                    <h3>Ahorrá tiempo</h3>
                    <p>Centralizá tus tareas y evitá procesos repetitivos.</p>
                </div>
            </div>

            <div class="benefit-item">
                <div class="benefit-icon">
                    <span class="material-symbols-outlined">visibility</span>
                </div>
                <div>
                    <h3>Control total</h3>
                    <p>Conocé qué está pasando en tu negocio en todo momento.</p>
                </div>
            </div>

            <div class="benefit-item">
                <div class="benefit-icon">
                    <span class="material-symbols-outlined">verified</span>
                </div>
                <div>
                    <h3>Menos errores</h3>
                    <p>Mantené la información organizada y siempre actualizada.</p>
                </div>
            </div>

            <div class="benefit-item">
                <div class="benefit-icon">
                    <span class="material-symbols-outlined">trending_up</span>
                </div>
                <div>
                    <h3>Mejores decisiones</h3>
                    <p>Usá información real para entender y hacer crecer tu negocio.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="precios" class="public-section pricing-section">
    <div class="container-xl">
        <div class="section-heading">
            <span>PRECIOS SIMPLES</span>
            <h2>Probá Veltika gratis durante nuestra etapa piloto</h2>
            <p>
                Estamos preparando los planes comerciales de Veltika. Mientras tanto,
                podés utilizar la plataforma sin costo hasta el 31 de diciembre de 2026.
            </p>
        </div>

        <div class="pilot-card">
            <div class="pilot-card-header">
                <span class="material-symbols-outlined pilot-card-icon" aria-hidden="true">rocket_launch</span>
                <div>
                    <span class="pilot-card-eyebrow">CUPOS ABIERTOS</span>
                    <h3>Programa Piloto Veltika 2026</h3>
                </div>
            </div>

            <p class="pilot-card-description">
                Accedé a Veltika sin costo durante nuestra etapa piloto y ayudanos a
                seguir mejorando la plataforma con tu experiencia.
            </p>

            <ul class="pilot-benefits">
                <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span>Acceso gratuito hasta el 31/12/2026.</li>
                <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span>Sin compromiso de contratación.</li>
                <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span>Soporte y acompañamiento durante el piloto.</li>
                <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span>Beneficios exclusivos para los participantes al finalizar esta etapa.</li>
            </ul>

            <a class="btn btn-primary pilot-card-button" asp-controller="Usuario" asp-action="Registro">
                Probar Veltika gratis
                <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a>
        </div>

        <p class="pilot-notice">
            Los planes comerciales de Veltika serán anunciados antes de finalizar el Programa Piloto.
        </p>
    </div>
</section>

<section id="nosotros" class="public-section about-section">
    <div class="container-xl">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <span class="section-label">SOBRE VELTIKA</span>

                <h2>
                    Tecnología pensada para simplificar la gestión.
                </h2>
            </div>

            <div class="col-lg-7">
                <p class="about-text">
                    Veltika nace con una idea simple: que administrar un negocio
                    no requiera trabajar con múltiples herramientas, planillas y
                    procesos desorganizados.
                </p>

                <p class="about-text">
                    Veltika es una plataforma donde ventas, productos, stock,
                    clientes, compras, proveedores y usuarios pueden gestionarse
                    desde un mismo lugar. Actualmente nos encontramos en etapa piloto,
                    trabajando junto a nuestros primeros usuarios para seguir mejorando
                    la experiencia.
                </p>
            </div>
        </div>
    </div>
</section>

<section id="contacto" class="public-cta-section">
    <div class="container-xl">
        <div class="public-cta">
            <div class="cta-icon">
                <span class="material-symbols-outlined">rocket_launch</span>
            </div>

            <div class="cta-content">
                <h2>Empezá a gestionar tu negocio de otra manera</h2>
                <p>
                    Descubrí todo lo que Veltika puede hacer por tu negocio.
                    Si tenés dudas, escribinos a
                    <a class="cta-contact-link" href="mailto:contacto@veltika.com.ar">contacto@veltika.com.ar</a>.
                </p>
            </div>

            <a class="btn cta-button" asp-controller="Usuario" asp-action="Registro">
                Comenzar con Veltika
                <span class="material-symbols-outlined">arrow_forward</span>
            </a>
        </div>
    </div>
</section>
