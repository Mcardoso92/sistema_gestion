@model saas.Models.Empresa

@{
    ViewData["Title"] = "Crear Empresa";
}

<main class="container-fluid px-4">
    <div class="row align-items-end mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="text-decoration-none text-muted">
                            Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index"
                           class="text-decoration-none text-muted">
                            Empresas
                        </a>
                    </li>
                    <li aria-current="page"
                        class="breadcrumb-item active fw-semibold">
                        Crear Empresa
                    </li>
                </ol>
            </nav>

            <h1 class="display-6 fw-bold text-dark mb-1">
                Crear Empresa
            </h1>

            <p class="text-muted mb-0">
                Registre una nueva empresa para comenzar a gestionar su información dentro del sistema.
            </p>
        </div>
    </div>
    <div class="row">
        <!-- Form Column -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header">
                    Nueva Empresa
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" class="row g-4" id="empresaForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="col-md-8">
                            <label asp-for="Nombre" class="form-label">Nombre de la Empresa</label>
                            <input asp-for="Nombre" class="form-control" type="text" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-12 mt-5 border-top pt-4 d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-v-outline">Cancelar</a>
                            <button type="submit" class="btn btn-v-primary">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <!-- Help Guide Column -->
        <div class="col-lg-4">
            <div class="form-container border p-4 p-md-5 h-100 d-flex flex-column">
                <h2 class="h5 fw-bold mb-4 border-bottom pb-3">
                    Guía de Ayuda
                </h2>

                <div class="help-guide-item d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-primary-veltika fs-4 mt-1">
                        corporate_fare
                    </span>

                    <div>
                        <h3 class="h6 fw-bold mb-1">
                            Nombre de la empresa
                        </h3>

                        <p class="small text-muted mb-0">
                            Ingrese un nombre que permita identificar claramente a la organización dentro del sistema.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-primary-veltika fs-4 mt-1">
                        verified
                    </span>

                    <div>
                        <h3 class="h6 fw-bold mb-1">
                            Estado inicial
                        </h3>

                        <p class="small text-muted mb-0">
                            Las empresas nuevas se registran activas y quedan disponibles para asociar usuarios, categorías y productos.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-primary-veltika fs-4 mt-1">
                        security
                    </span>

                    <div>
                        <h3 class="h6 fw-bold mb-1">
                            Aislamiento de datos
                        </h3>

                        <p class="small text-muted mb-0">
                            La información registrada para cada empresa se administra de forma independiente.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
