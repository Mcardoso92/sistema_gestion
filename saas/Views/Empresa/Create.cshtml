@model saas.Models.Empresa

@{
    ViewData["Title"] = "Crear Empresa";
}

<main class="container-fluid px-4">
    <div class="row">
        <!-- Form Column -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header">
                    Nueva Empresa
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" class="row g-4" id="productForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="col-md-8">
                            <label asp-for="Nombre" class="form-label">Nombre de la Empresa</label>
                            <input asp-for="Nombre" class="form-control" type="text" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-12 mt-5 border-top pt-4 d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-v-outline">Cancelar</a>
                            <button type="submit" class="btn btn-v-primary">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <!-- Help Column -->
        <div class="mb-4">
            <h6 class="fw-bold mb-2" style="font-size: 14px; color: var(--v-primary-container);">
                Código de barras
            </h6>
            <p class="text-muted" style="font-size: 13px;">
                Ingrese el código de barras del producto cuando corresponda. Puede utilizarse para localizarlo rápidamente.
            </p>
        </div>

        <div class="mb-4">
            <h6 class="fw-bold mb-2" style="font-size: 14px; color: var(--v-primary-container);">
                Gestión de stock
            </h6>
            <p class="text-muted" style="font-size: 13px;">
                Indique el stock inicial y el punto de reposición para identificar productos con pocas unidades disponibles.
            </p>
        </div>

        <div class="mb-4">
            <h6 class="fw-bold mb-2" style="font-size: 14px; color: var(--v-primary-container);">
                Categoría
            </h6>
            <p class="text-muted" style="font-size: 13px;">
                Seleccione una categoría perteneciente a la misma empresa del producto.
            </p>
        </div>
    </div>
</main>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
