@model saas.Models.Empresa

@{
    ViewData["Title"] = "Detalles de la Empresa";
}

<main class="container-fluid px-4">
    <div class="row">
        <!-- Form Column -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header">
                    Información de la Empresa
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-8">
                            <label asp-for="Nombre" class="form-label">Nombre de la Empresa</label>
                            <input asp-for="Nombre" class="form-control" type="text" readonly />
                        </div>
                        <div class="col-md-8">
                            <label asp-for="FechaAlta" class="form-label">Fecha de Alta</label>
                            <input value="@Model.FechaAlta.ToString("dd/MM/yyyy")" class="form-control" type="text" readonly />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="Estado" class="form-check-input" role="switch" disabled />
                                <label asp-for="Estado" class="form-check-label fw-semibold">Estado de la Empresa (Activa/Inactiva)</label>
                            </div>
                        </div>
                        <div class="col-12 mt-5 border-top pt-4 d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-v-outline">Volver</a>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-v-primary"> Editar </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Help Column -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header d-flex align-items-center">
                    <span class="material-symbols-outlined me-2 text-primary">info</span>
                    Guía de Ayuda
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <h6 class="fw-bold mb-2" style="font-size: 14px; color: var(--v-primary-container);">SKU &amp; Formato</h6>
                        <p class="text-muted" style="font-size: 13px;">El SKU debe ser único. Recomendamos usar un prefijo de categoría seguido de un identificador numérico (ej. ELEC-001).</p>
                    </div>
                    <div class="mb-4">
                        <h6 class="fw-bold mb-2" style="font-size: 14px; color: var(--v-primary-container);">Gestión de Stock</h6>
                        <p class="text-muted" style="font-size: 13px;">El stock inicial será cargado en el almacén principal por defecto. Puede ajustarlo más tarde desde el módulo de Inventarios.</p>
                    </div>
                    <div class="mb-4">
                        <h6 class="fw-bold mb-2" style="font-size: 14px; color: var(--v-primary-container);">Categorías</h6>
                        <p class="text-muted" style="font-size: 13px;">Asignar una categoría correcta es vital para los reportes de ventas automáticos de final de mes.</p>
                    </div>
                    <div class="tip-box">
                        <div class="d-flex align-items-center mb-2">
                            <span class="material-symbols-outlined text-secondary me-2">lightbulb</span>
                            <span class="fw-bold" style="font-size: 14px;">Tip de Organización</span>
                        </div>
                        <p class="mb-0 text-muted" style="font-size: 13px;">Mantenga descripciones cortas y use palabras clave. Esto facilita la búsqueda global dentro de la suite VELTIKA.</p>
                    </div>
                </div>
            </div>
            <div class="card border-0 shadow-sm mt-4">
                <div style="height: 180px; position: relative;">
                    <div class="w-100 h-100 rounded-top" data-alt="A clean, high-angle shot of a minimalist warehouse with neatly organized white shelves and boxes. The lighting is bright and industrial, emphasizing efficiency and order. Soft blue and teal accents reflect a corporate SaaS tech environment. Shot with a sharp focus and professional look." style="background-size: cover; background-position: center;"></div>
                    <div class="position-absolute bottom-0 start-0 p-3 w-100" style="background: linear-gradient(transparent, rgba(0,0,0,0.7));">
                        <span class="badge bg-success">Actualización en tiempo real</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>