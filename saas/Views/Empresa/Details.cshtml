@model saas.Models.Empresa

@{
    ViewData["Title"] = "Detalles de la Empresa";
}

<main class="container-fluid px-4">
    <div class="row align-items-end mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="text-decoration-none text-muted">
                            Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index"
                           class="text-decoration-none text-muted">
                            Empresas
                        </a>
                    </li>
                    <li aria-current="page"
                        class="breadcrumb-item active fw-semibold">
                        Detalle de la Empresa
                    </li>
                </ol>
            </nav>

            <h1 class="display-6 fw-bold text-dark mb-1">
                Detalle de la Empresa
            </h1>

            <p class="text-muted mb-0">
                Consulte la información general y el estado actual de la empresa seleccionada.
            </p>
        </div>
    </div>
    <div class="row">
        <!-- Form Column -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header">
                    Información de la Empresa
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-8">
                            <label asp-for="Nombre" class="form-label">Nombre de la Empresa</label>
                            <input asp-for="Nombre" class="form-control" type="text" readonly />
                        </div>
                        <div class="col-md-8">
                            <label asp-for="FechaAlta" class="form-label">Fecha de Alta</label>
                            <input value="@FechaHora.ConvertirAHoraLocal(Model.FechaAlta).ToString("dd/MM/yyyy")" class="form-control" type="text" readonly />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="Estado" class="form-check-input" role="switch" disabled />
                                <label asp-for="Estado" class="form-check-label fw-semibold">Estado de la Empresa (Activa/Inactiva)</label>
                            </div>
                        </div>
                        <div class="col-12 mt-5 border-top pt-4 d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-v-outline">Volver</a>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-v-primary"> Editar </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Help Column -->
        <div class="col-md-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">info</span>
                    <div>
                        <h3 class="help-guide-item__title">Información general</h3>
                        <p class="help-guide-item__text">
                            Esta pantalla permite consultar el nombre, la fecha de alta y el estado actual de la empresa.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">verified</span>
                    <div>
                        <h3 class="help-guide-item__title">Empresa activa</h3>
                        <p class="help-guide-item__text">
                            Cuando la empresa está activa, sus usuarios pueden acceder y operar dentro de los módulos habilitados.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">block</span>
                    <div>
                        <h3 class="help-guide-item__title">Empresa inactiva</h3>
                        <p class="help-guide-item__text">
                            Cuando se encuentra inactiva, su información se conserva, pero el acceso de sus usuarios permanece bloqueado.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">edit</span>
                    <div>
                        <h3 class="help-guide-item__title">Modificación</h3>
                        <p class="help-guide-item__text">
                            Utilice el botón Editar para modificar el nombre o cambiar el estado de la empresa.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
