@model saas.Models.Empresa

@{
    ViewData["Title"] = "Editar Empresa";

}

<main class="container-fluid px-4">
    <div class="row align-items-end mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="text-decoration-none text-muted">
                            Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index"
                           class="text-decoration-none text-muted">
                            Empresas
                        </a>
                    </li>
                    <li aria-current="page"
                        class="breadcrumb-item active fw-semibold">
                        Editar Empresa
                    </li>
                </ol>
            </nav>

            <h1 class="display-6 fw-bold text-dark mb-1">
                Editar Empresa
            </h1>

            <p class="text-muted mb-0">
                Modifique la información general y el estado operativo de la empresa.
            </p>
        </div>
    </div>
    <div class="row">
        <!-- Form Column -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header">
                    Información de la Empresa
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" class="row g-4" id="empresaForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <div class="col-md-8">
                            <label asp-for="Nombre" class="form-label">Nombre de la Empresa</label>
                            <input asp-for="Nombre" class="form-control" type="text" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="Estado" class="form-check-input" role="switch" type="checkbox" />
                                <label asp-for="Estado" class="form-check-label fw-semibold"> Estado de la Empresa </label>
                            </div>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>
                        <div class="col-12 mt-5 border-top pt-4 d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-v-outline">Cancelar</a>
                            <button type="submit" class="btn btn-v-primary">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <!-- Help Column -->
        <div class="col-md-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">corporate_fare</span>
                    <div>
                        <h3 class="help-guide-item__title">Nombre de la empresa</h3>
                        <p class="help-guide-item__text">
                            Utilice un nombre claro y representativo. No puede existir otra empresa registrada con el mismo nombre.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">toggle_on</span>
                    <div>
                        <h3 class="help-guide-item__title">Estado operativo</h3>
                        <p class="help-guide-item__text">
                            Una empresa activa puede operar normalmente y sus usuarios pueden acceder al sistema.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">block</span>
                    <div>
                        <h3 class="help-guide-item__title">Desactivación</h3>
                        <p class="help-guide-item__text">
                            Al desactivar la empresa, se conserva toda su información, pero sus usuarios dejan de poder iniciar sesión.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">restart_alt</span>
                    <div>
                        <h3 class="help-guide-item__title">Reactivación</h3>
                        <p class="help-guide-item__text">
                            Puede reactivar la empresa en cualquier momento habilitando nuevamente su estado.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
