@model Empresa

@{
    ViewData["Title"] = "Desactivar Empresa";
}

<main class="container-fluid px-4">
    <div class="row align-items-end mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="text-decoration-none text-muted">
                            Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index"
                           class="text-decoration-none text-muted">
                            Empresas
                        </a>
                    </li>
                    <li aria-current="page"
                        class="breadcrumb-item active fw-semibold">
                        Desactivar Empresa
                    </li>
                </ol>
            </nav>

            <h1 class="display-6 fw-bold text-dark mb-1">
                Desactivar Empresa
            </h1>

            <p class="text-muted mb-0">
                Revise la información antes de confirmar la desactivación de la empresa.
            </p>
        </div>
    </div>
    <div class="row">
        <!-- Form Column -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header">
                    Desactivar Empresa
                </div>

                <div class="card-body p-4">

                    <div class="alert alert-warning d-flex align-items-center mb-4">
                        <span class="material-symbols-outlined me-2">
                            warning
                        </span>

                        <span>
                            La empresa será desactivada y dejará de estar disponible para operar en el sistema.
                        </span>
                    </div>

                    <form asp-action="Delete"
                          method="post">

                        <input asp-for="Id" type="hidden" />

                        <div class="row g-4">

                            <div class="col-md-8">
                                <label class="form-label">
                                    Nombre de la Empresa
                                </label>

                                <input asp-for="Nombre"
                                       class="form-control"
                                       readonly />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">
                                    Fecha de Alta
                                </label>

                                <input value="@FechaHora.ConvertirAHoraLocal(Model.FechaAlta).ToString("dd/MM/yyyy")"
                                       class="form-control"
                                       readonly />
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch">

                                    <input asp-for="Estado"
                                           class="form-check-input"
                                           disabled />

                                    <label class="form-check-label fw-semibold">
                                        Estado de la Empresa
                                    </label>

                                </div>
                            </div>

                            <div class="col-12 mt-5 border-top pt-4 d-flex justify-content-end gap-3">

                                <a asp-action="Index"
                                   class="btn btn-v-outline">
                                    Cancelar
                                </a>

                                <button type="submit"
                                        class="btn btn-danger">
                                    Desactivar
                                </button>

                            </div>

                        </div>

                    </form>

                </div>
            </div>
        </div>

        <!-- Help Column -->
        <div class="col-md-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">block</span>
                    <div>
                        <h3 class="help-guide-item__title">Desactivación</h3>
                        <p class="help-guide-item__text">
                            La empresa permanecerá registrada en el sistema, pero dejará de estar disponible para operar.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">group_off</span>
                    <div>
                        <h3 class="help-guide-item__title">Usuarios</h3>
                        <p class="help-guide-item__text">
                            Los usuarios asociados a esta empresa no podrán iniciar sesión mientras permanezca inactiva.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">database</span>
                    <div>
                        <h3 class="help-guide-item__title">Información</h3>
                        <p class="help-guide-item__text">
                            La información de la empresa no será eliminada y podrá recuperarse al reactivarla.
                        </p>
                    </div>
                </div>

                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">lightbulb</span>
                    <div>
                        <h3 class="help-guide-item__title">Recomendación</h3>
                        <p class="help-guide-item__text">
                            Antes de desactivar una empresa, verifique que no existan tareas pendientes para sus usuarios.
                        </p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
