@model saas.ViewModel.DevolucionCompra.AnularDevolucionCompraVM

@{
    ViewData["Title"] = "Anular Devolución";
    string urlVolver = ViewData["ReturnUrl"] as string ?? Url.Action("Index", "Compra")!;
}

<div class="container-fluid px-4 py-4">

    <div class="page-header">

        <div class="page-header-content">
            <h1 class="page-title">
                Anular Devolución
            </h1>

            <p class="page-subtitle">
                Compra #@Model.CompraId
            </p>
        </div>

    </div>

    <div class="row g-4 align-items-start">

        <div class="col-lg-8">

            <div class="card form-card">

                <div class="card-body p-4">

                    <div class="alert alert-warning">
                        Esta operación anulará la devolución y reingresará al stock las unidades devueltas.
                    </div>

                    <div class="mb-4">
                        <div class="text-muted small">
                            Total de la devolución
                        </div>

                        <div class="fw-bold fs-5">
                            @Model.Total.ToString("C")
                        </div>
                    </div>

                    <form asp-action="Anular"
                          method="post">

                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@urlVolver" />

                        <input asp-for="DevolucionCompraId"
                               type="hidden" />

                        <div asp-validation-summary="All"
                             class="alert alert-danger"></div>

                        <div class="mb-3">

                            <label asp-for="Motivo"
                                   class="form-label fw-semibold">
                                Motivo de anulación
                            </label>

                            <textarea asp-for="Motivo"
                                      class="form-control"
                                      rows="4"
                                      maxlength="500"
                                      placeholder="Ingrese el motivo de la anulación"></textarea>

                            <span asp-validation-for="Motivo"
                                  class="text-danger"></span>

                        </div>

                        <div class="form-actions">

                            <a asp-controller="Compra"
                               asp-action="Details"
                               asp-route-id="@Model.CompraId"
                               asp-route-returnUrl="@urlVolver"
                               class="btn btn-v-outline">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                Confirmar anulación
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item"><span class="material-symbols-outlined help-guide-item__icon">undo</span><div><h3 class="help-guide-item__title">Stock restituido</h3><p class="help-guide-item__text">Las unidades de la devolución anulada vuelven a incorporarse al inventario.</p></div></div>
                <div class="help-guide-item"><span class="material-symbols-outlined help-guide-item__icon">payments</span><div><h3 class="help-guide-item__title">Impacto financiero</h3><p class="help-guide-item__text">Se revierte el importe pendiente de recuperar asociado a la devolución.</p></div></div>
                <div class="help-guide-item"><span class="material-symbols-outlined help-guide-item__icon">history</span><div><h3 class="help-guide-item__title">Trazabilidad</h3><p class="help-guide-item__text">La devolución original se conserva junto con el motivo de anulación.</p></div></div>
            </div>
        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
