@model VentaConfirmadaVM

@{
    ViewData["Title"] = "Venta confirmada";
}

<main class="container-fluid px-4 pb-4">
    <div class="col-lg-8 col-xl-6 mx-auto pt-4">
        <section class="detail-card p-4 p-md-5 text-center"
                 aria-labelledby="tituloVentaConfirmada">
            <span class="material-symbols-outlined empty-state-icon text-success mb-3"
                  aria-hidden="true">
                check_circle
            </span>

            <h1 id="tituloVentaConfirmada" class="page-title mb-2">
                Venta registrada correctamente
            </h1>

            <p class="text-muted mb-4">
                La venta #@Model.Id fue confirmada y el punto de venta está listo para continuar.
            </p>

            <div class="detail-card bg-light p-3 mb-4">
                <span class="text-caption d-block text-uppercase mb-1">
                    Total de la venta
                </span>
                <strong class="fs-3">@Model.Total.ToString("C")</strong>
            </div>

            <div class="d-grid d-sm-flex justify-content-sm-center gap-2">
                <a asp-action="Create"
                   asp-route-empresaId="@Model.EmpresaId"
                   id="accionNuevaVenta"
                   class="btn btn-v-primary d-inline-flex align-items-center justify-content-center gap-2 px-4">
                    <span class="material-symbols-outlined" aria-hidden="true">point_of_sale</span>
                    Nueva venta
                </a>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   id="accionVerDetalle"
                   class="btn btn-v-outline d-inline-flex align-items-center justify-content-center gap-2 px-4">
                    <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
                    Ver detalle
                </a>
            </div>

            <p class="text-caption text-muted mt-3 mb-0">
                <kbd>Enter</kbd> Nueva venta
                <span class="mx-2" aria-hidden="true">·</span>
                <kbd>D</kbd> Ver detalle
            </p>
        </section>
    </div>
</main>

@section Scripts {
    <script>
        (() => {
            const nuevaVenta = document.getElementById("accionNuevaVenta");
            const verDetalle = document.getElementById("accionVerDetalle");

            // El foco inicial convierte Enter en la acción principal sin
            // reemplazar el comportamiento accesible de los enlaces.
            nuevaVenta?.focus();

            document.addEventListener("keydown", evento => {
                if (evento.repeat ||
                    evento.ctrlKey ||
                    evento.altKey ||
                    evento.metaKey ||
                    evento.key.toLowerCase() !== "d") {
                    return;
                }

                evento.preventDefault();
                verDetalle?.click();
            });
        })();
    </script>
}
