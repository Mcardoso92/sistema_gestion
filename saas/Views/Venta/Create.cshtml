@model VentaCreateVM

@{
    ViewData["Title"] = "Punto de Venta";

    int empresaId = ViewBag.EmpresaId != null
        ? Convert.ToInt32(ViewBag.EmpresaId)
        : 0;

    string empresaNombre = ViewBag.EmpresaNombre?.ToString() ?? "Empresa";
    string cajero = User.Identity?.Name ?? "Usuario";

    bool ventaValida = Model.Detalles.Any() &&
        Model.Detalles.All(d => d.StockSuficiente);
}

<form asp-action="Create" asp-route-empresaId="@empresaId" method="post" id="formVenta">
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <input asp-for="ClienteId" type="hidden" id="clienteId" />
    <input asp-for="ClienteNombre" type="hidden" id="clienteNombre" />
    <main class="container-fluid px-4 pb-3"
          id="puntoVenta"
          data-empresa-id="@empresaId"
          data-buscar-productos-url="@Url.Action("BuscarProductos", "Venta")"
          data-buscar-clientes-url="@Url.Action("BuscarClientes", "Venta")"
          data-ventas-index-url="@Url.Action("Index", "Venta")"
          data-get-cajas-url="@Url.Action("GetCajasPorMedioPago", "Venta")"
          data-get-medios-url="@Url.Action("GetMediosPagoPorCaja", "Venta")">

        <!-- Encabezado -->
        <div class="card-custom p-3 mb-3 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center">
            <div>
                <a asp-action="Index" id="btnVolverVentas" class="d-inline-flex align-items-center gap-1 text-muted text-decoration-none small mb-2">
                    <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
                    Volver a Ventas
                </a>
                <h1 class="h4 fw-bold text-dark mb-1">Punto de Venta</h1>
                <p class="text-muted small mb-0">@empresaNombre</p>
            </div>

            <div class="d-flex flex-wrap gap-3 align-items-center badge-info-custom rounded p-2 mt-3 mt-sm-0">
                <div class="d-flex align-items-center gap-1 small">
                    <span class="material-symbols-outlined" style="font-size: 18px;">person</span>
                    <span>
                        Cajero:
                        <strong class="text-dark">@cajero</strong>
                    </span>
                </div>

                <div class="vr d-none d-sm-block"></div>

                <div class="d-flex align-items-center gap-1 small">
                    <span class="material-symbols-outlined" style="font-size: 18px;">calendar_today</span>
                    <span>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
        </div>

        <!-- Contenido principal -->
        <div class="row g-3">
            <!-- Cliente, productos y carrito -->
            <div class="col-lg-8 d-flex flex-column gap-3">
                <div class="row g-3">
                    <!-- Cliente -->
                    <div class="col-md-6">
                        <div class="card-custom p-3 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label small fw-bold text-muted text-uppercase mb-0">
                                    Datos del Cliente
                                </label>

                                <button type="button"
                                        id="btnBuscarCliente"
                                        class="btn btn-link text-primary-veltika p-0 text-decoration-none small fw-medium d-flex align-items-center gap-1">
                                    <span class="material-symbols-outlined" style="font-size: 16px;">search</span>
                                    Buscar cliente
                                </button>
                            </div>

                            <div class="d-flex align-items-center gap-3 bg-light p-2 rounded border">
                                <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center"
                                     style="width: 40px; height: 40px;">
                                    <span class="material-symbols-outlined text-muted">person_outline</span>
                                </div>

                                <div class="flex-grow-1">
                                    <div id="clienteNombreVisible"
                                         class="fw-medium text-dark small mb-0">
                                        @Model.ClienteNombre
                                    </div>

                                    <div id="clienteDetalleVisible"
                                         class="text-muted"
                                         style="font-size: 0.75rem;">
                                        Venta sin cliente registrado
                                    </div>
                                </div>

                                <button type="button"
                                        id="btnQuitarCliente"
                                        class="btn btn-link text-muted p-1 d-none"
                                        title="Quitar cliente">
                                    <span class="material-symbols-outlined">close</span>
                                </button>
                            </div>

                            <!-- Buscador de clientes -->
                            <div id="panelBusquedaCliente" class="mt-3 d-none">
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <span class="material-symbols-outlined text-muted">person_search</span>
                                    </span>

                                    <input id="buscarCliente"
                                           class="form-control bg-light"
                                           type="text"
                                           autocomplete="off"
                                           placeholder="Nombre, documento o email..." />
                                </div>

                                <div id="resultadosClientes"
                                     class="list-group mt-2 d-none">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Buscador de productos -->
                    <div class="col-md-6">
                        <div class="card-custom p-3 h-100">
                            <label for="buscarProducto"
                                   class="form-label small fw-bold text-muted text-uppercase mb-2">
                                Buscar Producto
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <span class="material-symbols-outlined text-muted">barcode_scanner</span>
                                </span>

                                <input id="buscarProducto"
                                       class="form-control bg-light"
                                       type="text"
                                       autocomplete="off"
                                       placeholder="Código de barras o nombre..." />

                                <button type="button"
                                        id="btnBuscarProducto"
                                        class="btn btn-primary-veltika d-flex align-items-center">
                                    <span class="material-symbols-outlined">search</span>
                                </button>
                            </div>

                            <div id="resultadosProductos"
                                 class="list-group mt-2 d-none">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Carrito -->
                <div class="table-container d-flex flex-column">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3 py-3 small fw-bold text-muted text-uppercase">
                                        Producto
                                    </th>
                                    <th class="py-3 small fw-bold text-muted text-uppercase text-end">
                                        Precio
                                    </th>
                                    <th class="py-3 small fw-bold text-muted text-uppercase text-center">
                                        Cantidad
                                    </th>
                                    <th class="py-3 small fw-bold text-muted text-uppercase text-center">
                                        Stock
                                    </th>
                                    <th class="py-3 small fw-bold text-muted text-uppercase text-end">
                                        Subtotal
                                    </th>
                                    <th class="pe-3 py-3 small fw-bold text-muted text-uppercase text-center">
                                        Acción
                                    </th>
                                </tr>
                            </thead>

                            <tbody id="carritoVenta">
                                @if (!Model.Detalles.Any())
                                {
                                    <tr id="carritoVacio">
                                        <td colspan="6" class="text-center py-5">
                                            <span class="material-symbols-outlined text-muted mb-2"
                                                  style="font-size: 42px;">
                                                shopping_cart
                                            </span>

                                            <div class="fw-medium text-dark">
                                                El carrito está vacío
                                            </div>

                                            <div class="small text-muted">
                                                Busque o escanee un producto para comenzar la venta.
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @for (int i = 0; i < Model.Detalles.Count; i++)
                                    {
                                        var detalle = Model.Detalles[i];

                                        <tr class="@(!detalle.StockSuficiente ? "row-error" : "")"
                                            data-producto-id="@detalle.ProductoId">

                                            <td class="ps-3">
                                                <input type="hidden"
                                                       name="Detalles[@i].ProductoId"
                                                       value="@detalle.ProductoId" />

                                                <input type="hidden"
                                                       name="Detalles[@i].ProductoNombre"
                                                       value="@detalle.ProductoNombre" />

                                                <input type="hidden"
                                                       name="Detalles[@i].CodigoBarra"
                                                       value="@detalle.CodigoBarra" />

                                                <input type="hidden"
                                                       name="Detalles[@i].PrecioUnitario"
                                                       value="@detalle.PrecioUnitario" />

                                                <input type="hidden"
                                                       name="Detalles[@i].StockDisponible"
                                                       value="@detalle.StockDisponible" />

                                                <input type="hidden"
                                                       name="Detalles[@i].Subtotal"
                                                       value="@detalle.Subtotal" />

                                                <input type="hidden"
                                                       name="Detalles[@i].StockSuficiente"
                                                       value="@detalle.StockSuficiente.ToString().ToLower()" />

                                                <div class="d-flex align-items-center gap-1">
                                                    @if (!detalle.StockSuficiente)
                                                    {
                                                        <span class="material-symbols-outlined text-danger"
                                                              style="font-size: 16px;">
                                                            warning
                                                        </span>
                                                    }

                                                <div class="fw-medium text-dark small">
                                                    @detalle.ProductoNombre
                                                </div>
                                            </div>

                                            <div class="@(!detalle.StockSuficiente ? "text-danger" : "text-muted") font-monospace"
                                                 style="font-size: 0.7rem;">
                                                @(string.IsNullOrWhiteSpace(detalle.CodigoBarra)
                                                                                            ? "Sin código de barras"
                                                                                            : $"Código: {detalle.CodigoBarra}")
                                        </div>

                                        @if (!detalle.StockSuficiente)
                                                {
                                                    <div class="text-danger mt-1"
                                                         style="font-size: 0.7rem;">
                                                        Stock disponible: @detalle.StockDisponible
                                                        (Solicitado: @detalle.Cantidad)
                                                    </div>
                                                }
                                            </td>

                                            <td class="text-end fw-medium small">
                                                @detalle.PrecioUnitario.ToString("C")
                                            </td>

                                            <td class="text-center">
                                                <div class="qty-group">
                                                    <button type="button"
                                                            class="btn btn-link text-muted btn-quantity btn-disminuir">
                                                        <span class="material-symbols-outlined"
                                                              style="font-size: 16px;">
                                                            remove
                                                        </span>
                                                    </button>

                                                    <input name="Detalles[@i].Cantidad"
                                                           class="input-quantity small fw-medium border-start border-end"
                                                           type="number"
                                                           min="1"
                                                           value="@detalle.Cantidad" />

                                                    <button type="button"
                                                            class="btn btn-link text-muted btn-quantity btn-aumentar">
                                                        <span class="material-symbols-outlined"
                                                              style="font-size: 16px;">
                                                            add
                                                        </span>
                                                    </button>
                                                </div>
                                            </td>

                                            <td class="text-center small">
                                                @detalle.StockDisponible
                                            </td>

                                            <td class="text-end fw-semibold small">
                                                @detalle.Subtotal.ToString("C")
                                            </td>

                                            <td class="pe-3 text-center">
                                                <button type="button"
                                                        class="btn btn-link text-danger p-1 btn-eliminar-producto"
                                                        title="Quitar producto">
                                                    <span class="material-symbols-outlined">delete</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Resumen -->
            <div class="col-lg-4 d-flex flex-column">
                <aside class="summary-panel flex-grow-1">
                    <div class="p-4 flex-grow-1 d-flex flex-column">
                        <h3 class="h5 fw-semibold mb-4 d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined">receipt_long</span>
                            Resumen de Venta
                        </h3>

                        <div class="mb-4 text-white-50 small">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Productos diferentes</span>
                                <span id="totalLineas"
                                      class="fw-medium text-white">
                                    @Model.TotalLineas
                                </span>
                            </div>

                            <div class="d-flex justify-content-between">
                                <span>Total de unidades</span>
                                <span id="totalUnidades"
                                      class="fw-medium text-white">
                                    @Model.TotalUnidades
                                </span>
                            </div>
                        </div>

                        <div class="mt-auto summary-total p-3 text-center">
                            <div class="small text-white-50 text-uppercase fw-semibold mb-1"
                                 style="letter-spacing: 0.1em;">
                                Total
                            </div>

                            <div id="totalVenta"
                                 class="display-5 fw-bold text-white mb-0"
                                 style="letter-spacing: -0.02em;">
                                @Model.Total.ToString("C")
                            </div>
                        </div>
                        <div class="mt-4">

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h4 class="small fw-bold text-white text-uppercase mb-0">
                                    Pagos
                                </h4>

                                <button type="button"
                                        id="btnAgregarPago"
                                        class="btn btn-sm btn-light">
                                    + Agregar pago
                                </button>
                            </div>

                            <div id="pagosContainer"
                                 class="d-flex flex-column gap-2">

                                @for (int i = 0; i < Model.Pagos.Count; i++)
                                {
                                    <div class="pago-item bg-white text-dark rounded p-2"
                                         data-index="@i">

                                        <div class="row g-2">

                                            <div class="col-12">

                                                <select name="Pagos[@i].MedioPagoId"
                                                        class="form-select form-select-sm medio-pago-select">

                                                    <option value="">
                                                        Medio de pago
                                                    </option>

                                                    @foreach (var medio in Model.MediosPagoDisponibles)
                                                    {
                                                        <option value="@medio.Id"
                                                                data-tipo="@((int)medio.Tipo)"
                                                                selected="@(Model.Pagos[i].MedioPagoId == medio.Id)">
                                                            @medio.Nombre
                                                        </option>
                                                    }

                                                </select>

                                            </div>

                                            <div class="col-12">

                                                <select name="Pagos[@i].CajaId"
                                                        class="form-select form-select-sm caja-pago-select">

                                                    <option value="">
                                                        Caja
                                                    </option>

                                                    @foreach (var caja in Model.CajasDisponibles)
                                                    {
                                                        <option value="@caja.Id"
                                                                selected="@(Model.Pagos[i].CajaId == caja.Id)">
                                                            @caja.Nombre
                                                        </option>
                                                    }

                                                </select>

                                            </div>

                                            <div class="col-9">

                                                <input name="Pagos[@i].Importe"
                                                       value="@Model.Pagos[i].Importe"
                                                       type="number"
                                                       min="0.01"
                                                       step="0.01"
                                                       class="form-control form-control-sm pago-importe"
                                                       placeholder="Importe" />

                                            </div>

                                            <div class="col-12 bloque-efectivo d-none">

                                                <div class="row g-2">

                                                    <div class="col-6">

                                                        <label class="form-label small mb-1">
                                                            Recibido
                                                        </label>

                                                        <input type="number"
                                                               name="Pagos[@i].ImporteRecibido"
                                                               value="@Model.Pagos[i].ImporteRecibido"
                                                               min="0"
                                                               step="0.01"
                                                               class="form-control form-control-sm efectivo-recibido"
                                                               placeholder="0,00" />

                                                    </div>

                                                    <div class="col-6">

                                                        <label class="form-label small mb-1">
                                                            Vuelto
                                                        </label>

                                                        <div class="form-control form-control-sm bg-light efectivo-vuelto">
                                                            $0,00
                                                        </div>

                                                    </div>

                                                </div>

                                            </div>

                                            <div class="col-3 d-grid">

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger btn-eliminar-pago">
                                                    ×
                                                </button>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                            <div class="mt-3 pt-3 border-top border-secondary">

                                <div class="d-flex justify-content-between small text-white-50 mb-1">
                                    <span>Total pagado</span>
                                    <span id="totalPagado" class="text-white fw-semibold">
                                        @Model.TotalPagado.ToString("C")
                                    </span>
                                </div>

                                <div class="d-flex justify-content-between small text-white-50">
                                    <span>Saldo pendiente</span>
                                    <span id="saldoPendiente" class="text-white fw-semibold">
                                        @Model.SaldoPendiente.ToString("C")
                                    </span>
                                </div>

                                <div id="alertaClientePendiente"
                                     class="alert alert-warning mt-2 mb-0 py-2 px-2 small d-none">
                                    Para dejar saldo pendiente debe seleccionar un cliente.
                                </div>

                                <div id="alertaPagoInvalido"
                                     class="alert alert-warning mt-2 mb-0 py-2 px-2 small d-none">
                                    Complete el medio, la caja y los importes del pago.
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- Acciones -->
                    <div class="p-3 bg-white border-top">
                        @if (ventaValida)
                        {
                            <button type="submit"
                                    id="btnConfirmarVenta"
                                    class="btn btn-primary-veltika w-100 py-3 mb-2 fw-semibold d-flex align-items-center justify-content-center gap-2">
                                <span class="material-symbols-outlined">payments</span>
                                Confirmar Venta
                            </button>
                        }
                        else
                        {
                            <button type="submit"
                                    id="btnConfirmarVenta"
                                    class="btn btn-primary-veltika w-100 py-3 mb-2 fw-semibold d-flex align-items-center justify-content-center gap-2"
                                    disabled>
                                <span class="material-symbols-outlined">payments</span>
                                Confirmar Venta
                            </button>
                        }

                        <button type="button"
                                id="btnCancelarVenta"
                                class="btn btn-outline-danger w-100 py-2 fw-medium d-flex align-items-center justify-content-center gap-2">
                            <span class="material-symbols-outlined" style="font-size: 18px;">cancel</span>
                            Cancelar Venta
                        </button>
                    </div>
                </aside>
            </div>
        </div>
    </main>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    @{
        string mediosPagoOptions = string.Join(
            "",
            Model.MediosPagoDisponibles.Select(m =>
                $"<option value=\"{m.Id}\" data-tipo=\"{(int)m.Tipo}\">{System.Net.WebUtility.HtmlEncode(m.Nombre)}</option>"));
    }

    <script>
        window.veltikaMediosPagoOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mediosPagoOptions));
    </script>

    <script src="~/js/venta-pos.js" asp-append-version="true"></script>
}
