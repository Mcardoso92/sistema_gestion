@using saas.Models.Enums
@model VentaDetailsVM

@{
    ViewData["Title"] = "Detalle de Venta";
    string? returnUrl = ViewData["ReturnUrl"] as string;
    string urlVolver = returnUrl ?? Url.Action("Index", "Venta")!;
}

<main class="container-fluid px-4 pb-4">

    <!-- Encabezado -->
    <div class="page-header">
        <div class="page-header-content">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Dashboard" asp-action="Index">
                            Dashboard
                        </a>
                    </li>

                    <li class="breadcrumb-item">
                        <a href="@urlVolver">
                            Ventas
                        </a>
                    </li>

                    <li class="breadcrumb-item active"
                        aria-current="page">
                        Detalle
                    </li>
                </ol>
            </nav>

            <div class="d-flex align-items-end gap-3">
                <h1 class="page-title mb-0">
                    Detalle de Venta
                </h1>

                <span class="h5 text-muted mb-0 pb-1">
                    #@Model.Id
                </span>
            </div>
        </div>

        <div class="page-actions">
            <a href="@urlVolver"
               class="btn btn-v-outline">

                <span class="material-symbols-outlined icon-sm">
                    arrow_back
                </span>

                Volver al Listado
            </a>

            <a asp-action="Create"
               asp-route-empresaId="@Model.EmpresaId"
               class="btn btn-create-action">
                <span class="material-symbols-outlined">point_of_sale</span>
                <span>Nueva venta</span>
            </a>
            @if (Model.Estado && Model.TotalCobrado > Model.TotalReintegrado)
            {
                <a asp-controller="ReintegroVenta"
                   asp-action="Registrar"
                   asp-route-ventaId="@Model.Id"
                   class="btn btn-outline-warning py-2 fw-medium d-flex align-items-center gap-2 small">

                    <span class="material-symbols-outlined icon-sm">
                        assignment_return
                    </span>

                    Registrar reintegro
                </a>
            }
            @if (Model.Estado)
            {
                <form asp-action="Anular" asp-route-id="@Model.Id" method="post" class="d-inline"
                      onsubmit="return confirm('¿Está seguro de que desea anular esta venta? El stock de los productos será restaurado.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@urlVolver" />

                    <button type="submit" class="btn btn-outline-danger py-2 fw-medium d-flex align-items-center gap-2 small">
                        <span class="material-symbols-outlined icon-sm">cancel</span>
                        Anular Venta
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Layout -->
    <div class="row g-4">        
        <div class="col-lg-8 d-flex flex-column gap-4">
            <!-- Artículos -->
            <div class="table-card d-flex flex-column flex-grow-1 mb-0">

                <div class="px-4 py-3 border-bottom bg-light d-flex justify-content-between align-items-center">
                    <h2 class="h5 fw-bold text-dark mb-0">
                        Artículos de la Venta
                    </h2>

                    <span class="badge bg-secondary bg-opacity-10 text-secondary border">
                        @Model.TotalLineas @(Model.TotalLineas == 1 ? "producto" : "productos")
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 py-3 small fw-bold text-muted text-uppercase">
                                    Producto
                                </th>

                                <th class="py-3 small fw-bold text-muted text-uppercase">
                                    Código
                                </th>

                                <th class="py-3 small fw-bold text-muted text-uppercase text-end">
                                    Precio Unit.
                                </th>

                                <th class="py-3 small fw-bold text-muted text-uppercase text-center">
                                    Cant.
                                </th>

                                <th class="pe-4 py-3 small fw-bold text-muted text-uppercase text-end">
                                    Subtotal
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var detalle in Model.Detalles)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">

                                            <div class="media-thumbnail media-thumbnail--sm bg-secondary bg-opacity-10 rounded border">

                                                <span class="material-symbols-outlined text-muted">
                                                    inventory_2
                                                </span>
                                            </div>

                                            <div>
                                                <div class="fw-medium text-dark">
                                                    @detalle.ProductoNombre
                                                </div>
                                            </div>

                                        </div>
                                    </td>

                                    <td class="py-3 text-muted small">
                                        @(string.IsNullOrWhiteSpace(detalle.CodigoBarra)
                                            ? "Sin código"
                                            : detalle.CodigoBarra)
                                    </td>

                                    <td class="py-3 text-end fw-medium small">
                                        @detalle.PrecioUnitario.ToString("C")
                                    </td>

                                    <td class="py-3 text-center">
                                        @detalle.Cantidad
                                    </td>

                                    <td class="pe-4 py-3 text-end fw-semibold">
                                        @detalle.Subtotal.ToString("C")
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

                <div class="px-4 py-3 border-top bg-light d-flex justify-content-end">
                    <div class="small text-muted">
                        Total de unidades:
                        <strong class="text-dark">
                            @Model.TotalUnidades
                        </strong>
                    </div>
                </div>

            </div>
            <!-- Cobros -->
            <div class="table-card d-flex flex-column flex-grow-1 mb-0">

                <div class="px-4 py-3 border-bottom bg-light d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">

                    <div>
                        <h2 class="h5 fw-bold text-dark mb-1">
                            Cobros
                        </h2>

                        <div class="small text-muted">
                            Pagos registrados para esta venta.
                        </div>
                    </div>

                    @if (Model.Estado && Model.SaldoPendiente > 0)
                    {
                        <a asp-controller="CobroVenta"
                           asp-action="Registrar"
                           asp-route-ventaId="@Model.Id"
                           class="btn btn-v-primary btn-sm fw-medium">

                            <span class="material-symbols-outlined align-middle me-1 icon-sm">
                                payments
                            </span>

                            Registrar cobro
                        </a>
                    }

                </div>

                @if (Model.Cobros.Any())
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4 py-3 small fw-bold text-muted text-uppercase">
                                        Fecha
                                    </th>

                                    <th class="py-3 small fw-bold text-muted text-uppercase">
                                        Medio de pago
                                    </th>

                                    <th class="py-3 small fw-bold text-muted text-uppercase">
                                        Caja
                                    </th>

                                    <th class="py-3 small fw-bold text-muted text-uppercase">
                                        Usuario
                                    </th>

                                    <th class="py-3 small fw-bold text-muted text-uppercase text-center">
                                        Estado
                                    </th>

                                    <th class="pe-4 py-3 small fw-bold text-muted text-uppercase text-end">
                                        Importe
                                    </th>
                                    <th class="pe-4 py-3 small fw-bold text-muted text-uppercase text-end">
                                        Acciones
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var cobro in Model.Cobros)
                                {
                                    <tr>

                                        <td class="ps-4 py-3 small">
                                            @FechaHora.ConvertirAHoraLocal(cobro.Fecha).ToString("dd/MM/yyyy HH:mm")
                                        </td>

                                        <td class="py-3">
                                            @cobro.MedioPagoNombre
                                        </td>

                                        <td class="py-3">
                                            @cobro.CajaNombre
                                        </td>

                                        <td class="py-3 small">
                                            @cobro.UsuarioNombre
                                        </td>

                                        <td class="py-3 text-center">

                                            @if (cobro.Estado == EstadoCobro.Activo)
                                            {
                                                <span class="status-badge status-active">
                                                    Activo
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-cancelled">
                                                    Anulado
                                                </span>
                                            }

                                        </td>

                                        <td class="pe-4 py-3 text-end fw-semibold">
                                            @cobro.Importe.ToString("C")
                                        </td>
                                        <td class="pe-4 py-3 text-end">

                                            @if (Model.Estado &&
                                                                                cobro.Estado == EstadoCobro.Activo)
                                            {
                                                <a asp-controller="CobroVenta"
                                                   asp-action="Anular"
                                                   asp-route-id="@cobro.Id"
                                                   asp-route-returnUrl="@urlVolver"
                                                   class="btn btn-sm btn-outline-danger">

                                                    <span class="material-symbols-outlined align-middle icon-sm">
                                                        undo
                                                    </span>

                                                    Anular
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">
                                                    —
                                                </span>
                                            }

                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="p-4 text-center">

                        <span class="material-symbols-outlined text-muted mb-2 icon-lg">
                            payments
                        </span>

                        <div class="text-muted">
                            Esta venta todavía no tiene cobros registrados.
                        </div>

                    </div>
                }

            </div>
            <!-- Reintegros -->
            <div class="table-card d-flex flex-column flex-grow-1 mb-0">

                <div class="px-4 py-3 border-bottom bg-light d-flex justify-content-between align-items-center">

                    <div>
                        <h2 class="h5 fw-bold text-dark mb-1">
                            Reintegros
                        </h2>

                        <div class="small text-muted">
                            Devoluciones registradas para esta venta.
                        </div>
                    </div>

                    <div class="text-end">

                        <div class="small text-muted">
                            Total reintegrado
                        </div>

                        <div class="fw-bold">
                            @Model.TotalReintegrado.ToString("C")
                        </div>

                        <div class="small text-muted mt-1">
                            Disponible para reintegro
                        </div>

                        <div class="fw-semibold">
                            @Model.PendienteReintegrar.ToString("C")
                        </div>

                    </div>

                </div>

                @if (Model.Reintegros.Any())
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th class="ps-4 py-3 small fw-bold text-muted text-uppercase">
                                        Fecha
                                    </th>

                                    <th class="py-3 small fw-bold text-muted text-uppercase">
                                        Medio
                                    </th>

                                    <th class="py-3 small fw-bold text-muted text-uppercase">
                                        Caja
                                    </th>

                                    <th class="py-3 small fw-bold text-muted text-uppercase text-center">
                                        Estado
                                    </th>

                                    <th class="pe-4 py-3 small fw-bold text-muted text-uppercase text-end">
                                        Importe
                                    </th>
                                    <th class="pe-4 py-3 small fw-bold text-muted text-uppercase text-end">
                                        Acciones
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var reintegro in Model.Reintegros)
                                {
                                    <tr>

                                        <td class="ps-4 py-3 small">
                                            @FechaHora.ConvertirAHoraLocal(reintegro.Fecha).ToString("dd/MM/yyyy HH:mm")
                                        </td>

                                        <td class="py-3">
                                            @reintegro.MedioPagoNombre
                                        </td>

                                        <td class="py-3">
                                            @reintegro.CajaNombre
                                        </td>

                                        <td class="py-3 text-center">

                                            @if (reintegro.Estado == EstadoReintegro.Activo)
                                            {
                                                <span class="status-badge status-active">
                                                    Activo
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-cancelled">
                                                    Anulado
                                                </span>
                                            }

                                        </td>

                                        <td class="pe-4 py-3 text-end fw-semibold">
                                            @reintegro.Importe.ToString("C")
                                        </td>
                                        <td class="pe-4 py-3 text-end">

                                            @if (Model.Estado &&
                                                                                reintegro.Estado == EstadoReintegro.Activo)
                                            {
                                                <a asp-controller="ReintegroVenta"
                                                   asp-action="Anular"
                                                   asp-route-id="@reintegro.Id"
                                                   asp-route-returnUrl="@urlVolver"
                                                   class="btn btn-sm btn-outline-danger">

                                                    <span class="material-symbols-outlined align-middle icon-sm">
                                                        undo
                                                    </span>

                                                    Anular
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">
                                                    —
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="p-4 text-center">

                        <span class="material-symbols-outlined text-muted mb-2 icon-lg">
                            assignment_return
                        </span>

                        <div class="text-muted">
                            Esta venta todavía no tiene reintegros registrados.
                        </div>

                    </div>
                }

            </div>
        </div>

        <!-- Resumen -->
        <div class="col-lg-4 d-flex flex-column gap-4">

            <!-- Resumen financiero -->
            <div class="summary-panel p-4">

                <h3 class="small fw-bold text-white-50 text-uppercase mb-4">
                    Resumen de Venta
                </h3>

                <div class="text-white-50 small mb-4">

                    <div class="d-flex justify-content-between mb-2">
                        <span>Productos diferentes</span>

                        <span class="fw-medium text-white">
                            @Model.TotalLineas
                        </span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span>Total de unidades</span>

                        <span class="fw-medium text-white">
                            @Model.TotalUnidades
                        </span>
                    </div>

                </div>

                <div class="summary-total p-3 mb-3">

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-white-50">
                            Total venta
                        </span>

                        <span class="fw-bold text-white">
                            @Model.Total.ToString("C")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-white-50">
                            Total cobrado
                        </span>

                        <span class="fw-bold text-white">
                            @Model.TotalCobrado.ToString("C")
                        </span>
                    </div>

                    <div class="border-top border-light border-opacity-25 pt-2">

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small text-white-50">
                                Saldo pendiente
                            </span>

                            <span class="fs-5 fw-bold text-white">
                                @Model.SaldoPendiente.ToString("C")
                            </span>
                        </div>

                    </div>

                </div>

                @if (Model.SaldoPendiente <= 0)
                {
                    <div class="text-center">
                        <span class="status-badge status-paid">
                            Venta totalmente cobrada
                        </span>
                    </div>
                }
                else
                {
                    <div class="text-center">
                        <span class="status-badge status-pending">
                            Saldo pendiente
                        </span>
                    </div>
                }

            </div>

            <!-- Cliente -->
            <div class="detail-card p-4">

                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <span class="material-symbols-outlined text-brand">
                        person
                    </span>

                    <h3 class="h6 fw-bold text-dark mb-0">
                        Cliente
                    </h3>
                </div>

                <div class="d-flex align-items-start gap-3">

                    <div class="avatar avatar--md bg-primary bg-opacity-10 text-brand">

                        <span class="material-symbols-outlined">
                            person
                        </span>

                    </div>

                    <div>
                        <div class="fw-medium text-dark mb-1">
                            @Model.ClienteNombre
                        </div>

                        @if (Model.ClienteDocumento != null)
                        {
                            <div class="small text-muted d-flex align-items-center gap-1 mb-1">
                                <span class="material-symbols-outlined icon-xs">
                                    badge
                                </span>

                                @Model.ClienteDocumento
                            </div>
                        }

                        @if (Model.ClienteEmail != null)
                        {
                            <div class="small text-muted d-flex align-items-center gap-1">
                                <span class="material-symbols-outlined icon-xs">
                                    mail
                                </span>

                                @Model.ClienteEmail
                            </div>
                        }

                        @if (Model.ClienteDocumento == null &&
                             Model.ClienteEmail == null)
                        {
                            <div class="small text-muted">
                                Venta sin cliente registrado
                            </div>
                        }
                    </div>

                </div>

            </div>

            <!-- Información -->
            <div class="detail-card p-4">

                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <span class="material-symbols-outlined text-brand">
                        info
                    </span>

                    <h3 class="h6 fw-bold text-dark mb-0">
                        Información
                    </h3>
                </div>

                <div class="d-flex flex-column gap-2">

                    <div class="d-flex justify-content-between align-items-start">

                        <div class="small fw-medium text-muted d-flex align-items-center gap-1">
                            <span class="material-symbols-outlined icon-xs">
                                calendar_today
                            </span>

                            Fecha y Hora
                        </div>

                        <div class="small text-dark text-end">
                            @FechaHora.ConvertirAHoraLocal(Model.Fecha).ToString("dd/MM/yyyy")
                            <br />

                            <span class="text-muted">
                                @FechaHora.ConvertirAHoraLocal(Model.Fecha).ToString("HH:mm:ss")
                            </span>
                        </div>

                    </div>

                    <div class="d-flex justify-content-between align-items-start pt-2 border-top">

                        <div class="small fw-medium text-muted d-flex align-items-center gap-1">
                            <span class="material-symbols-outlined icon-xs">
                                person
                            </span>

                            Usuario
                        </div>

                        <div class="small text-dark fw-medium text-end">
                            @Model.UsuarioNombre
                        </div>

                    </div>

                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <div class="d-flex justify-content-between align-items-start pt-2 border-top">

                            <div class="small fw-medium text-muted d-flex align-items-center gap-1">
                                <span class="material-symbols-outlined icon-xs">
                                    business
                                </span>

                                Empresa
                            </div>

                            <div class="small text-dark fw-medium text-end">
                                @Model.EmpresaNombre
                            </div>

                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-start pt-2 border-top">

                        <div class="small fw-medium text-muted d-flex align-items-center gap-1">
                            <span class="material-symbols-outlined icon-xs">
                                check_circle
                            </span>

                            Estado
                        </div>

                        <div class="small text-end">
                            @if (Model.Estado)
                            {
                                <span class="status-badge status-completed">
                                    Completada
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-cancelled">
                                    Anulada
                                </span>
                            }
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</main>
