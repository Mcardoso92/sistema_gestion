@model IEnumerable<Producto>

@{
    ViewData["Title"] = "Productos";

    string estadoSeleccionado = ViewBag.Estado?.ToString() ?? "activos";
    int? categoriaSeleccionada = ViewBag.CategoriaId as int?;
    int? empresaSeleccionada = ViewBag.EmpresaId as int?;
    string? busqueda = ViewBag.Busqueda?.ToString();

    IEnumerable<Categoria> categorias = ViewBag.Categorias as IEnumerable<Categoria>
        ?? Enumerable.Empty<Categoria>();

    IEnumerable<Empresa> empresas = ViewBag.Empresas as IEnumerable<Empresa>
        ?? Enumerable.Empty<Empresa>();
}

<main class="flex-grow-1 py-5 container-fluid px-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-semibold mb-1">Gestión de Productos</h1>
            <p class="text-secondary mb-0">Administra tu inventario, precios y niveles de stock en tiempo real.</p>
        </div>
        <div class="d-flex gap-2">
            <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2 py-2 px-3 shadow-sm rounded-1"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">

                    <span class="material-symbols-outlined fs-5">analytics</span>
                    <span class="fw-medium small">Generar reporte</span>
                </button>

                <ul class="dropdown-menu">
                    <li>
                        <a asp-controller="Reporte"
                           asp-action="Stock"
                           asp-route-empresaId="@empresaSeleccionada"
                           asp-route-categoriaId="@categoriaSeleccionada"
                           class="dropdown-item">
                            Reporte de stock
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Reporte"
                           asp-action="Productos"
                           asp-route-empresaId="@empresaSeleccionada"
                           asp-route-categoriaId="@categoriaSeleccionada"
                           asp-route-estado="@estadoSeleccionado"
                           asp-route-busqueda="@busqueda"
                           class="dropdown-item">
                            Reporte de productos
                        </a>
                    </li>
                </ul>
            </div>
            <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 py-2 px-3 shadow-sm rounded-1">
                <span class="material-symbols-outlined fs-5">add_circle</span>
                <span class="fw-medium small">Nuevo Producto</span>
            </a>
        </div>
    </div>
    <!-- Filter Bar -->
    <div class="card mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label for="estado" class="form-label fw-semibold">Estado</label>

                    <select id="estado" name="estado" class="form-select">
                        <option value="activos" selected="@(estadoSeleccionado == "activos")">Activos</option>
                        <option value="inactivos" selected="@(estadoSeleccionado == "inactivos")">Inactivos</option>
                        <option value="todos" selected="@(estadoSeleccionado == "todos")">Todos</option>
                    </select>
                </div>

                @if (User.IsInRole("SuperAdmin"))
                {
                    <div class="col-md-2">
                        <label for="empresaId" class="form-label fw-semibold">Empresa</label>
                        <select id="empresaId" name="empresaId" class="form-select">
                            <option value="">Todas las empresas</option>
                            @foreach (var empresa in empresas)
                            {
                                <option value="@empresa.Id" selected="@(empresaSeleccionada == empresa.Id)">
                                    @empresa.Nombre
                                </option>
                            }
                        </select>
                    </div>
                }

                <div class="col-md-2">
                    <label for="categoriaId" class="form-label fw-semibold">Categoría</label>
                    <select id="categoriaId" name="categoriaId" class="form-select">
                        <option value="">Todas las categorías</option>
                        @foreach (var categoria in categorias)
                        {
                            <option value="@categoria.Id" selected="@(categoriaSeleccionada == categoria.Id)">
                                @categoria.Nombre
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="busqueda" class="form-label fw-semibold">Buscar producto</label>
                    <div class="search-input-wrapper">
                        <span class="material-symbols-outlined">search</span>
                        <input id="busqueda" name="busqueda" value="@busqueda" class="form-control form-control-md" placeholder="Buscar por nombre o código de barras..." type="text" />
                    </div>
                </div>

                <div class="col-md-auto">
                    <button type="submit" class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3">
                        <span class="material-symbols-outlined fs-5">search</span>
                        <span class="small fw-medium">Buscar</span>
                    </button>
                </div>

                @if (estadoSeleccionado != "activos" || categoriaSeleccionada.HasValue || empresaSeleccionada.HasValue || !string.IsNullOrWhiteSpace(busqueda))
                {
                    <div class="col-md-auto">
                        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                    </div>
                }
            </form>
        </div>
    </div>
    <!-- Data Table Card -->
    <div class="card shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="px-4 py-3 border-0">ID</th>
                        <th class="px-4 py-3 border-0">Producto</th>
                        <th class="px-4 py-3 border-0">Categoría</th>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <th class="px-4 py-3 border-0">Empresa</th>
                        }
                        <th class="px-4 py-3 border-0 text-end">Precio Venta</th>
                        <th class="px-4 py-3 border-0 text-center">Stock</th>
                        <th class="px-4 py-3 border-0 text-center">Reposición</th>
                        <th class="px-4 py-3 border-0 text-center">Situación Stock</th>
                        <th class="px-4 py-3 border-0 text-center">Estado</th>
                        <th class="px-4 py-3 border-0 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(User.IsInRole("SuperAdmin") ? 10 : 9)" class="text-center text-secondary py-5">
                                No se encontraron productos para los criterios seleccionados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var producto in Model)
                        {
                            <tr>
                                <td class="px-4 py-3">@producto.Id</td>
                                <td class="px-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(producto.UrlImagen))
                                        {
                                            <div class="product-img-wrapper">
                                                <img alt="@producto.Nombre" src="@producto.UrlImagen" />
                                            </div>
                                        }
                                        <div>
                                            <a asp-action="Details" asp-route-id="@producto.Id" class="product-name d-block text-decoration-none">@producto.Nombre</a>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-3">@producto.Categoria.Nombre</td>
                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <td class="px-4 py-3">@producto.Empresa.Nombre</td>
                                }
                                <td class="px-4 py-3 text-end fw-semibold">@producto.PrecioVenta.ToString("C")</td>
                                <td class="px-4 py-3 text-center">
                                    <span class="badge bg-light text-dark border p-2 rounded-1">@producto.Stock</span>
                                </td>
                                <td class="px-4 py-3 text-center small text-secondary">@producto.PuntoReposicion</td>
                                <td class="px-4 py-3 text-center">
                                    @if (producto.Stock <= producto.PuntoReposicion)
                                    {
                                        <span class="badge-status status-inactivo">
                                            <span class="dot"></span>Bajo Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status status-activo">
                                            <span class="dot"></span>Normal
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-center">
                                    @if (producto.Estado)
                                    {
                                        <span class="badge-status status-activo">
                                            <span class="dot"></span>
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status status-inactivo">
                                            <span class="dot"></span>
                                            Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <a asp-action="Details" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                                    <a asp-action="Edit" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                                    @if (producto.Estado)
                                    {
                                        <a asp-action="Delete" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-danger">Desactivar</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination Footer (Identical to SCREEN_11) -->
        <div class="card-footer bg-light border-top-0 px-4 py-3">
            <span class="small text-secondary">
                @Model.Count()
                @(Model.Count() == 1 ? "producto encontrado" : "productos encontrados")
            </span>
        </div>
    </div>
</main>