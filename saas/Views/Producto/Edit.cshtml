@model saas.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<main class="container-fluid px-4">
    <div class="row">
        <!-- Form Column -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header">
                    Información del Producto
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="row g-4" id="productForm">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UrlImagen" />
                        <div class="col-md-8">
                            <label asp-for="Nombre" class="form-label">Nombre del Producto</label>
                            <input asp-for="Nombre" class="form-control" type="text" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CodigoBarra" class="form-label">Codigo de Barras</label>
                            <input asp-for="CodigoBarra" class="form-control" type="text" />
                            <span asp-validation-for="CodigoBarra" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoriaId" class="form-label">Categoría</label>
                            <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId">
                                <option value="">-- Seleccione una categoría --</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PrecioCosto" class="form-label">Precio de Costo</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">$</span>
                                <input asp-for="PrecioCosto" class="form-control border-start-0" placeholder="0.00" type="number" step="0.01" min="0"/>
                            </div>
                            <span asp-validation-for="PrecioCosto" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PrecioVenta" class="form-label">Precio de Venta</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">$</span>
                                <input asp-for="PrecioVenta" class="form-control border-start-0" placeholder="0.00" type="number" step="0.01" min="0"/>
                            </div>
                            <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Stock Actual</label>
                            <input value="@Model.Stock" class="form-control" disabled/>
                            <div class="form-text">
                                El stock se modifica desde el módulo Stock.
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PuntoReposicion" class="form-label">Punto de Reposicion</label>
                            <input asp-for="PuntoReposicion" class="form-control" placeholder="0" type="number" step="1" min="0"/>
                            <span asp-validation-for="PuntoReposicion" class="text-danger"></span>
                        </div>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="col-md-6">
                                <label asp-for="EmpresaId" class="form-label">Empresa</label>
                                <select asp-for="EmpresaId" class="form-select" asp-items="ViewBag.EmpresaId">
                                    <option value="">-- Seleccione una empresa --</option>
                                </select>
                                <span asp-validation-for="EmpresaId" class="text-danger"></span>
                            </div>
                        }
                        <div class="col-md-12">
                            <label for="imagenArchivo" class="form-label">Imagen del producto</label>

                            @if (!string.IsNullOrWhiteSpace(Model.UrlImagen))
                            {
                                <div class="mb-3">
                                    <img src="@Model.UrlImagen" alt="Imagen de @Model.Nombre" class="img-thumbnail" style="max-width: 180px; max-height: 180px; object-fit: contain;" />
                                </div>
                            }

                            <input id="imagenArchivo" name="imagenArchivo" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                            @Html.ValidationMessage("imagenArchivo", null, new { @class = "text-danger" })
                            <div class="form-text">Seleccioná una imagen solamente si querés reemplazar la actual. Formatos permitidos: JPG, PNG o WebP. Tamaño máximo: 2 MB.</div>

                            @if (!string.IsNullOrWhiteSpace(Model.UrlImagen))
                            {
                                <div class="form-check mt-3">
                                    <input id="eliminarImagen" name="eliminarImagen" class="form-check-input" type="checkbox" value="true" />
                                    <label for="eliminarImagen" class="form-check-label">Eliminar imagen actual</label>
                                </div>
                            }
                        </div>
                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control" id="description" placeholder="Escriba las especificaciones técnicas o detalles del producto..." rows="4"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="Estado" class="form-check-input" role="switch" type="checkbox" />
                                <label asp-for="Estado" class="form-check-label fw-semibold"> Estado del Producto </label>
                            </div>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>
                        <div class="col-12 mt-5 border-top pt-4 d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-v-outline">Cancelar</a>
                            <button type="submit" class="btn btn-v-primary">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <!-- Help Column -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header d-flex align-items-center">
                    <span class="material-symbols-outlined me-2 text-primary">info</span>
                    Guía de Ayuda
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <h6 class="fw-bold mb-2" style="font-size: 14px; color: var(--v-primary-container);">SKU &amp; Formato</h6>
                        <p class="text-muted" style="font-size: 13px;">El SKU debe ser único. Recomendamos usar un prefijo de categoría seguido de un identificador numérico (ej. ELEC-001).</p>
                    </div>
                    <div class="mb-4">
                        <h6 class="fw-bold mb-2" style="font-size: 14px; color: var(--v-primary-container);">Gestión de Stock</h6>
                        <p class="text-muted" style="font-size: 13px;">El stock inicial será cargado en el almacén principal por defecto. Puede ajustarlo más tarde desde el módulo de Inventarios.</p>
                    </div>
                    <div class="mb-4">
                        <h6 class="fw-bold mb-2" style="font-size: 14px; color: var(--v-primary-container);">Categorías</h6>
                        <p class="text-muted" style="font-size: 13px;">Asignar una categoría correcta es vital para los reportes de ventas automáticos de final de mes.</p>
                    </div>
                    <div class="tip-box">
                        <div class="d-flex align-items-center mb-2">
                            <span class="material-symbols-outlined text-secondary me-2">lightbulb</span>
                            <span class="fw-bold" style="font-size: 14px;">Tip de Organización</span>
                        </div>
                        <p class="mb-0 text-muted" style="font-size: 13px;">Mantenga descripciones cortas y use palabras clave. Esto facilita la búsqueda global dentro de la suite VELTIKA.</p>
                    </div>
                </div>
            </div>
            <div class="card border-0 shadow-sm mt-4">
                <div style="height: 180px; position: relative;">
                    <div class="w-100 h-100 rounded-top" data-alt="A clean, high-angle shot of a minimalist warehouse with neatly organized white shelves and boxes. The lighting is bright and industrial, emphasizing efficiency and order. Soft blue and teal accents reflect a corporate SaaS tech environment. Shot with a sharp focus and professional look." style="background-size: cover; background-position: center;"></div>
                    <div class="position-absolute bottom-0 start-0 p-3 w-100" style="background: linear-gradient(transparent, rgba(0,0,0,0.7));">
                        <span class="badge bg-success">Actualización en tiempo real</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/producto-form.js" asp-append-version="true"></script>
}
