@model Producto

@{
    ViewData["Title"] = "Crear Producto";
}

<main class="container-fluid px-4">
    <div class="row">
        <!-- Form Column -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header">
                    Nuevo Producto
                </div>
                <div class="card-body p-4">
                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <div class="alert alert-warning mb-4">
                            Está creando un producto como SuperAdministrador.
                            El producto será asociado a la empresa seleccionada. Verifique esta información antes de guardar.
                        </div>
                    }
                    <form asp-action="Create" method="post" enctype="multipart/form-data" class="row g-4" id="productForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="col-md-8">
                            <label asp-for="Nombre" class="form-label">Nombre del Producto</label>
                            <input asp-for="Nombre" class="form-control" type="text" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CodigoBarra" class="form-label">Código de Barras</label>
                            <input asp-for="CodigoBarra" class="form-control" type="text" autocomplete="off" />
                            <span asp-validation-for="CodigoBarra" class="text-danger"></span>
                            <div class="form-text">Opcional. Admite el código del fabricante o un código interno, incluso con letras.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoriaId" class="form-label">Categoría</label>
                            <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId">
                                <option value="">-- Seleccione una categoría --</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PrecioCosto" class="form-label">Precio de Costo</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">$</span>
                                <input asp-for="PrecioCosto" class="form-control border-start-0" placeholder="0.00" type="number" step="0.01" min="0" />
                            </div>
                            <span asp-validation-for="PrecioCosto" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PrecioVenta" class="form-label">Precio de Venta</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">$</span>
                                <input asp-for="PrecioVenta" class="form-control border-start-0" placeholder="0.00" type="number" step="0.01" min="0" />
                            </div>
                            <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Stock" class="form-label">Stock Inicial</label>
                            <input asp-for="Stock" class="form-control" placeholder="0" type="number" min="0" />
                            <span asp-validation-for="Stock" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PuntoReposicion" class="form-label">Punto de Reposición</label>
                            <input asp-for="PuntoReposicion" class="form-control" placeholder="0" type="number" min="0" />
                            <span asp-validation-for="PuntoReposicion" class="text-danger"></span>
                        </div>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="col-md-6">
                                <label asp-for="EmpresaId" class="form-label">Empresa</label>
                                <select asp-for="EmpresaId" class="form-select" asp-items="ViewBag.EmpresaId">
                                    <option value="">-- Seleccione una empresa --</option>
                                </select>
                                <span asp-validation-for="EmpresaId" class="text-danger"></span>
                            </div>
                        }
                        <div class="col-md-12">
                            <label for="imagenArchivo" class="form-label">Imagen del producto</label>
                            <input id="imagenArchivo" name="imagenArchivo" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                            @Html.ValidationMessage("imagenArchivo", null, new { @class = "text-danger" })
                            <div class="form-text">Formatos permitidos: JPG, PNG o WebP. Tamaño máximo: 2 MB.</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control" id="description" placeholder="Escriba las especificaciones técnicas o detalles del producto..." rows="4"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>
                        <div class="col-12 mt-5 border-top pt-4 d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-v-outline">Cancelar</a>
                            <button type="submit" class="btn btn-v-primary">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <!-- Help Column -->
        <div class="mb-4">
            <h6 class="fw-bold mb-2" style="font-size: 14px; color: var(--v-primary-container);">
                Código de barras
            </h6>
            <p class="text-muted" style="font-size: 13px;">
                Puede ingresar el código del fabricante o un código interno. Se conserva como texto para admitir letras y ceros iniciales.
            </p>
        </div>

        <div class="mb-4">
            <h6 class="fw-bold mb-2" style="font-size: 14px; color: var(--v-primary-container);">
                Gestión de stock
            </h6>
            <p class="text-muted" style="font-size: 13px;">
                Indique el stock inicial y el punto de reposición para identificar productos con pocas unidades disponibles.
            </p>
        </div>

        <div class="mb-4">
            <h6 class="fw-bold mb-2" style="font-size: 14px; color: var(--v-primary-container);">
                Categoría
            </h6>
            <p class="text-muted" style="font-size: 13px;">
                Seleccione una categoría perteneciente a la misma empresa del producto.
            </p>
        </div>
    </div>
</main>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/producto-form.js" asp-append-version="true"></script>
}
