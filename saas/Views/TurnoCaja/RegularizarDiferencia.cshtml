@model saas.ViewModel.RegularizarDiferenciaTurnoVM

@{
    ViewData["Title"] = "Regularizar Diferencia";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">

        <div>

            <h1 class="h3 fw-bold mb-1">
                Regularizar Diferencia
            </h1>

            <p class="text-muted mb-0">
                Turno #@Model.TurnoCajaId
            </p>

        </div>

    </div>

    <form asp-action="RegularizarDiferencia"
          asp-route-id="@Model.TurnoCajaId"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="TurnoCajaId"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <div class="row g-4">

            <div class="col-lg-7">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-4">
                            Información del cierre
                        </h5>

                        <div class="row g-4">

                            <div class="col-md-6">

                                <div class="text-muted small">
                                    Caja
                                </div>

                                <div class="fw-semibold">
                                    @Model.CajaNombre
                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="text-muted small">
                                    Usuario del turno
                                </div>

                                <div class="fw-semibold">
                                    @Model.UsuarioTurnoNombre
                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="text-muted small">
                                    Fecha de cierre
                                </div>

                                <div>
                                    @FechaHora.ConvertirAHoraLocal(Model.FechaCierre).ToString("dd/MM/yyyy HH:mm")
                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="text-muted small">
                                    Efectivo esperado
                                </div>

                                <div class="fw-semibold">
                                    @Model.EfectivoEsperado.ToString("C")
                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="text-muted small">
                                    Efectivo contado
                                </div>

                                <div class="fw-semibold">
                                    @Model.EfectivoContado.ToString("C")
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="card border-0 shadow-sm mt-4">
                    <div class="card-body p-4">
                        <label asp-for="Motivo"
                               class="form-label fw-semibold">
                            Motivo de regularización
                        </label>

                        <textarea asp-for="Motivo"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Indicá el motivo o la explicación de la diferencia"></textarea>

                        <span asp-validation-for="Motivo"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Details"
                       asp-route-id="@Model.TurnoCajaId"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Confirmar regularización
                    </button>
                </div>

            </div>

            <div class="col-lg-5">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-3">
                            Diferencia
                        </h5>

                        @if (Model.EsSobrante)
                        {
                            <div class="alert alert-success">

                                <div class="small">
                                    Sobrante
                                </div>

                                <div class="fs-3 fw-bold">
                                    + @Model.ImporteARegularizar.ToString("C")
                                </div>

                            </div>

                            <p class="text-muted mb-0">
                                Se generará un ingreso de ajuste en la caja.
                            </p>
                        }
                        else
                        {
                            <div class="alert alert-danger">

                                <div class="small">
                                    Faltante
                                </div>

                                <div class="fs-3 fw-bold">
                                    - @Model.ImporteARegularizar.ToString("C")
                                </div>

                            </div>

                            <p class="text-muted mb-0">
                                Se generará un egreso de ajuste en la caja.
                            </p>
                        }

                    </div>

                </div>

                <div class="help-guide-panel mt-4">
                    <h2 class="help-guide-title">Guía de Ayuda</h2>
                    <div class="help-guide-item">
                        <span class="material-symbols-outlined help-guide-item__icon">add_card</span>
                        <div><h3 class="help-guide-item__title">Sobrante</h3><p class="help-guide-item__text">Si se contó más efectivo del esperado, se genera un ingreso de ajuste en la caja.</p></div>
                    </div>
                    <div class="help-guide-item">
                        <span class="material-symbols-outlined help-guide-item__icon">payments</span>
                        <div><h3 class="help-guide-item__title">Faltante</h3><p class="help-guide-item__text">Si se contó menos efectivo del esperado, se genera un egreso de ajuste.</p></div>
                    </div>
                    <div class="help-guide-item">
                        <span class="material-symbols-outlined help-guide-item__icon">history</span>
                        <div><h3 class="help-guide-item__title">Trazabilidad</h3><p class="help-guide-item__text">La regularización conserva el importe, el usuario, la fecha y el motivo informado.</p></div>
                    </div>
                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
