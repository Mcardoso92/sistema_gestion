@model saas.ViewModel.AperturaTurnoVM

@{
    ViewData["Title"] = "Abrir Turno";
}

<div class="container-fluid px-4 py-4">

    <div class="page-header">

        <div class="page-header-content">
            <h1 class="page-title">
                Abrir Turno
            </h1>

            <p class="page-subtitle">
                Seleccioná la caja de efectivo con la que vas a operar.
            </p>
        </div>

    </div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <form asp-action="Abrir"
                  method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger form-validation-summary"></div>

        <div class="form-card">

            <div class="card-body p-4">

                @if (Model.CajasDisponibles.Any())
                {
                    <div class="mb-3">

                        <label asp-for="CajaId"
                               class="form-label">
                            Caja
                        </label>

                        <select asp-for="CajaId"
                                class="form-select"
                                id="cajaSelect">

                            <option value="">
                                Seleccionar caja
                            </option>

                            @foreach (var caja in Model.CajasDisponibles)
                            {
                                <option value="@caja.Id"
                                        data-fondo="@caja.FondoFijo.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    @caja.Nombre
                                </option>
                            }

                        </select>

                        <span asp-validation-for="CajaId"
                              class="text-danger"></span>

                    </div>

                    <div class="border rounded p-3 bg-light">

                        <div class="text-muted small">
                            Fondo fijo configurado
                        </div>

                        <div class="fs-4 fw-bold"
                             id="fondoFijoVisual">
                            -
                        </div>

                        <div class="form-text">
                            El fondo fijo se toma automáticamente de la configuración de la caja.
                        </div>

                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        No hay cajas de efectivo disponibles para abrir un turno.
                    </div>
                }

            </div>

        </div>

        @if (Model.CajasDisponibles.Any())
        {
            <div class="form-actions mt-4">

                <a asp-action="Index"
                   class="btn btn-v-outline">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-v-primary">
                    Abrir turno
                </button>

            </div>
        }

            </form>
        </div>

        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">point_of_sale</span>
                    <div><h3 class="help-guide-item__title">Caja disponible</h3><p class="help-guide-item__text">Solo se muestran cajas de efectivo activas que no tienen otro turno abierto.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">payments</span>
                    <div><h3 class="help-guide-item__title">Fondo fijo</h3><p class="help-guide-item__text">El turno comienza con el fondo configurado en la caja y lo incorpora al efectivo esperado.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">person</span>
                    <div><h3 class="help-guide-item__title">Responsable</h3><p class="help-guide-item__text">El turno queda asociado al usuario que lo abre para registrar su actividad operativa.</p></div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const cajaSelect =
                document.getElementById("cajaSelect");

            const fondoVisual =
                document.getElementById("fondoFijoVisual");

            if (!cajaSelect || !fondoVisual) {
                return;
            }

            function actualizarFondo() {

                const opcion =
                    cajaSelect.options[
                        cajaSelect.selectedIndex
                    ];

                const fondo =
                    opcion?.dataset?.fondo;

                if (!fondo) {
                    fondoVisual.textContent = "-";
                    return;
                }

                const importe =
                    Number.parseFloat(fondo);

                fondoVisual.textContent =
                    importe.toLocaleString(
                        "es-AR",
                        {
                            style: "currency",
                            currency: "ARS"
                        });
            }

            cajaSelect.addEventListener(
                "change",
                actualizarFondo);

            actualizarFondo();
        });
    </script>
}
