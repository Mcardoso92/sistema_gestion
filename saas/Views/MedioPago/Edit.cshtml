@model saas.ViewModel.MedioPagoEditVM

@{
    ViewData["Title"] = "Editar Medio de Pago";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">
                Editar Medio de Pago
            </h1>
        </div>

    </div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />
        <input asp-for="EmpresaId" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Nombre"
                               class="form-label fw-semibold">
                            Nombre
                        </label>

                        <input asp-for="Nombre"
                               class="form-control" />

                        <span asp-validation-for="Nombre"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Tipo"
                               class="form-label fw-semibold">
                            Tipo
                        </label>

                        <select asp-for="Tipo"
                                asp-items="Html.GetEnumSelectList<saas.Models.Enums.TipoMedioPago>()"
                                class="form-select">
                        </select>

                        <span asp-validation-for="Tipo"
                              class="text-danger"></span>

                        <div class="form-text">
                            Si el medio ya posee movimientos financieros, su tipo no podrá modificarse.
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Descripcion"
                               class="form-label fw-semibold">
                            Descripción
                        </label>

                        <textarea asp-for="Descripcion"
                                  class="form-control"
                                  rows="3"></textarea>

                        <span asp-validation-for="Descripcion"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">

                            @if (Model.Estado && Model.TieneTurnoAbiertoAsociado)
                            {
                                <input asp-for="Estado" type="hidden" />
                                <input class="form-check-input" type="checkbox" checked disabled />
                            }
                            else
                            {
                                <input asp-for="Estado" class="form-check-input" />
                            }

                            <label asp-for="Estado"
                                   class="form-check-label fw-semibold">
                                Medio de pago activo
                            </label>

                        </div>

                        @if (!Model.Estado)
                        {
                            <div class="form-text">
                                Activá esta opción para reactivar el medio de pago.
                            </div>
                        }
                        else if (Model.TieneTurnoAbiertoAsociado)
                        {
                            <div class="form-text text-warning-emphasis">
                                No puede desactivarlo mientras una caja asociada tenga un turno abierto.
                            </div>
                        }

                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>

                </div>

            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Guardar cambios
            </button>

        </div>

            </form>
        </div>

        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">payments</span>
                    <div><h3 class="help-guide-item__title">Tipo de medio</h3><p class="help-guide-item__text">Si ya tiene movimientos financieros, el tipo no puede modificarse para proteger el historial.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">toggle_on</span>
                    <div><h3 class="help-guide-item__title">Estado</h3><p class="help-guide-item__text">Un medio inactivo deja de estar disponible para nuevas operaciones, pero puede reactivarse.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">schedule</span>
                    <div><h3 class="help-guide-item__title">Turnos abiertos</h3><p class="help-guide-item__text">No puede desactivarse mientras una caja asociada tenga un turno abierto.</p></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
