@model saas.ViewModel.MedioPagoDetailsVM

@{
    ViewData["Title"] = "Detalle del Medio de Pago";
    string urlVolver = ViewData["ReturnUrl"] as string ?? Url.Action("Index")!;
}

<div class="container-fluid px-4 py-4">

    <div class="page-header">
        <div class="page-header-content">
            <h1 class="page-title">@Model.Nombre</h1>

            @if (Model.Estado)
            {
                <span class="status-badge status-active">Activo</span>
            }
            else
            {
                <span class="status-badge status-inactive">Inactivo</span>
            }
        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-8">
            <div class="card detail-card">
                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-md-6">
                            <div class="detail-label">Nombre</div>
                            <div class="detail-value">@Model.Nombre</div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-label">Tipo</div>
                            <div class="detail-value">@TextoPresentacion.ValorEnum(Model.Tipo)</div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-label">Empresa</div>
                            <div class="detail-value">@Model.EmpresaNombre</div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-label">Fecha de alta</div>
                            <div class="detail-value">@FechaHora.ConvertirAHoraLocal(Model.FechaAlta).ToString("dd/MM/yyyy")</div>
                        </div>

                        <div class="col-12">
                            <div class="detail-label">Descripción</div>

                            <div class="detail-value">
                                @(string.IsNullOrWhiteSpace(Model.Descripcion)
                                                                ? "Sin descripción"
                                                                : Model.Descripcion)
                            </div>
                        </div>

                    </div>

                </div>
            </div>

            <div class="form-actions mt-4">
                <a href="@urlVolver" class="btn btn-v-outline">Volver</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-returnUrl="@urlVolver" class="btn btn-v-primary">Editar</a>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card detail-card">
                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        Cajas asociadas
                    </h5>

                    @if (Model.CajasAsociadas.Any())
                    {
                        <ul class="mb-0">
                            @foreach (var caja in Model.CajasAsociadas)
                            {
                                <li>@caja</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            Este medio de pago todavía no está asociado a ninguna caja.
                        </p>
                    }

                </div>
            </div>

            <div class="help-guide-panel mt-4">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">payments</span>
                    <div><h3 class="help-guide-item__title">Tipo de medio</h3><p class="help-guide-item__text">El tipo determina cómo se registra este medio dentro de las operaciones financieras.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">point_of_sale</span>
                    <div><h3 class="help-guide-item__title">Cajas asociadas</h3><p class="help-guide-item__text">En esta sección podés consultar las cajas donde el medio de pago está habilitado.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">history</span>
                    <div><h3 class="help-guide-item__title">Historial</h3><p class="help-guide-item__text">Los movimientos realizados conservan esta referencia aunque el medio se desactive.</p></div>
                </div>
            </div>
        </div>

    </div>

</div>
