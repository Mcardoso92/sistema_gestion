@model saas.ViewModel.MedioPagoCreateVM

@{
    ViewData["Title"] = "Nuevo Medio de Pago";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Nuevo Medio de Pago</h1>
            <p class="text-muted mb-0">
                Creá un medio de pago disponible para la empresa.
            </p>
        </div>

    </div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">

                <div class="row g-3">

                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <div class="col-md-6">
                            <label asp-for="EmpresaId"
                                   class="form-label fw-semibold">
                                Empresa
                            </label>

                            <select asp-for="EmpresaId"
                                    asp-items="ViewBag.EmpresaId"
                                    class="form-select">
                                <option value="">
                                    Seleccionar empresa
                                </option>
                            </select>

                            <span asp-validation-for="EmpresaId"
                                  class="text-danger"></span>
                        </div>
                    }

                    <div class="col-md-6">
                        <label asp-for="Nombre"
                               class="form-label fw-semibold">
                            Nombre
                        </label>

                        <input asp-for="Nombre"
                               class="form-control"
                               placeholder="Ej: Mercado Pago QR" />

                        <span asp-validation-for="Nombre"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Tipo"
                               class="form-label fw-semibold">
                            Tipo
                        </label>

                        <select asp-for="Tipo"
                                asp-items="Html.GetEnumSelectList<saas.Models.Enums.TipoMedioPago>()"
                                class="form-select">
                        </select>

                        <span asp-validation-for="Tipo"
                              class="text-danger"></span>

                        <div class="form-text">
                            Define cómo se comportará este medio de pago dentro del sistema.
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Descripcion"
                               class="form-label fw-semibold">
                            Descripción
                        </label>

                        <textarea asp-for="Descripcion"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Descripción opcional del medio de pago"></textarea>

                        <span asp-validation-for="Descripcion"
                              class="text-danger"></span>
                    </div>

                </div>

            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Crear Medio de Pago
            </button>

        </div>
            </form>
        </div>

        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">payments</span>
                    <div><h3 class="help-guide-item__title">Tipo de medio</h3><p class="help-guide-item__text">El tipo define cómo se comportará el medio de pago y con qué cajas podrá utilizarse.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">point_of_sale</span>
                    <div><h3 class="help-guide-item__title">Cajas asociadas</h3><p class="help-guide-item__text">Después de crearlo, podés habilitarlo en las cajas donde deba estar disponible.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">history</span>
                    <div><h3 class="help-guide-item__title">Historial</h3><p class="help-guide-item__text">Las operaciones registradas conservan siempre el medio de pago utilizado.</p></div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
