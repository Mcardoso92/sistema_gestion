@model saas.ViewModel.MedioPagoDetailsVM

@{
    ViewData["Title"] = "Desactivar Medio de Pago";
}

<div class="container-fluid px-4 py-4">

    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

            <h1 class="h4 fw-bold mb-3">
                Desactivar medio de pago
            </h1>

            <div class="alert alert-warning">
                El medio de pago dejará de estar disponible para nuevas operaciones.
                Los movimientos históricos no se modificarán.
            </div>

            @if (Model.TieneTurnoAbiertoAsociado)
            {
                <div class="alert alert-danger">
                    No puede desactivarlo mientras una caja asociada tenga un turno abierto.
                </div>
            }

            <dl class="row mb-4">

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@Model.Nombre</dd>

                <dt class="col-sm-3">Tipo</dt>
                <dd class="col-sm-9">@TextoPresentacion.ValorEnum(Model.Tipo)</dd>

                <dt class="col-sm-3">Empresa</dt>
                <dd class="col-sm-9">@Model.EmpresaNombre</dd>

                <dt class="col-sm-3">Cajas asociadas</dt>
                <dd class="col-sm-9">

                    @if (Model.CajasAsociadas.Any())
                    {
                        @string.Join(", ", Model.CajasAsociadas)
                    }
                    else
                    {
                        <span>Ninguna</span>
                    }

                </dd>

            </dl>

            <form asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    @if (Model.TieneTurnoAbiertoAsociado)
                    {
                        <button type="button" class="btn btn-danger" disabled>
                            Desactivar
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-danger">
                            Desactivar
                        </button>
                    }

                </div>

            </form>

                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">block</span>
                    <div><h3 class="help-guide-item__title">Desactivación</h3><p class="help-guide-item__text">El medio dejará de estar disponible para nuevas operaciones, pero no se eliminará.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">schedule</span>
                    <div><h3 class="help-guide-item__title">Turnos abiertos</h3><p class="help-guide-item__text">Antes de desactivarlo, deben cerrarse los turnos de las cajas asociadas.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">history</span>
                    <div><h3 class="help-guide-item__title">Datos conservados</h3><p class="help-guide-item__text">Las cajas relacionadas y todos los movimientos históricos permanecerán sin cambios.</p></div>
                </div>
            </div>
        </div>
    </div>

</div>
