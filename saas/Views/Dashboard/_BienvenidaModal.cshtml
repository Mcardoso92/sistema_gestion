<div class="modal fade js-bienvenida-modal"
     id="bienvenidaModal"
     tabindex="-1"
     aria-labelledby="bienvenidaModalLabel"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
     data-completar-url="@Url.Action("CompletarBienvenida", "Dashboard")">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h2 class="modal-title fs-4" id="bienvenidaModalLabel">¡Bienvenido a Veltika! 💙</h2>
                    <p class="text-secondary mb-0 mt-2">
                        Tu negocio ya está creado. Te ayudamos a empezar a gestionarlo en unos pocos pasos.
                    </p>
                </div>
                <button type="button"
                        class="btn-close js-bienvenida-accion"
                        aria-label="Cerrar"
                        data-destino=""></button>
            </div>

            <div class="modal-body py-4">
                <div class="d-grid gap-3">
                    <div class="d-flex align-items-start gap-3 border rounded-3 p-3">
                        <div class="metric-card__icon metric-card__icon--primary flex-shrink-0">
                            <span class="material-symbols-outlined">inventory_2</span>
                        </div>
                        <div>
                            <div class="fw-semibold">1. Cargá tu primer producto</div>
                            <div class="text-secondary small">Agregá los productos que vendés.</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3 border rounded-3 p-3">
                        <div class="metric-card__icon metric-card__icon--success flex-shrink-0">
                            <span class="material-symbols-outlined">point_of_sale</span>
                        </div>
                        <div>
                            <div class="fw-semibold">2. Abrí tu caja</div>
                            <div class="text-secondary small">Prepará tu negocio para registrar movimientos.</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3 border rounded-3 p-3">
                        <div class="metric-card__icon metric-card__icon--info flex-shrink-0">
                            <span class="material-symbols-outlined">receipt_long</span>
                        </div>
                        <div>
                            <div class="fw-semibold">3. Registrá tu primera venta</div>
                            <div class="text-secondary small">Conocé cómo funciona el punto de venta.</div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-danger d-none mt-3 mb-0 js-bienvenida-error" role="alert">
                    No pudimos guardar tu elección. Intentá nuevamente.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-v-outline js-bienvenida-accion"
                        data-destino="">
                    Prefiero explorar por mi cuenta
                </button>
                <button type="button"
                        class="btn btn-v-primary js-bienvenida-accion"
                        data-destino="@Url.Action("Create", "Producto")">
                    Comenzar con mi primer producto →
                </button>
            </div>

            <form class="d-none js-bienvenida-token">
                @Html.AntiForgeryToken()
            </form>
        </div>
    </div>
</div>
