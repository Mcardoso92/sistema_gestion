@model saas.ViewModel.RegistrarCobroVentaVM

@{
    ViewData["Title"] = "Registrar Cobro";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Registrar Cobro
            </h1>

            <p class="text-muted mb-0">
                Venta #@Model.VentaId
            </p>
        </div>

    </div>

    <form asp-action="Registrar"
          method="post"
          id="formRegistrarCobro"
          data-get-cajas-url="@Url.Action("GetCajasPorMedioPago", "CobroVenta")"
          data-venta-id="@Model.VentaId">

        @Html.AntiForgeryToken()

        <input asp-for="VentaId"
               type="hidden" />

        <div asp-validation-summary="All"
             class="alert alert-danger"></div>

        <div class="row g-4">

            <div class="col-lg-4 order-lg-2">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="text-muted small">
                            Saldo pendiente
                        </div>

                        <div class="display-6 fw-bold">
                            @Model.SaldoPendiente.ToString("C")
                        </div>

                    </div>

                </div>

                <div class="help-guide-panel mt-4">
                    <h2 class="help-guide-title">Guía de Ayuda</h2>
                    <div class="help-guide-item">
                        <span class="material-symbols-outlined help-guide-item__icon">payments</span>
                        <div><h3 class="help-guide-item__title">Saldo pendiente</h3><p class="help-guide-item__text">El importe del cobro no puede superar el saldo pendiente de la venta.</p></div>
                    </div>
                    <div class="help-guide-item">
                        <span class="material-symbols-outlined help-guide-item__icon">account_balance_wallet</span>
                        <div><h3 class="help-guide-item__title">Caja y medio</h3><p class="help-guide-item__text">La caja debe tener habilitado el medio de pago seleccionado para registrar el movimiento.</p></div>
                    </div>
                    <div class="help-guide-item">
                        <span class="material-symbols-outlined help-guide-item__icon">point_of_sale</span>
                        <div><h3 class="help-guide-item__title">Efectivo</h3><p class="help-guide-item__text">Al cobrar en efectivo podés indicar cuánto recibiste para calcular el vuelto.</p></div>
                    </div>
                </div>

            </div>

            <div class="col-lg-8 order-lg-1">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="MedioPagoId"
                                       class="form-label fw-semibold">
                                    Medio de pago
                                </label>

                                <select asp-for="MedioPagoId"
                                        class="form-select"
                                        id="medioPagoSelect">

                                    <option value="">
                                        Seleccionar medio
                                    </option>

                                    @foreach (var medio in Model.MediosPagoDisponibles)
                                    {
                                        <option value="@medio.Id"
                                                data-tipo="@((int)medio.Tipo)">
                                            @medio.Nombre
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="MedioPagoId"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="CajaId"
                                       class="form-label fw-semibold">
                                    Caja
                                </label>

                                <select asp-for="CajaId"
                                        class="form-select"
                                        id="cajaSelect">

                                    <option value="">
                                        Primero seleccione un medio de pago
                                    </option>

                                </select>

                                <span asp-validation-for="CajaId"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Importe"
                                       class="form-label fw-semibold">
                                    Importe a cobrar
                                </label>

                                <input asp-for="Importe"
                                       type="number"
                                       min="0.01"
                                       step="0.01"
                                       max="@Model.SaldoPendiente"
                                       class="form-control"
                                       id="importeCobro" />

                                <span asp-validation-for="Importe"
                                      class="text-danger"></span>

                            </div>
                            <div class="col-12 d-none"
                                 id="bloqueEfectivo">

                                <div class="row g-3">

                                    <div class="col-md-6">

                                        <label for="efectivoRecibido"
                                               class="form-label fw-semibold">
                                            Recibido
                                        </label>

                                        <input type="number"
                                               id="efectivoRecibido"
                                               min="0"
                                               step="0.01"
                                               class="form-control"
                                               placeholder="0,00" />

                                    </div>

                                    <div class="col-md-6">

                                        <label class="form-label fw-semibold">
                                            Vuelto
                                        </label>

                                        <div class="form-control bg-light"
                                             id="efectivoVuelto">
                                            $0,00
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-controller="Venta"
                       asp-action="Details"
                       asp-route-id="@Model.VentaId"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Confirmar cobro
                    </button>
                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/cobro-venta.js"
            asp-append-version="true"></script>
}
