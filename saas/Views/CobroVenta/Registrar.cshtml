@model saas.ViewModel.RegistrarCobroVentaVM

@{
    ViewData["Title"] = "Registrar Cobro";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Registrar Cobro
            </h1>

            <p class="text-muted mb-0">
                Venta #@Model.VentaId
            </p>
        </div>

        <a asp-controller="Venta"
           asp-action="Details"
           asp-route-id="@Model.VentaId"
           class="btn btn-outline-secondary">
            Volver
        </a>

    </div>

    <form asp-action="Registrar"
          method="post"
          id="formRegistrarCobro"
          data-get-cajas-url="@Url.Action("GetCajasPorMedioPago", "Venta")">

        @Html.AntiForgeryToken()

        <input asp-for="VentaId"
               type="hidden" />

        <div asp-validation-summary="All"
             class="alert alert-danger"></div>

        <div class="row g-4">

            <div class="col-lg-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <div class="text-muted small">
                            Saldo pendiente
                        </div>

                        <div class="display-6 fw-bold">
                            @Model.SaldoPendiente.ToString("C")
                        </div>

                    </div>

                </div>

            </div>

            <div class="col-lg-8">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="MedioPagoId"
                                       class="form-label fw-semibold">
                                    Medio de pago
                                </label>

                                <select asp-for="MedioPagoId"
                                        class="form-select"
                                        id="medioPagoSelect">

                                    <option value="">
                                        Seleccionar medio
                                    </option>

                                    @foreach (var medio in Model.MediosPagoDisponibles)
                                    {
                                        <option value="@medio.Id"
                                                data-tipo="@((int)medio.Tipo)">
                                            @medio.Nombre
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="MedioPagoId"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="CajaId"
                                       class="form-label fw-semibold">
                                    Caja
                                </label>

                                <select asp-for="CajaId"
                                        class="form-select"
                                        id="cajaSelect">

                                    <option value="">
                                        Primero seleccione un medio de pago
                                    </option>

                                </select>

                                <span asp-validation-for="CajaId"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Importe"
                                       class="form-label fw-semibold">
                                    Importe a cobrar
                                </label>

                                <input asp-for="Importe"
                                       type="number"
                                       min="0.01"
                                       step="0.01"
                                       max="@Model.SaldoPendiente"
                                       class="form-control"
                                       id="importeCobro" />

                                <span asp-validation-for="Importe"
                                      class="text-danger"></span>

                            </div>
                            <div class="col-12 d-none"
                                 id="bloqueEfectivo">

                                <div class="row g-3">

                                    <div class="col-md-6">

                                        <label for="efectivoRecibido"
                                               class="form-label fw-semibold">
                                            Recibido
                                        </label>

                                        <input type="number"
                                               id="efectivoRecibido"
                                               min="0"
                                               step="0.01"
                                               class="form-control"
                                               placeholder="0,00" />

                                    </div>

                                    <div class="col-md-6">

                                        <label class="form-label fw-semibold">
                                            Vuelto
                                        </label>

                                        <div class="form-control bg-light"
                                             id="efectivoVuelto">
                                            $0,00
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">

            <a asp-controller="Venta"
               asp-action="Details"
               asp-route-id="@Model.VentaId"
               class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Confirmar cobro
            </button>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/cobro-venta.js"
            asp-append-version="true"></script>
}