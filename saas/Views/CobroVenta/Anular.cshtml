@model saas.ViewModel.AnularCobroVentaVM

@{
    ViewData["Title"] = "Anular Cobro";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Anular Cobro
            </h1>

            <p class="text-muted mb-0">
                Venta #@Model.VentaId
            </p>
        </div>

    </div>

    <form asp-action="Anular"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="CobroVentaId"
               type="hidden" />

        <div asp-validation-summary="All"
             class="alert alert-danger"></div>

        <div class="row g-4">

            <div class="col-lg-4 order-lg-2">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="text-muted small mb-1">
                            Importe del cobro
                        </div>

                        <div class="display-6 fw-bold mb-3">
                            @Model.Importe.ToString("C")
                        </div>

                        <div class="small text-muted">
                            Medio de pago
                        </div>

                        <div class="fw-semibold">
                            @Model.MedioPagoNombre
                        </div>

                    </div>

                </div>

                <div class="help-guide-panel mt-4">
                    <h2 class="help-guide-title">Guía de Ayuda</h2>
                    <div class="help-guide-item">
                        <span class="material-symbols-outlined help-guide-item__icon">undo</span>
                        <div><h3 class="help-guide-item__title">Movimiento inverso</h3><p class="help-guide-item__text">La anulación revierte el impacto del cobro en la caja correspondiente.</p></div>
                    </div>
                    <div class="help-guide-item">
                        <span class="material-symbols-outlined help-guide-item__icon">pending_actions</span>
                        <div><h3 class="help-guide-item__title">Saldo de la venta</h3><p class="help-guide-item__text">El importe anulado vuelve a quedar pendiente de cobro en la venta.</p></div>
                    </div>
                    <div class="help-guide-item">
                        <span class="material-symbols-outlined help-guide-item__icon">history</span>
                        <div><h3 class="help-guide-item__title">Trazabilidad</h3><p class="help-guide-item__text">El cobro original se conserva junto con el motivo de su anulación.</p></div>
                    </div>
                </div>

            </div>

            <div class="col-lg-8 order-lg-1">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="alert alert-warning">
                            Al anular este cobro se generará un movimiento inverso en caja
                            y el importe volverá a quedar como saldo pendiente de la venta.
                        </div>

                        <div class="mb-3">

                            <label asp-for="Motivo"
                                   class="form-label fw-semibold">
                                Motivo de anulación
                            </label>

                            <textarea asp-for="Motivo"
                                      class="form-control"
                                      rows="4"
                                      maxlength="500"
                                      placeholder="Indique el motivo de la anulación..."></textarea>

                            <span asp-validation-for="Motivo"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-controller="Venta"
                       asp-action="Details"
                       asp-route-id="@Model.VentaId"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('¿Está seguro de que desea anular este cobro?');">
                        Anular cobro
                    </button>
                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
