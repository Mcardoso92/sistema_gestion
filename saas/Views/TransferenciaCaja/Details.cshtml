@model saas.ViewModel.TransferenciaCajaResumenVM

@{
    ViewData["Title"] = "Detalle de Transferencia";

    bool activa =
        Model.Estado ==
        saas.Models.Enums.EstadoTransferenciaCaja.Activa;
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>

            <div class="d-flex align-items-center gap-2">

                <h1 class="h3 fw-bold mb-0">
                    Transferencia #@Model.Id
                </h1>

                @if (activa)
                {
                    <span class="status-badge status-active">
                        Activa
                    </span>
                }
                else
                {
                    <span class="status-badge status-cancelled">
                        Anulada
                    </span>
                }

            </div>

            <p class="text-muted mb-0 mt-1">
                Movimiento entre cajas.
            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Volver
            </a>

            @if (activa)
            {
                <a asp-action="Anular"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger">
                    Anular
                </a>
            }

        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        Información
                    </h5>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Caja origen
                            </div>

                            <div class="fw-semibold">
                                @Model.CajaOrigenNombre
                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Caja destino
                            </div>

                            <div class="fw-semibold">
                                @Model.CajaDestinoNombre
                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Fecha
                            </div>

                            <div>
                                @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Usuario
                            </div>

                            <div>
                                @Model.UsuarioNombre
                            </div>

                        </div>

                        <div class="col-12">

                            <div class="text-muted small">
                                Motivo
                            </div>

                            <div>
                                @Model.Motivo
                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Turno asociado
                            </div>

                            @if (Model.TurnoCajaId.HasValue)
                            {
                                <a asp-controller="TurnoCaja"
                                   asp-action="Details"
                                   asp-route-id="@Model.TurnoCajaId">
                                    Turno #@Model.TurnoCajaId
                                </a>
                            }
                            else
                            {
                                <div>-</div>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="text-muted small">
                        Importe transferido
                    </div>

                    <div class="display-6 fw-bold">
                        @Model.Importe.ToString("C")
                    </div>

                </div>

            </div>

        </div>

    </div>

    @if (!activa)
    {
        <div class="card border-danger shadow-sm mt-4">

            <div class="card-body p-4">

                <h5 class="fw-bold mb-3">
                    Anulación
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="text-muted small">
                            Fecha de anulación
                        </div>

                        <div>
                            @(Model.FechaAnulacion.HasValue
                                                    ? Model.FechaAnulacion.Value.ToString("dd/MM/yyyy HH:mm")
                                                    : "-")
                    </div>

                    </div>

                    <div class="col-md-6">

                        <div class="text-muted small">
                            Usuario
                        </div>

                        <div>
                            @(Model.UsuarioAnulacionNombre ?? "-")
                        </div>

                    </div>

                    <div class="col-12">

                        <div class="text-muted small">
                            Motivo
                        </div>

                        <div>
                            @(Model.MotivoAnulacion ?? "-")
                        </div>

                    </div>

                </div>

            </div>

        </div>
        }

</div>
