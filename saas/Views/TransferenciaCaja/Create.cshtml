@model saas.ViewModel.TransferenciaCajaCreateVM

@{
    ViewData["Title"] = "Nueva Transferencia";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Nueva Transferencia
            </h1>

            <p class="text-muted mb-0">
                Mové dinero de una caja a otra.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Volver
        </a>

    </div>

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4">

                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="CajaOrigenId"
                               class="form-label fw-semibold">
                            Caja origen
                        </label>

                        <select asp-for="CajaOrigenId"
                                class="form-select"
                                id="cajaOrigenSelect">

                            <option value="">
                                Seleccionar caja origen
                            </option>

                            @foreach (var caja in Model.CajasOrigenDisponibles)
                            {
                                <option value="@caja.Id">
                                    @caja.Nombre
                                </option>
                            }

                        </select>

                        <span asp-validation-for="CajaOrigenId"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="CajaDestinoId"
                               class="form-label fw-semibold">
                            Caja destino
                        </label>

                        <select asp-for="CajaDestinoId"
                                class="form-select"
                                id="cajaDestinoSelect">

                            <option value="">
                                Seleccionar caja destino
                            </option>

                            @foreach (var caja in Model.CajasDestinoDisponibles)
                            {
                                <option value="@caja.Id">
                                    @caja.Nombre
                                </option>
                            }

                        </select>

                        <span asp-validation-for="CajaDestinoId"
                              class="text-danger"></span>

                    </div>

                    <div class="col-12">

                        <div class="border rounded bg-light p-3">

                            <div class="text-muted small">
                                Saldo disponible en origen
                            </div>

                            <div class="fs-4 fw-bold"
                                 id="saldoDisponible">
                                -
                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Importe"
                               class="form-label fw-semibold">
                            Importe
                        </label>

                        <input asp-for="Importe"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="form-control" />

                        <span asp-validation-for="Importe"
                              class="text-danger"></span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Motivo"
                               class="form-label fw-semibold">
                            Motivo
                        </label>

                        <input asp-for="Motivo"
                               maxlength="250"
                               class="form-control"
                               placeholder="Ej: Envío de efectivo a caja central" />

                        <span asp-validation-for="Motivo"
                              class="text-danger"></span>

                    </div>

                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Confirmar transferencia
            </button>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const origen =
                document.getElementById("cajaOrigenSelect");

            const destino =
                document.getElementById("cajaDestinoSelect");

            const saldoVisual =
                document.getElementById("saldoDisponible");

            const formatoMoneda =
                new Intl.NumberFormat(
                    "es-AR",
                    {
                        style: "currency",
                        currency: "ARS"
                    });

            async function cargarSaldo() {

                const cajaId =
                    origen.value;

                if (!cajaId) {
                    saldoVisual.textContent = "-";
                    return;
                }

                try {

                    const url =
                        '@Url.Action("GetSaldoCaja", "TransferenciaCaja")'
                        + '?cajaId='
                        + encodeURIComponent(cajaId);

                    const response =
                        await fetch(url);

                    if (!response.ok) {
                        throw new Error();
                    }

                    const data =
                        await response.json();

                    saldoVisual.textContent =
                        formatoMoneda.format(data.saldo);
                }
                catch {

                    saldoVisual.textContent =
                        "No disponible";
                }
            }

            function actualizarDestinos() {

                const origenId =
                    origen.value;

                Array.from(destino.options)
                    .forEach(option => {

                        if (!option.value) {
                            return;
                        }

                        option.disabled =
                            option.value === origenId;
                    });

                if (destino.value === origenId) {
                    destino.value = "";
                }
            }

            origen.addEventListener(
                "change",
                function () {

                    cargarSaldo();
                    actualizarDestinos();
                });

            cargarSaldo();
            actualizarDestinos();
        });
    </script>
}