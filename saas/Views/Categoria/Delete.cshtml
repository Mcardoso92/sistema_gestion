@model saas.Models.Categoria
@{ ViewData["Title"] = "Desactivar Categoría"; }
<main class="container-fluid px-4 py-4">
    <div class="page-header"><div class="page-header-content"><h1 class="page-title">Desactivar Categoría</h1><p class="page-subtitle">Revisá la información antes de confirmar.</p></div></div>
    <div class="row g-4 align-items-start">
        <div class="col-lg-8"><div class="detail-card p-4">
            <div class="alert alert-warning">La categoría dejará de estar disponible para nuevas operaciones. La información histórica se conservará.</div>
            <dl class="row mb-4">
                <dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.Nombre</dd>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <dt class="col-sm-4">Empresa</dt><dd class="col-sm-8">@Model.Empresa?.Nombre</dd>
                }
            </dl>
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="form-actions pt-4 border-top"><a asp-action="Index" class="btn btn-v-outline">Cancelar</a><button type="submit" class="btn btn-danger">Desactivar</button></div>
            </form>
        </div></div>
        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">category</span>
                    <div><h3 class="help-guide-item__title">Organización del catálogo</h3><p class="help-guide-item__text">Utilizá nombres claros para identificar rápidamente qué productos pertenecen a cada categoría.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">corporate_fare</span>
                    <div><h3 class="help-guide-item__title">Empresa</h3><p class="help-guide-item__text">Cada categoría pertenece a una sola empresa y únicamente estará disponible para sus productos.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">history</span>
                    <div><h3 class="help-guide-item__title">Información histórica</h3><p class="help-guide-item__text">Al desactivarla deja de estar disponible para nuevas operaciones, sin eliminar la información existente.</p></div>
                </div>
            </div>
        </div>
    </div>
</main>
