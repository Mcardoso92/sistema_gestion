@model Categoria
@{ ViewData["Title"] = "Editar Categoría"; }
<main class="container-fluid px-4 py-4">
    <div class="mb-4"><h1 class="h3 fw-bold mb-1">Editar Categoría</h1><p class="text-muted mb-0">Actualizá la información y disponibilidad de la categoría.</p></div>
    <div class="row g-4 align-items-start">
        <div class="col-lg-8"><div class="form-container p-4">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <div class="row g-3">
                    <div class="col-12"><label asp-for="Nombre" class="form-label">Nombre</label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <div class="col-12"><label asp-for="EmpresaId" class="form-label">Empresa</label><select asp-for="EmpresaId" class="form-select" asp-items="ViewBag.EmpresaId"></select><span asp-validation-for="EmpresaId" class="text-danger"></span></div>
                    }
                    <div class="col-12"><div class="form-check form-switch"><input asp-for="Estado" class="form-check-input" /><label asp-for="Estado" class="form-check-label fw-semibold">Categoría activa</label></div></div>
                </div>
                <div class="d-flex justify-content-end gap-3 pt-4 mt-4 border-top"><a asp-action="Index" class="btn btn-v-outline">Cancelar</a><button type="submit" class="btn btn-v-primary">Guardar</button></div>
            </form>
        </div></div>
        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">category</span>
                    <div><h3 class="help-guide-item__title">Organización del catálogo</h3><p class="help-guide-item__text">Utilizá nombres claros para identificar rápidamente qué productos pertenecen a cada categoría.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">corporate_fare</span>
                    <div><h3 class="help-guide-item__title">Empresa</h3><p class="help-guide-item__text">Cada categoría pertenece a una sola empresa y únicamente estará disponible para sus productos.</p></div>
                </div>
                <div class="help-guide-item">
                    <span class="material-symbols-outlined help-guide-item__icon">history</span>
                    <div><h3 class="help-guide-item__title">Información histórica</h3><p class="help-guide-item__text">Al desactivarla deja de estar disponible para nuevas operaciones, sin eliminar la información existente.</p></div>
                </div>
            </div>
        </div>
    </div>
</main>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
