@model IEnumerable<Categoria>

@{
    ViewData["Title"] = "Categorías";

    string estadoSeleccionado = ViewBag.Estado?.ToString() ?? "activos";
    int? empresaSeleccionada = ViewBag.EmpresaId as int?;
    string? busqueda = ViewBag.Busqueda?.ToString();

    IEnumerable<Empresa> empresas = ViewBag.Empresas as IEnumerable<Empresa>
        ?? Enumerable.Empty<Empresa>();
}


<main class="flex-grow-1 py-5 container-fluid px-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-semibold mb-1">Gestión de Categorías</h1>
            <p class="text-secondary mb-0">Administra y organiza las categorías de productos de tu sistema.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 py-2 px-3 shadow-sm rounded-1">
            <span class="material-symbols-outlined fs-5">add</span>
            <span class="fw-medium small">Nueva Categoría</span>
        </a>
    </div>
    <!-- Filter Bar -->
    <div class="card mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="estado" class="form-label fw-semibold"> Estado</label>
                    <select id="estado" name="estado" class="form-select">
                        <option value="activos" selected="@(estadoSeleccionado == "activos")"> Activos </option>
                        <option value="inactivos" selected="@(estadoSeleccionado == "inactivos")"> Inactivos </option>
                        <option value="todos" selected="@(estadoSeleccionado == "todos")"> Todos </option>
                    </select>
                </div>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <div class="col-md-3">
                        <label for="empresaId" class="form-label fw-semibold"> Empresa </label>
                        <select id="empresaId" name="empresaId" class="form-select">
                            <option value=""> Todas las empresas </option>
                            @foreach (var empresa in empresas)
                            {
                                <option value="@empresa.Id" selected="@(empresaSeleccionada == empresa.Id)"> @empresa.Nombre </option>
                            }
                        </select>
                    </div>
                }
                <div class="col-md-4">
                    <label for="busqueda" class="form-label fw-semibold">Buscar categoría</label>
                    <div class="search-input-wrapper">
                        <span class="material-symbols-outlined">search</span>
                        <input id="busqueda" name="busqueda" value="@busqueda" class="form-control form-control-md" maxlength="100" placeholder="Buscar categoría..." type="text" />
                    </div>
                </div>
                <div class="col-md-auto">
                    <button type="submit" class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3">
                        <span class="material-symbols-outlined fs-5">search</span>
                        <span class="small fw-medium">Buscar</span>
                    </button>
                </div>
                @if (estadoSeleccionado != "activos" || empresaSeleccionada.HasValue || !string.IsNullOrWhiteSpace(busqueda))
                {
                    <div class="col-md-auto">
                        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                    </div>
                }
            </form>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="px-4 py-3 border-0">ID</th>
                        <th class="px-4 py-3 border-0">Nombre</th>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <th class="px-4 py-3 border-0">Empresa</th>
                        }
                        <th class="px-4 py-3 border-0 text-center">Estado</th>
                        <th class="px-4 py-3 border-0 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(User.IsInRole("SuperAdmin") ? 5 : 4)" class="text-center text-secondary py-5">
                                No se encontraron categorías para los criterios seleccionados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var categoria in Model)
                        {
                            <tr>
                                <td class="px-4 py-3">@categoria.Id</td>
                                <td class="px-4 py-3">@categoria.Nombre</td>
                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <td class="px-4 py-3">@categoria.Empresa.Nombre</td>
                                }
                                <td class="px-4 py-3 text-center">
                                    @if (categoria.Estado)
                                    {
                                        <span class="status-badge status-active">
                                            <span class="dot"></span>Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <span class="dot"></span>Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <div class="table-actions">
                                        <a asp-action="Details" asp-route-id="@categoria.Id" class="btn btn-sm btn-light table-action-btn" title="Ver detalle" aria-label="Ver detalle"><span class="material-symbols-outlined">visibility</span></a>
                                        <a asp-action="Edit" asp-route-id="@categoria.Id" class="btn btn-sm btn-light table-action-btn" title="Editar" aria-label="Editar"><span class="material-symbols-outlined">edit</span></a>
                                        @if (categoria.Estado)
                                        {
                                            <a asp-action="Delete" asp-route-id="@categoria.Id" class="btn btn-sm btn-light table-action-btn table-action-danger" title="Desactivar" aria-label="Desactivar"><span class="material-symbols-outlined">block</span></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Paginacion" model='new PaginacionVM { PaginaActual = ViewBag.PaginaActual, TotalPaginas = ViewBag.TotalPaginas, TotalRegistros = ViewBag.TotalRegistros, NombreSingular = "categoría encontrada", NombrePlural = "categorías encontradas" }' />
    </div>
</main>
