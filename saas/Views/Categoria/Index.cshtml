@model IEnumerable<Categoria>

@{
    ViewData["Title"] = "Index";
}
<main class="flex-grow-1 py-5 container-fluid px-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-semibold mb-1">Gestión de Categorías</h1>
            <p class="text-secondary mb-0">Administra y organiza las categorías de productos de tu sistema.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 py-2 px-3 shadow-sm rounded-1">
            <span class="material-symbols-outlined fs-5">add</span>
            <span class="fw-medium small">Nueva Categoría</span>
        </a>
    </div>
    <!-- Filter Bar -->
    <div class="card mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-8 d-flex gap-2">
                    <div class="search-input-wrapper flex-grow-1" style="max-width: 400px;">
                        <span class="material-symbols-outlined">search</span>
                        <input class="form-control form-control-md" id="tableSearch" placeholder="Filtrar por nombre..." type="text" />
                    </div>
                    <button class="btn btn-outline-secondary d-flex align-items-center gap-1 px-3">
                        <span class="material-symbols-outlined fs-5">filter_list</span>
                        <span class="small fw-medium">Filtros</span>
                    </button>
                </div>
                <div class="col-md-4 d-flex justify-content-md-end">
                    <button class="btn btn-outline-secondary d-flex align-items-center gap-1 px-3">
                        <span class="material-symbols-outlined fs-5">file_download</span>
                        <span class="small fw-medium">Exportar</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Data Table Card -->
    <div class="card shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="px-4 py-3 border-0">ID</th>
                        <th class="px-4 py-3 border-0">Nombre</th>
                        <th class="px-4 py-3 border-0">Empresa</th>
                        <th class="px-4 py-3 border-0 text-center">Estado</th>
                        <th class="px-4 py-3 border-0 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var Categoria in Model)
                    {
                        <tr>
                            <td class="px-4 py-3">@Categoria.Id</td>
                            <td class="px-4 py-3">@Categoria.Nombre</td>
                            <td class="px-4 py-3">@Categoria.Empresa.Nombre</td>
                            <td class="px-4 py-3 text-center">
                                @if (Categoria.Estado)
                                {
                                    <span class="badge-status status-activo">

                                        <span class="dot"></span>Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status status-inactivo">

                                        <span class="dot"></span>Inactivo
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3 text-end">
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@Categoria.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                                    <a asp-action="Edit" asp-route-id="@Categoria.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@Categoria.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination Footer -->
        <div class="card-footer bg-light border-top-0 px-4 py-3">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
                <span class="small text-secondary">Mostrando 5 de 24 categorías</span>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0 align-items-center">
                        <li class="page-item disabled">
                            <a class="page-link" href="#"><span class="material-symbols-outlined fs-5">chevron_left</span></a>
                        </li>
                        <li class="page-item active"><a class="page-link text-white" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item"><span class="px-2 text-secondary">...</span></li>
                        <li class="page-item"><a class="page-link" href="#">10</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#"><span class="material-symbols-outlined fs-5">chevron_right</span></a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</main>
