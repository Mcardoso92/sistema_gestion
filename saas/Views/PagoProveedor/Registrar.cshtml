@model saas.ViewModel.RegistrarPagoProveedorVM

@{
    ViewData["Title"] = "Registrar Pago";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Registrar Pago
            </h1>

            <p class="text-muted mb-0">
                Compra #@Model.CompraId
            </p>
        </div>

    </div>

    <form asp-action="Registrar"
          method="post"
          id="formRegistrarPagoProveedor"
          data-get-cajas-url="@Url.Action("GetCajasPorMedioPago", "PagoProveedor")"
          data-compra-id="@Model.CompraId"
          data-caja-seleccionada="@Model.CajaId">

        @Html.AntiForgeryToken()

        <input asp-for="CompraId"
               type="hidden" />

        <div asp-validation-summary="All"
             class="alert alert-danger"></div>

        <div class="row g-4">

            <div class="col-lg-4 order-lg-2">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="text-muted small">
                            Saldo pendiente
                        </div>

                        <div class="display-6 fw-bold">
                            @Model.SaldoPendiente.ToString("C")
                        </div>

                    </div>

                </div>

                <div class="help-guide-panel mt-4">
                    <h2 class="help-guide-title">Guía de Ayuda</h2>
                    <div class="help-guide-item"><span class="material-symbols-outlined help-guide-item__icon">payments</span><div><h3 class="help-guide-item__title">Saldo pendiente</h3><p class="help-guide-item__text">El importe no puede superar el saldo pendiente de la compra.</p></div></div>
                    <div class="help-guide-item"><span class="material-symbols-outlined help-guide-item__icon">account_balance_wallet</span><div><h3 class="help-guide-item__title">Caja y medio</h3><p class="help-guide-item__text">La caja debe tener habilitado el medio seleccionado para registrar el egreso.</p></div></div>
                    <div class="help-guide-item"><span class="material-symbols-outlined help-guide-item__icon">history</span><div><h3 class="help-guide-item__title">Trazabilidad</h3><p class="help-guide-item__text">El pago queda vinculado a la compra y a su movimiento de caja.</p></div></div>
                </div>

            </div>

            <div class="col-lg-8 order-lg-1">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="MedioPagoId"
                                       class="form-label fw-semibold">
                                    Medio de pago
                                </label>

                                <select asp-for="MedioPagoId"
                                        class="form-select"
                                        id="medioPagoSelect">

                                    <option value="">
                                        Seleccionar medio
                                    </option>

                                    @foreach (var medio in Model.MediosPagoDisponibles)
                                    {
                                        <option value="@medio.Id">
                                            @medio.Nombre
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="MedioPagoId"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="CajaId"
                                       class="form-label fw-semibold">
                                    Caja
                                </label>

                                <select asp-for="CajaId"
                                        class="form-select"
                                        id="cajaSelect">

                                    <option value="">
                                        Primero seleccione un medio de pago
                                    </option>

                                </select>

                                <span asp-validation-for="CajaId"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Importe"
                                       class="form-label fw-semibold">
                                    Importe a pagar
                                </label>

                                <input asp-for="Importe"
                                       type="number"
                                       min="0.01"
                                       step="0.01"
                                       max="@Model.SaldoPendiente"
                                       class="form-control" />

                                <span asp-validation-for="Importe"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-controller="Compra" asp-action="Details" asp-route-id="@Model.CompraId" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Confirmar pago</button>
                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/pago-proveedor.js"
            asp-append-version="true"></script>

}
