@model saas.ViewModel.ReintegroProveedor.AnularReintegroProveedorVM

@{
    ViewData["Title"] = "Anular Reintegro";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Anular Reintegro
            </h1>

            <p class="text-muted mb-0">
                Compra #@Model.CompraId
            </p>
        </div>

    </div>

    <div class="row g-4 align-items-start">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="alert alert-warning">
                        Esta operación anulará el reintegro y generará un egreso inverso en Caja.
                    </div>

                    <div class="mb-4">
                        <div class="text-muted small">
                            Importe del reintegro
                        </div>

                        <div class="fw-bold fs-5">
                            @Model.Importe.ToString("C")
                        </div>
                    </div>

                    <form asp-action="Anular"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="ReintegroProveedorId"
                               type="hidden" />

                        <div asp-validation-summary="All"
                             class="alert alert-danger"></div>

                        <div class="mb-3">

                            <label asp-for="Motivo"
                                   class="form-label fw-semibold">
                                Motivo de anulación
                            </label>

                            <textarea asp-for="Motivo"
                                      class="form-control"
                                      rows="4"
                                      maxlength="500"
                                      placeholder="Ingrese el motivo de la anulación"></textarea>

                            <span asp-validation-for="Motivo"
                                  class="text-danger"></span>

                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Compra"
                               asp-action="Details"
                               asp-route-id="@Model.CompraId"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                Confirmar anulación
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item"><span class="material-symbols-outlined help-guide-item__icon">undo</span><div><h3 class="help-guide-item__title">Egreso inverso</h3><p class="help-guide-item__text">La anulación descuenta nuevamente el importe de la caja receptora.</p></div></div>
                <div class="help-guide-item"><span class="material-symbols-outlined help-guide-item__icon">pending_actions</span><div><h3 class="help-guide-item__title">Pendiente de recuperar</h3><p class="help-guide-item__text">El importe vuelve a quedar pendiente de reintegro por el proveedor.</p></div></div>
                <div class="help-guide-item"><span class="material-symbols-outlined help-guide-item__icon">history</span><div><h3 class="help-guide-item__title">Trazabilidad</h3><p class="help-guide-item__text">El reintegro original y el motivo de anulación permanecen registrados.</p></div></div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
