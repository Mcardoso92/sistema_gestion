@model saas.ViewModel.ReintegroProveedor.RegistrarReintegroProveedorVM

@{
    ViewData["Title"] = "Registrar Reintegro";
}

<div class="container-fluid px-4 py-4">

    <div class="page-header">

        <div class="page-header-content">
            <h1 class="page-title">
                Registrar Reintegro
            </h1>

            <p class="page-subtitle">
                Compra #@Model.CompraId
            </p>
        </div>

    </div>

    <div class="row g-4 align-items-start">

        <div class="col-lg-8">

            <div class="form-card">

                <div class="card-body p-4">

                    <div class="mb-4">
                        <div class="text-muted small">
                            Importe pendiente de recuperar
                        </div>

                        <div class="fw-bold fs-4">
                            @Model.ImporteDisponible.ToString("C")
                        </div>
                    </div>

                    <form asp-action="Registrar"
                          method="post"
                          id="formRegistrarReintegroProveedor"
                          data-get-cajas-url="@Url.Action("GetCajasPorMedioPago", "ReintegroProveedor")"
                          data-compra-id="@Model.CompraId"
                          data-caja-seleccionada="@Model.CajaId">

                        @Html.AntiForgeryToken()

                        <input asp-for="CompraId"
                               type="hidden" />

                        <div asp-validation-summary="All"
                             class="alert alert-danger form-validation-summary"></div>

                        <div class="mb-3">

                            <label asp-for="Importe"
                                   class="form-label">
                                Importe
                            </label>

                            <input asp-for="Importe"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   max="@Model.ImporteDisponible"
                                   class="form-control" />

                            <span asp-validation-for="Importe"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="MedioPagoId"
                                   class="form-label">
                                Medio de pago
                            </label>

                            <select asp-for="MedioPagoId"
                                    class="form-select"
                                    id="medioPagoSelect">

                                <option value="">
                                    Seleccionar medio de pago
                                </option>

                                @foreach (var medioPago
                                                                in Model.MediosPagoDisponibles)
                                {
                                    <option value="@medioPago.Id">
                                        @medioPago.Nombre
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="MedioPagoId"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="CajaId"
                                   class="form-label">
                                Caja
                            </label>

                            <select asp-for="CajaId"
                                    class="form-select"
                                    id="cajaSelect">

                                <option value="">
                                    Primero seleccione un medio de pago
                                </option>

                            </select>

                            <span asp-validation-for="CajaId"
                                  class="text-danger"></span>

                        </div>

                        <div class="form-actions">

                            <a asp-controller="Compra"
                               asp-action="Details"
                               asp-route-id="@Model.CompraId"
                               class="btn btn-v-outline">
                                Cancelar
                            </a>

                            <button type="submit"
                                    id="btnConfirmarReintegroProveedor"
                                    class="btn btn-v-primary">
                                Confirmar reintegro
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

        <div class="col-lg-4">
            <div class="help-guide-panel">
                <h2 class="help-guide-title">Guía de Ayuda</h2>
                <div class="help-guide-item"><span class="material-symbols-outlined help-guide-item__icon">payments</span><div><h3 class="help-guide-item__title">Importe disponible</h3><p class="help-guide-item__text">El reintegro no puede superar el importe pendiente de recuperar.</p></div></div>
                <div class="help-guide-item"><span class="material-symbols-outlined help-guide-item__icon">account_balance_wallet</span><div><h3 class="help-guide-item__title">Caja receptora</h3><p class="help-guide-item__text">El dinero recibido genera un ingreso en la caja seleccionada.</p></div></div>
                <div class="help-guide-item"><span class="material-symbols-outlined help-guide-item__icon">history</span><div><h3 class="help-guide-item__title">Trazabilidad</h3><p class="help-guide-item__text">El reintegro queda vinculado a la compra y a la devolución correspondiente.</p></div></div>
            </div>
        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/reintegro-proveedor.js"
            asp-append-version="true"></script>

}
